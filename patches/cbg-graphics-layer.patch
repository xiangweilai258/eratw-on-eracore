diff --git a/EraCore.Tests/GraphicsCreateFromFileTests.cs b/EraCore.Tests/GraphicsCreateFromFileTests.cs
new file mode 100644
index 00000000..5781b8cf
--- /dev/null
+++ b/EraCore.Tests/GraphicsCreateFromFileTests.cs
@@ -0,0 +1,117 @@
+using System;
+using System.IO;
+using MinorShift.Emuera;
+using MinorShift.Emuera.Assets;
+using MinorShift.Emuera.Primitives;
+using MinorShift.Emuera.UI.Game.Image;
+using Xunit;
+
+namespace Emuera.Headless.Tests;
+
+/// <summary>
+/// ★ 2026-10-09 新增：<c>GCREATEFROMFILE</c> 不再恒返回 0，
+/// 且合成名能回溯到「来源图片相对路径」—— 前端据此**直接读原文件**把图显示出来（eraTW「神签」）。
+///
+/// <para>★ 无头下**仍然拿不到像素**。本测试钉的是三件事：
+/// ① 画布能用「文件」建成且尺寸正确；② 合成名带着来源路径；③ 资源通道第 3 步能把合成名落到真实文件。</para>
+///
+/// <para>GamePaths 是静态 Current ⇒ 与同类测试一样放串行隔离集合。</para>
+/// </summary>
+[Collection("GamePathsIsolated")]
+public class GraphicsCreateFromFileTests : IDisposable
+{
+    private readonly string _root;
+
+    public GraphicsCreateFromFileTests()
+    {
+        _root = Path.Combine(Path.GetTempPath(), "emuera_gfrom_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_root);
+        GamePaths.Resolve(_root, new FileSystemGameDirAccessor());
+    }
+
+    public void Dispose()
+    {
+        try { Directory.Delete(_root, true); } catch { }
+    }
+
+    /// <summary>写一个最小合法 PNG（签名 ＋ IHDR 即可 —— 尺寸探针只读头部，不校验 CRC）。</summary>
+    private void WritePng(string relativePath, int w, int h)
+    {
+        var full = Path.Combine(_root, relativePath);
+        Directory.CreateDirectory(Path.GetDirectoryName(full)!);
+        var b = new byte[33];
+        byte[] sig = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A];
+        Array.Copy(sig, 0, b, 0, 8);
+        b[11] = 13;                                   // IHDR 数据长度
+        b[12] = (byte)'I'; b[13] = (byte)'H'; b[14] = (byte)'D'; b[15] = (byte)'R';
+        b[16] = (byte)(w >> 24); b[17] = (byte)(w >> 16); b[18] = (byte)(w >> 8); b[19] = (byte)w;
+        b[20] = (byte)(h >> 24); b[21] = (byte)(h >> 16); b[22] = (byte)(h >> 8); b[23] = (byte)h;
+        b[24] = 8;   // bit depth
+        b[25] = 6;   // color type = RGBA
+        File.WriteAllBytes(full, b);
+    }
+
+    [Fact]
+    public void GCreateFromSize_marks_created_with_size_and_source()
+    {
+        var g = AppContents.GetGraphics(991001);
+        g.GCreateFromSize(37, 19, "pic/probe.png");     // ★ 无头版的「文件 → 画布」
+
+        Assert.True(g.IsCreated, "★ 修前 GCREATEFROMFILE 恒返回 0 ⇒ 画布永远不会被创建");
+        Assert.Equal(37, g.Width);
+        Assert.Equal(19, g.Height);
+        Assert.Equal("pic/probe.png", g.SourceFilePath);
+    }
+
+    [Fact]
+    public void CreateSpriteG_carries_source_to_registry()
+    {
+        var g = AppContents.GetGraphics(991002);
+        g.GCreateFromSize(40, 30, "pic/src.png");
+        AppContents.CreateSpriteG("__合成_带源__", g, new EmuRectangle(0, 0, 40, 30));
+
+        Assert.True(AppContents.TryResolveSpriteSource("__合成_带源__", out var rel));
+        Assert.Equal("pic/src.png", rel);
+    }
+
+    [Fact]
+    public void SpriteDispose_also_drops_source()
+    {
+        var g = AppContents.GetGraphics(991003);
+        g.GCreateFromSize(10, 10, "pic/x.png");
+        AppContents.CreateSpriteG("__合成_释放__", g, new EmuRectangle(0, 0, 10, 10));
+        Assert.True(AppContents.TryResolveSpriteSource("__合成_释放__", out _));
+
+        AppContents.SpriteDispose("__合成_释放__");
+
+        Assert.False(AppContents.TryResolveSpriteSource("__合成_释放__", out _));
+    }
+
+    [Fact]
+    public void AssetChannel_resolves_composite_name_to_source_file()
+    {
+        WritePng("pic/target.png", 12, 7);
+        var g = AppContents.GetGraphics(991004);
+        g.GCreateFromSize(12, 7, "pic/target.png");
+        AppContents.CreateSpriteG("__合成_取图__", g, new EmuRectangle(0, 0, 12, 7));
+
+        // ★ 修前：AssetChannel 只有「直接路径」与「sprite 名表」两步 ⇒ 合成名两条都不命中、图永远取不到
+        bool ok = AssetChannel.TryGetImage(new FileSystemGameDirAccessor(), _root,
+                                           "__合成_取图__", out var bytes, out var mime);
+
+        Assert.True(ok, "★ 第 3 步（合成名 → 来源文件）没生效");
+        Assert.NotNull(bytes);
+        Assert.True(bytes!.Length > 0);
+        Assert.Contains("image", mime);
+    }
+
+    [Fact]
+    public void AssetChannel_still_rejects_unknown_name()
+    {
+        // 反向护栏：不存在的名字不能被"猜"出来（第 3 步不能变成万能兜底）
+        bool ok = AssetChannel.TryGetImage(new FileSystemGameDirAccessor(), _root,
+                                           "__根本不存在__", out _, out _);
+
+        Assert.False(ok);
+    }
+}
diff --git a/EraCore.Tests/SpriteCreateGRegistryTests.cs b/EraCore.Tests/SpriteCreateGRegistryTests.cs
new file mode 100644
index 00000000..03a96256
--- /dev/null
+++ b/EraCore.Tests/SpriteCreateGRegistryTests.cs
@@ -0,0 +1,129 @@
+using System;
+using System.IO;
+using MinorShift.Emuera;
+using MinorShift.Emuera.Primitives;
+using MinorShift.Emuera.UI.Game.Image;
+using Xunit;
+
+namespace Emuera.Headless.Tests;
+
+/// <summary>
+/// ★ 2026-10-09 新增：<c>SPRITECREATE</c> 不再「谎报成功」。
+///
+/// <para>修前：<see cref="AppContents.CreateSpriteG"/> 是空方法体，而调用方照样返回 1
+/// ⇒ 合成名之后**查不到** ⇒ <c>SPRITECREATED</c>/<c>SPRITEWIDTH</c>/<c>SPRITEHEIGHT</c> 对运行时合成名恒 0。
+/// 而游戏拿 <c>SPRITECREATED</c> 当**缓存守卫**（eraTW <c>BODY_INFO\ALTER_IMAGE_SET.ERB:9</c>）
+/// ⇒ 每次重跑合成、零报错。</para>
+///
+/// <para>GamePaths 是静态 Current ⇒ 与同类测试一样放串行隔离集合。
+/// ★ 本测试**不需要图片夹具**：合成名不经文件系统。</para>
+/// </summary>
+[Collection("GamePathsIsolated")]
+public class SpriteCreateGRegistryTests : IDisposable
+{
+    private readonly string _root;
+
+    public SpriteCreateGRegistryTests()
+    {
+        _root = Path.Combine(Path.GetTempPath(), "emuera_spritereg_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_root);
+        GamePaths.Resolve(_root, new FileSystemGameDirAccessor());
+    }
+
+    public void Dispose()
+    {
+        try { Directory.Delete(_root, true); } catch { }
+    }
+
+    /// <summary>造一块已知尺寸的画布（6 参形式里 rect 之外还依赖 parent 尺寸做回退）。</summary>
+    private static GraphicsImage Canvas(int id, int w, int h)
+    {
+        var g = AppContents.GetGraphics(id);
+        g.GCreate(w, h, false);
+        return g;
+    }
+
+    [Fact]
+    public void CreateSpriteG_makes_name_resolvable()
+    {
+        var g = Canvas(990001, 100, 50);
+        AppContents.CreateSpriteG("__合成_可查__", g, new EmuRectangle(0, 0, 100, 50));
+
+        var sprite = AppContents.GetSprite("__合成_可查__");
+
+        // ① SPRITECREATED 判定依赖 IsCreated
+        Assert.NotNull(sprite);
+        Assert.True(sprite!.IsCreated, "★ 修前这里必为 null —— 那正是「谎报成功」的根因");
+    }
+
+    [Fact]
+    public void CreateSpriteG_reports_rect_size()
+    {
+        var g = Canvas(990002, 100, 50);
+        AppContents.CreateSpriteG("__合成_尺寸__", g, new EmuRectangle(0, 0, 37, 19));
+
+        var sprite = AppContents.GetSprite("__合成_尺寸__");
+
+        // ② SPRITEWIDTH / SPRITEHEIGHT 读的就是 DestBaseSize
+        Assert.NotNull(sprite);
+        Assert.Equal(37, sprite!.DestBaseSize.Width);
+        Assert.Equal(19, sprite.DestBaseSize.Height);
+    }
+
+    [Fact]
+    public void Dispose_removes_registered_name()
+    {
+        var g = Canvas(990003, 20, 20);
+        AppContents.CreateSpriteG("__合成_释放__", g, new EmuRectangle(0, 0, 20, 20));
+        Assert.NotNull(AppContents.GetSprite("__合成_释放__"));
+
+        // ③ SPRITEDISPOSE（SpriteDisposeMethod 会先 GetSprite 确认存在，再调这里）
+        AppContents.SpriteDispose("__合成_释放__");
+
+        Assert.Null(AppContents.GetSprite("__合成_释放__"));
+    }
+
+    [Fact]
+    public void Zero_rect_falls_back_to_parent_size()
+    {
+        // 2 参形式传 (0,0,parent.W,parent.H)；但脚本也可能传全零矩形 ⇒ 必须退回父画布尺寸，
+        // 否则会登记一个 0×0 的假精灵（那等于换一种方式撒谎）。
+        var g = Canvas(990004, 64, 32);
+        AppContents.CreateSpriteG("__合成_零矩形__", g, default);
+
+        var sprite = AppContents.GetSprite("__合成_零矩形__");
+
+        Assert.NotNull(sprite);
+        Assert.Equal(64, sprite!.DestBaseSize.Width);
+        Assert.Equal(32, sprite.DestBaseSize.Height);
+    }
+
+    [Fact]
+    public void Negative_origin_rect_uses_width_height_only()
+    {
+        // ReadRectangle 允许负起点（WinForms 语义：四角形可正可负，只要与父图画布相交）。
+        // ⇒ 登记尺寸只能取 Width/Height，不能把负数当尺寸。
+        var g = Canvas(990005, 100, 100);
+        AppContents.CreateSpriteG("__合成_负起点__", g, new EmuRectangle(-10, -5, 40, 30));
+
+        var sprite = AppContents.GetSprite("__合成_负起点__");
+
+        Assert.NotNull(sprite);
+        Assert.Equal(40, sprite!.DestBaseSize.Width);
+        Assert.Equal(30, sprite.DestBaseSize.Height);
+    }
+
+    [Fact]
+    public void Recreate_overwrites_previous_entry()
+    {
+        var g = Canvas(990006, 100, 100);
+        AppContents.CreateSpriteG("__合成_覆盖__", g, new EmuRectangle(0, 0, 10, 10));
+        AppContents.CreateSpriteG("__合成_覆盖__", g, new EmuRectangle(0, 0, 80, 60));
+
+        var sprite = AppContents.GetSprite("__合成_覆盖__");
+
+        Assert.NotNull(sprite);
+        Assert.Equal(80, sprite!.DestBaseSize.Width);
+        Assert.Equal(60, sprite.DestBaseSize.Height);
+    }
+}
