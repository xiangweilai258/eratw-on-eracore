+	/// </summary>
+	internal static GfxColorParams ParseColorMatrix(float[][]? cm)
+	{
+		if (cm == null || cm.Length < 4)
+			return GfxColorParams.Default;
+		for (int i = 0; i < 4; i++)
+			if (cm[i] == null || cm[i].Length < 5)
+				return GfxColorParams.Default;
+
