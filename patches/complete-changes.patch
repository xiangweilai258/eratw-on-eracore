+      <!-- ⑤ 技术信息（出问题时给作者看这个） -->
+      <section class="ab-sec">
+        <h2 class="ab-h2">技术信息</h2>
+        <table class="ab-table">
+          <tbody>
+            <tr><th>应用版本</th><td>{{ appVersion }}</td></tr>
