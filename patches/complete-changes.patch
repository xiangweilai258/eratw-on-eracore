+    [Fact]
+    public async Task Replacing_game_session_does_not_cross_sql_databases()
+    {
+        EESqlRuntime.Reset();
+        using var a = new GameDir("chain-a");
+        using var b = new GameDir("chain-b");
+        // 两侧预置**不同**标记；会话只另写独立 key，避免覆盖同一 marker 掩盖归属
+        a.SeedDatabase(("marker", "A_VALUE"));
+        b.SeedDatabase(("marker", "B_VALUE"));
+        a.WriteGameFixture("wrote", "A_WROTE");
+        b.WriteGameFixture("wrote", "B_WROTE");
+        var previous = GamePaths.Current;
+        var registry = CreateRegistry();
+        try
+        {
+            Assert.Equal("A_VALUE", ReadIndependent(a.DbPath, "marker"));
+            Assert.Equal("B_VALUE", ReadIndependent(b.DbPath, "marker"));
+
+            var first = await registry.ReplaceForLoadGameAsync(a.Root);
+            Assert.Equal(LoadGameStatus.Success, first.Status);
+            await WaitEndedAsync(registry.CurrentSession);
+            Assert.Equal("A_WROTE", ReadIndependent(a.DbPath, "wrote"));
