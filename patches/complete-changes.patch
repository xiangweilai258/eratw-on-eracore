+    [Fact]
+    public void Next_scope_with_same_connection_name_reads_its_own_relative_database()
+    {
+        EESqlRuntime.Reset();                       // 用例隔离（见类注释）
+        using var a = new GameDir("rel-a");
+        using var b = new GameDir("rel-b");
+        a.SeedDatabase(("marker", "A_VALUE"));
+        b.SeedDatabase(("marker", "B_VALUE"));
+        var previous = GamePaths.Current;
+        try
+        {
+            // 断言 1：两侧初始记录正确（先证实预置本身无误，避免把预置失败误读成串库）
+            Assert.Equal("A_VALUE", ReadIndependent(a.DbPath, "marker"));
+            Assert.Equal("B_VALUE", ReadIndependent(b.DbPath, "marker"));
+
+            using (GlobalStatic.OpenScope(new ConfigData()))
+            {
+                GamePaths.SetCurrent(GamePaths.Resolve(a.Root, new FileSystemGameDirAccessor()));
+                EESqlRuntime.Connect("DB", "plugins/data.db");
+                // 会话 A 经同名连接读到自己目录的预置标记
+                Assert.Equal("A_VALUE", Scalar("DB", "SELECT v FROM t WHERE k='marker'"));
+                NonQuery("DB", CreateTable);
+                NonQuery("DB", "INSERT OR REPLACE INTO t (k,v) VALUES ('wrote','A_WROTE')");
+            }
+            Assert.Equal("A_WROTE", ReadIndependent(a.DbPath, "wrote"));
+            Assert.Equal(0, ConnCount());           // ★ 旧会话结束后不得留下失效引用
+
+            using (GlobalStatic.OpenScope(new ConfigData()))
+            {
+                GamePaths.SetCurrent(GamePaths.Resolve(b.Root, new FileSystemGameDirAccessor()));
+                EESqlRuntime.Connect("DB", "plugins/data.db");
+                // ★ 断言 2：同名连接、另一目录 ⇒ 必须读到 B 自己的预置标记
+                Assert.Equal("B_VALUE", Scalar("DB", "SELECT v FROM t WHERE k='marker'"));
+                NonQuery("DB", CreateTable);
+                NonQuery("DB", "INSERT OR REPLACE INTO t (k,v) VALUES ('wrote','B_WROTE')");
+            }
+
+            // ★ 断言 3/4：独立查询两侧真实记录
+            Assert.Equal("B_VALUE", ReadIndependent(b.DbPath, "marker"));
+            Assert.Equal("B_WROTE", ReadIndependent(b.DbPath, "wrote"));
+            Assert.Equal("A_VALUE", ReadIndependent(a.DbPath, "marker"));
+            Assert.Equal("A_WROTE", ReadIndependent(a.DbPath, "wrote"));   // ★ A 不得被 B 覆盖
+        }
+        finally
+        {
+            EESqlRuntime.Reset();
+            GamePaths.SetCurrent(previous);
+        }
+    }
