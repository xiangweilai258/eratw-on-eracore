+namespace MinorShift.Emuera;
+
+/// <summary>
+/// 排版坐标系（**逻辑画布**）的全局常量。
+///
+/// <para>
+/// ★★ <b>为什么需要</b>：<c>ConfigCode.WindowX</c> 经 <c>Config.DrawableWidth</c> 决定
+/// 折行、行内居中/右对齐、分割线填充与 div 宽度 —— 它是<b>排版坐标系</b>，
+/// <b>不是画布（设备）尺寸</b>。若把它设成设备的物理像素宽，同一份内容在每台设备上会排出
+/// 不同的换行位置与列数；而原版的行为恰恰相反：<b>任何 16:9 设备上看起来一模一样</b>。
+/// </para>
+/// <para>
+/// <b>原版怎么做的</b>：
+/// ① 桌面 Emuera —— 由用户在「窗口宽度锁定」菜单里显式写回真实客户区宽度并落盘
+///    （<c>Emuera/UI/Framework/Forms/MainWindow.cs:1501</c>）；
+/// ② GEmuera（安卓）—— 用 Godot 的固定逻辑画布（基准 1152×648，<c>canvas_items</c> +
+///    <c>expand</c>）排版，整幅画面等比放大铺满屏幕；它写进 <c>Config.WindowX</c> 的是
+///    <b>逻辑画布宽度</b>，<b>只改内存、不落盘</b>，字号完全不动。
+///    ⇒ <b>缩放而非重排</b>；屏幕适配由界面层完成（本仓对应前端 <c>game.autoFitScale</c>）。
+/// </para>
+/// <para>
+/// ★ <b>取 1152 的依据</b>：与 GEmuera 的 Godot 基准画布同宽，使两边逐列一致；
+/// 且对 ≤16:9 的设备缩放系数恒 ≥1（是放大，不牺牲可读性）。
+/// 该值由「它未设基准分辨率 ⇒ 用 Godot 默认 1152×648」推出，
+/// <b>尚未在真机上用它的 debug 日志（<c>[UI] Android dynamic content width: … -> N</c>）
+/// 直接印证</b>；一旦测出真实 <c>N</c>，<b>只需改这一处</b>。
+/// </para>
+/// <para>
+/// ★ 与主机的有意差异：原版桌面会 <c>SaveConfig()</c> 落盘，这里<b>不落盘</b> ——
+/// 只在本次运行内生效，玩家 <c>emuera.config</c> 里的设定不受影响。
+/// </para>
+/// </summary>
+public static class DesignCanvas
+{
+    /// <summary>逻辑画布宽度（列数基准的单位是像素，见 <see cref="Config.DrawableWidth"/> 的口径）。</summary>
+    public const int Width = 1152;
+}
