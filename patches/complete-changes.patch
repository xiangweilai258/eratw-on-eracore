+++ b/EraCore.Tests/DesignCanvasWidthTests.cs
@@ -0,0 +1,195 @@
+using System;
+using System.IO;
+using System.Text;
+using MinorShift.Emuera;
+using MinorShift.Emuera.Runtime.Config;
+using MinorShift.Emuera.Server;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+/// <summary>
+/// ★ F-2（2026-10-10 独立审查・中）：逻辑画布 <c>1152</c> 此前在 <c>EraCore.Tests</c> 里
+/// **0 命中**——<see cref="DesignCanvas"/> 与写入点 <see cref="GameConfigService"/> 都没有测试，
+/// 于是「1152 写错 / 写漏某条路径 / 被改回 760」时 CI 全绿。本文件补三个断言面：
+///
+/// <list type="number">
+/// <item>① <b>常量本体</b> = 1152，且 ≠ <c>ConfigData</c> 的默认 <c>WindowX</c>(760)
+///   —— 把「改回 760」变成红。</item>
+/// <item>② <b>写入生效</b>：经 <see cref="GameConfigService.Reload"/>（CLI / HTTP 模式重建
+///   ConfigData 的唯一入口）之后，<c>ConfigCode.WindowX</c> == <see cref="DesignCanvas.Width"/>，
+///   并且**连续两次 Reload 都生效**（防「只有第一次生效」的一次性 bug）；
+///   同时覆盖游戏线程真正的读取路径（<c>Config.WindowX</c>，走 <c>GlobalStatic.OpenScope</c>，
+///   与生产 <c>GameLoopComposer</c> 同款）。</item>
+/// <item>③ <b>不落盘</b>：Reload 全程不碰游戏目录的 <c>emuera.config</c>——逐字节 + 连 mtime 都不动。
+///   口径参照 <c>ConfigNotWrittenOnLoadTests</c>（那组测的是 <c>ConfigData.LoadConfig</c> 本身；
+///   这里多覆盖 Reload 在其后追加的 <c>AppSettings.ApplyTo</c> + <c>ApplyDesignCanvasWidth</c> 两步，
+///   以及「设计画布宽度是内存覆盖、绝不回写玩家配置」这条设计约束，见 DesignCanvas.cs 类注释末段）。</item>
+/// </list>
+///
+/// <para>
+/// ★ ambient 纪律：<c>Reload</c> 会 <c>ConfigData.SetCurrent</c>（AsyncLocal，生产语义要求它与
+/// 新 Session 构造在同一 async 流内），但**测试不能把这个副作用漏给别的测试**（F-1 的类别）
+/// ——故本文件每条用例结束时都把 <c>Config</c>/<c>ConfigData</c> 的 ambient 归零
+/// （经 scope Dispose，或显式 ClearCurrent）。既有的 <c>GameConfigServiceTests</c> 未做这步，
+/// 这里不跟它保持一致。
+/// </para>
+/// </summary>
+public class DesignCanvasWidthTests
+{
+	/// <summary>
+	/// 今天对外口径的逻辑画布宽（= GEmuera 的 Godot 基准画布 1152×648）。
+	/// ★ 故意**写死**在这里：只断言「WindowX == DesignCanvas.Width」是**自洽**的
+	/// ——常量被改回 760 时它照样通过（2026-10-10 实测确认过这一点）。
+	/// 只有把 1152 这个数钉住，「被改回 760」才会变红。
+	/// </summary>
+	private const int ExpectedDesignCanvasWidth = 1152;
+
+	private static readonly Encoding Utf8NoBom = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
+
+	/// <summary>临时游戏目录模板（与 <c>GameConfigServiceTests.WithTempGameDir</c> 同款）。</summary>
+	private static void WithTempGameDir(Action<string> action)
+	{
+		var gameDir = Path.Combine(Path.GetTempPath(), "emuera_canvas_" + Guid.NewGuid().ToString("N"));
+		Directory.CreateDirectory(gameDir);
+		try
+		{
+			action(gameDir);
+		}
+		finally
+		{
+			Directory.Delete(gameDir, recursive: true);
+		}
+	}
+
+	/// <summary>写一份游戏目录里的 emuera.config（键名用日文显示名，见 ConfigData.setDefault）。</summary>
+	private static string WriteConfig(string gameDir, string content)
+	{
+		var path = Path.Combine(gameDir, "emuera.config");
+		File.WriteAllText(path, content, Utf8NoBom);
+		return path;
+	}
+
+	/// <summary>ambient 归零——Reload 的 SetCurrent 副作用不留给下一个测试（F-1 纪律）。</summary>
+	private static void ClearAmbient()
+	{
+		ConfigData.ClearCurrent();
+		Config.ClearCurrent();
+	}
+
+	/// <summary>
+	/// ① 常量本体：逻辑画布宽 = 1152（GEmuera 的 Godot 基准画布同宽），
+	/// 且它**不等于** ConfigData 的默认窗口宽 760 —— 后者正是「被改回 760」事故的现象值。
+	/// </summary>
+	[Fact]
+	public void DesignCanvas_width_is_1152_and_differs_from_the_default_windowx()
+	{
+		Assert.Equal(ExpectedDesignCanvasWidth, DesignCanvas.Width);
+
+		// 默认值钉在这里：一旦 DesignCanvas.Width 被改回 760，本断言与上面那条同时红。
+		var fresh = new ConfigData();
+		Assert.Equal(760, fresh.GetConfigValue<int>(ConfigCode.WindowX));
+		Assert.NotEqual(DesignCanvas.Width, fresh.GetConfigValue<int>(ConfigCode.WindowX));
+	}
+
+	/// <summary>
+	/// ② 写入生效（单次）：emuera.config 里写明 900，Reload 后必须被覆盖成 1152；
+	/// 同时经 <c>GlobalStatic.OpenScope</c> 走一遍游戏线程的读取路径 <c>Config.WindowX</c>。
+	/// </summary>
+	[Fact]
+	public void Reload_writes_design_canvas_width_over_the_config_file_value()
+	{
+		WithTempGameDir(gameDir =>
+		{
+			WriteConfig(gameDir, "ウィンドウ幅 : 900\n一行の高さ : 19\n");
+
+			var svc = new GameConfigService(new ConfigData());
+			var reloaded = svc.Reload(gameDir);
+
+			// 配置文件里的 900 必须被压过。
+			// ① 钉死今天对外口径的 1152：写路径坏 → 这里会看到文件里的 900；常量被改回 760 → 会看到 760。
+			Assert.Equal(ExpectedDesignCanvasWidth, reloaded.GetConfigValue<int>(ConfigCode.WindowX));
+			// ② 再断言与常量同源（关系断言）：让「常量被合法重调」时两侧仍然自洽、不假红。
+			Assert.Equal(DesignCanvas.Width, reloaded.GetConfigValue<int>(ConfigCode.WindowX));
+			Assert.Equal(ExpectedDesignCanvasWidth, svc.GetValue<int>(ConfigCode.WindowX));
+			// /state 的窗口元信息同源（控制服务器那份也是同一个实例）。
+			Assert.Equal(ExpectedDesignCanvasWidth, svc.GetWindowMetrics().WindowWidth);
+
+			// 游戏线程真正的读取路径：Config.* 经 scope 绑定（与 GameLoopComposer 同款）。
+			using var scope = GlobalStatic.OpenScope(reloaded);
+			Assert.Equal(ExpectedDesignCanvasWidth, Config.WindowX);
+			// 排版坐标系从它派生（折行/居中的实际判据）。
+			Assert.Equal(DesignCanvas.Width - Config.DrawingParam_ShapePositionShift, Config.DrawableWidth);
+		});
+	}
+
+	/// <summary>
+	/// ★ ② 两次连续 Reload 都要生效：两个目录各自写明不同窗口宽（900 / 640），
+	/// 若实现里存在「只在第一次 Reload 时写宽度」的一次性路径（例如某处缓存了
+	/// 「已应用」标志），第二次就会漏出 640。
+	/// </summary>
+	[Fact]
+	public void Two_consecutive_reloads_both_apply_design_canvas_width()
+	{
+		WithTempGameDir(dirA =>
+		{
+			WithTempGameDir(dirB =>
+			{
+				WriteConfig(dirA, "ウィンドウ幅 : 900\n");
+				WriteConfig(dirB, "ウィンドウ幅 : 640\n");
+
+				var svc = new GameConfigService(new ConfigData());
+				try
+				{
+					var first = svc.Reload(dirA);
+					Assert.Equal(ExpectedDesignCanvasWidth, first.GetConfigValue<int>(ConfigCode.WindowX));
+
+					var second = svc.Reload(dirB);
+					Assert.Equal(ExpectedDesignCanvasWidth, second.GetConfigValue<int>(ConfigCode.WindowX));
+
+					// 服务当前持有的那份也要是 1152（不是残留的第一次结果）。
+					Assert.Same(second, svc.Current);
+					Assert.Equal(DesignCanvas.Width, svc.GetValue<int>(ConfigCode.WindowX));
+				}
+				finally
+				{
+					ClearAmbient();
+				}
+			});
+		});
+	}
+
+	/// <summary>
+	/// ③ 不落盘：Reload 前后 <c>emuera.config</c> 逐字节一致，且 mtime 不动。
+	/// mtime 显式设成 2020 年——只比内容会漏掉「内容相同但文件被重写」的情形
+	/// （口径与 <c>ConfigNotWrittenOnLoadTests</c> 一致）。
+	/// </summary>
+	[Fact]
+	public void Reload_neither_rewrites_nor_touches_the_config_file()
+	{
+		WithTempGameDir(gameDir =>
+		{
+			var configPath = WriteConfig(gameDir, "ウィンドウ幅 : 900\n私の専用鍵 : 1\n");
+			var fixedTime = new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+			File.SetLastWriteTimeUtc(configPath, fixedTime);
+			var bytesBefore = File.ReadAllBytes(configPath);
+
+			var svc = new GameConfigService(new ConfigData());
+			try
+			{
+				// 连做两次——写盘类回归常只在第二次（例如缓存/落盘分支）冒出来。
+				svc.Reload(gameDir);
+				svc.Reload(gameDir);
+
+				Assert.Equal(bytesBefore, File.ReadAllBytes(configPath));
+				Assert.Equal(fixedTime, File.GetLastWriteTimeUtc(configPath));
+				// 也不该在别处冒出 config。
+				Assert.Single(Directory.GetFiles(gameDir, "*.config"));
+			}
+			finally
+			{
+				ClearAmbient();
+			}
+		});
+	}
+}
