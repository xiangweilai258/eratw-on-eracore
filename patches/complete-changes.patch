@@ -0,0 +1,106 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using MinorShift.Emuera.Server;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+public class SessionStartupOwnershipTests
+{
+    [Fact]
+    public async Task Rejected_handoff_reclaims_exact_resource_once()
+    {
+        var resource = new object();
+        var reclaimed = 0;
+        var ownership = new SessionStartupOwnership<object>(resource, expected =>
+        {
+            Assert.Same(resource, expected);
+            Interlocked.Increment(ref reclaimed);
+            return Task.CompletedTask;
+        });
+        Assert.False(ownership.TryTransfer(_ => false));
+        await ownership.DisposeAsync();
+        await ownership.DisposeAsync();
+        Assert.Equal(1, reclaimed);
+    }
+
+    [Fact]
+    public async Task Successful_handoff_leaves_cleanup_to_receiver()
+    {
+        var reclaimed = 0;
+        var ownership = new SessionStartupOwnership<object>(new object(), _ =>
+        {
+            reclaimed++;
+            return Task.CompletedTask;
+        });
+        Assert.True(ownership.TryTransfer(_ => true));
+        await ownership.DisposeAsync();
+        Assert.Equal(0, reclaimed);
+        Assert.False(ownership.TryTransfer(_ => true));
+    }
+
+    [Fact]
+    public async Task Receiver_exception_preserves_local_cleanup()
+    {
+        var reclaimed = 0;
+        var ownership = new SessionStartupOwnership<object>(new object(), _ =>
+        {
+            reclaimed++;
+            return Task.CompletedTask;
+        });
+        Assert.Throws<InvalidOperationException>(() => ownership.TryTransfer(_ => throw new InvalidOperationException("接收失败")));
+        await ownership.DisposeAsync();
+        Assert.Equal(1, reclaimed);
+    }
+
+    [Fact]
+    public async Task Cleanup_waits_for_in_flight_handoff_and_does_not_reclaim_adopted_resource()
+    {
+        using var entered = new ManualResetEventSlim();
+        using var finish = new ManualResetEventSlim();
+        var reclaimed = 0;
+        var ownership = new SessionStartupOwnership<object>(new object(), _ =>
+        {
+            Interlocked.Increment(ref reclaimed);
+            return Task.CompletedTask;
+        });
+        var handoff = Task.Run(() => ownership.TryTransfer(_ =>
+        {
+            entered.Set();
+            Assert.True(finish.Wait(TimeSpan.FromSeconds(5)));
+            return true;
+        }));
+        Assert.True(entered.Wait(TimeSpan.FromSeconds(5)));
+        var cleanupEntered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var cleanup = Task.Run(async () =>
+        {
+            cleanupEntered.SetResult();
+            await ownership.DisposeAsync();
+        });
+        await cleanupEntered.Task;
+        finish.Set();
+        Assert.True(await handoff);
+        await cleanup;
+        Assert.Equal(0, reclaimed);
+    }
+
+    [Fact]
+    public async Task Cleanup_started_before_handoff_prevents_adoption()
+    {
+        var entered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var finish = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var ownership = new SessionStartupOwnership<object>(new object(), async _ =>
+        {
+            entered.SetResult();
+            await finish.Task;
+        });
+        var cleanup = ownership.DisposeAsync().AsTask();
+        await entered.Task;
+        Assert.False(ownership.TryTransfer(_ => true));
+        var repeated = ownership.DisposeAsync().AsTask();
+        Assert.False(repeated.IsCompleted);
+        finish.SetResult();
+        await Task.WhenAll(cleanup, repeated);
+    }
+}
diff --git a/EraCore.Tests/SessionSubscriptionOrderTests.cs b/EraCore.Tests/SessionSubscriptionOrderTests.cs
new file mode 100644
index 00000000..d622eb17
--- /dev/null
+++ b/EraCore.Tests/SessionSubscriptionOrderTests.cs
@@ -0,0 +1,516 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using MinorShift.Emuera.Runtime.Config;
+using MinorShift.Emuera.Server;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+/// <summary>
+/// ★★ 第二批 · F6：**注册表内「先订阅、后启动」的原子接缝**。
+///
+/// <para>依据 <c>会话可靠性审查记录</c>「F6 · MAUI 先启动后订阅，首帧和初始化错误可能丢」：
+/// <see cref="OutputHub.Subscribe"/> 只收订阅**之后**的 turn，<b>不回放历史</b>；
+/// 而 <c>Session.Start()</c> 把游戏循环排到独立 Task，首帧随时可能 Publish。
+/// 若按「Start → 返回 → 再 Subscribe」，首帧可能永久丢失。</para>
+///
+/// <para>本组用<b>受控投递</b>（<see cref="HttpSessionIO.WriteLine"/> 是公开的 ITurnSink 口）
+/// 来证明**顺序**，不依赖真实游戏夹具、不写玩家数据。
+/// ★ 它证明的是"订阅建立与启动的先后"，不等于真实 MAUI WebView 首帧的视觉验收。</para>
+/// </summary>
+[Collection("ServerState")]
+public sealed class SessionSubscriptionOrderTests
+{
+    private static SessionRegistry CreateRegistry()
+        => new(new SessionRegistryTests.NullTerminalSetup(), new GameConfigService(new ConfigData()));
+
+    private static Session MakeSession(OutputHub hub)
+        => new(new HttpSessionIO(hub), new SessionRegistryTests.NullTerminalSetup(),
+               new ConfigData(), agentLease: null, fullDiffOnFirstTurn: true);
+
+    /// <summary>把一个"已准备、未启动"的会话装进注册表（模拟 MAUI 预建路径的中间态）。</summary>
+    private static (Session session, OutputHub hub) InstallPreparedSession(SessionRegistry registry)
+    {
+        var hub = new OutputHub();
+        var session = MakeSession(hub);
+        session.MarkPreparedLoading();
+        var f = typeof(SessionRegistry);
+        f.GetField("_session", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+            .SetValue(registry, session);
+        f.GetField("_sessionHub", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+            .SetValue(registry, hub);
+        f.GetField("_pendingMauiSession", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+            .SetValue(registry, session);
+        return (session, hub);
+    }
+
+    // ---------------------------------------------------------------------
+    // ① 红测基线：老顺序（先启动、后订阅）会丢首帧
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Old_order_start_then_subscribe_loses_a_turn_published_in_between()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, hub) = InstallPreparedSession(registry);
+
+            // 老顺序：先启动（此处立刻替身投递"首帧"，代表 Start 之后、Subscribe 之前产生的 turn）
+            Assert.True(await registry.StartPreparedMauiSessionAsync(session));
+            session.IO.WriteLine("{\"kind\":\"first-frame\"}");
+
+            // 再订阅——晚了一步
+            var sub = await registry.TryGetWsSubscriptionAsync(session);
+            Assert.NotNull(sub);
+
+            // ★ 首帧不在订阅的 Channel 里（Hub 不回放）⇒ 证明窗口真实存在
+            Assert.False(sub!.Reader.TryRead(out _),
+                "老顺序下 Start 与 Subscribe 之间产生的 turn 不应出现在订阅里——这正是 F6 的缺口");
+            sub.Hub.Unsubscribe(sub.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    /// <summary>经 <see cref="HttpSessionIO"/> 投递一个 turn——等价于游戏循环写出一帧。</summary>
+    private static void PublishViaIO(Session session, string turn) => session.IO.WriteLine(turn);
+
+    // ---------------------------------------------------------------------
+    // ② ★ 已撤回的原验收（见上方更正说明）：原用例不能证明接缝内部顺序。
+    //     保留一条**如实反映现状**的用例，说明当前实现的行为边界。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_subscribes_and_starts_the_pending_session()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+            var flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic;
+            var gameTaskField = typeof(Session).GetField("_gameTask", flags)!;
+
+            var sub = await registry.SubscribeThenStartAsync(session);
+            Assert.NotNull(sub);
+
+            // 接缝确实排了游戏循环（真实 Start 路径）
+            Assert.NotNull(gameTaskField.GetValue(session));
+
+            // ★ 只证明"接缝之后发的帧能收到"——**不**证明接缝内部两步的先后。
+            //   内部顺序的判据见下方"接缝内即时首帧"组（待注入点落地）。
+            PublishViaIO(session, "{\"kind\":\"after-seam\"}");
+            Assert.True(sub!.Reader.TryRead(out var got));
+            Assert.Equal("{\"kind\":\"after-seam\"}", got);
+            sub.Hub.Unsubscribe(sub.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ②-b ★ 反转验证：**先启动后订阅**在同一场景下必丢 ⇒ 证明 ② 的判据抓得住错误实现
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Reversal_start_then_subscribe_misses_the_same_frame()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+            var flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic;
+            var gameTaskField = typeof(Session).GetField("_gameTask", flags)!;
+            var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+            gameTaskField.SetValue(session, Task.Run(async () => await started.Task));
+
+            // 错误实现的顺序：先启动
+            Assert.True(await registry.StartPreparedMauiSessionAsync(session));
+            // 启动之后产生的帧
+            PublishViaIO(session, "{\"kind\":\"frame-after-start\"}");
+            // 再订阅——晚了一步
+            var late = await registry.TryGetWsSubscriptionAsync(session);
+            Assert.NotNull(late);
+
+            // ★ 必然读不到：这是"老顺序确实会丢帧"的**缺口证人**。
+            //
+            // ★ 2026-10-12 第二批复审更正（独立审阅 R8）：此用例**不能**作为修复验收的反证。
+            //   它是**手工**在 Start 与 Subscribe 之间投递的，而被验收的接缝调用并不
+            //   在那个位置投递 ⇒ 它既不能证明接缝正确、也不能否定接缝。
+            //   真正的反证必须让**首帧在接缝内部产生**（需要受控启动注入点，见扩展清单）。
+            //   故此处只保留它作为"窗口真实存在"的证人，并在此显式降级其作用。
+            Assert.False(late!.Reader.TryRead(out _),
+                "先启动后订阅必然丢掉两者之间产生的帧——这是缺口证人，非修复验收反证");
+
+            started.TrySetResult();
+            late.Hub.Unsubscribe(late.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑦ ★ legacy 路径覆盖：CreateMauiSessionAsync 返回"只准备、未启动"，
+    //    调用方再走同一个接缝 ⇒ 必须先订阅、后启动
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Legacy_create_path_returns_unstarted_then_seam_subscribes_before_start()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            // legacy 创建：注册表内建会话，但**不再**在锁内 Start
+            var created = await registry.CreateMauiSessionAsync(new ConfigData(), fullDiffOnFirstTurn: true);
+            Assert.Equal(SessionCreateStatus.Created, created.Status);
+            var session = created.Session!;
+
+            var flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic;
+            var gameTaskField = typeof(Session).GetField("_gameTask", flags)!;
+
+            // ★ 这就是 F6 的关键断言：legacy 返回时**尚未启动**，首帧因此还没有产生机会。
+            Assert.Null(gameTaskField.GetValue(session));
+            Assert.Equal("Loading", session.StateString);
+
+            // 受控循环占位（不加载真实 ERB），再由接缝统一"订阅 + 启动"
+            var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+            gameTaskField.SetValue(session, Task.Run(async () => await started.Task));
+
+            var sub = await registry.SubscribeThenStartAsync(session);
+            Assert.NotNull(sub);
+            Assert.True(session.IsRunning);
+
+            PublishViaIO(session, "{\"kind\":\"legacy-frame\"}");
+            Assert.True(sub!.Reader.TryRead(out var got));
+            Assert.Equal("{\"kind\":\"legacy-frame\"}", got);
+
+            started.TrySetResult();
+            sub.Hub.Unsubscribe(sub.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑧ ★ 启动失败清理：接缝已建订阅后，若会话随后被销毁 ⇒ 订阅可退、不留残留
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_subscription_can_be_cleaned_up_when_session_is_destroyed_after_start()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+            var flags = System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic;
+            var gameTaskField = typeof(Session).GetField("_gameTask", flags)!;
+            var started = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+            gameTaskField.SetValue(session, Task.Run(async () => await started.Task));
+
+            var sub = await registry.SubscribeThenStartAsync(session);
+            Assert.NotNull(sub);
+
+            // 会话被销毁（模拟启动后失败/页面退出的清理路径）
+            var del = await registry.DeleteIfCurrentAsync(session);
+            Assert.Equal(SessionDeleteStatus.Removed, del.Status);
+
+            // ★ 订阅仍可显式退订（调用方 finally 的责任），且不抛
+            sub!.Hub.Unsubscribe(sub.Reader);
+
+            // ★ 接缝对已不在注册表的会话不再给订阅
+            Assert.Null(await registry.SubscribeThenStartAsync(session));
+
+            started.TrySetResult();
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ③ 身份核验：expected 不是当前会话 ⇒ 不订阅、不启动
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_returns_null_when_expected_is_not_current()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var other = MakeSession(new OutputHub());
+            var sub = await registry.SubscribeThenStartAsync(other);
+            Assert.Null(sub);
+            // ★ 绝不能因为"传了个别的会话"就去启动它
+            Assert.Null(typeof(Session)
+                .GetField("_gameTask", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .GetValue(other));
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ④ 幂等：接缝不会把同一会话启动第二次；也不重复启动已启动的会话
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_does_not_start_the_same_session_twice()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+            var f = typeof(Session).GetField("_gameTask",
+                System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!;
+
+            var first = await registry.SubscribeThenStartAsync(session);
+            Assert.NotNull(first);
+            var loopAfterFirst = f.GetValue(session);
+            Assert.NotNull(loopAfterFirst); // 已排了游戏循环
+
+            // 第二次调用：订阅照给（新观察者），但**不得重启**游戏循环
+            var second = await registry.SubscribeThenStartAsync(session);
+            Assert.NotNull(second);
+            Assert.Same(loopAfterFirst, f.GetValue(session));
+
+            first!.Hub.Unsubscribe(first.Reader);
+            second!.Hub.Unsubscribe(second.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑤ 会话已被替换 ⇒ 接缝返回 null（不碰新局）
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_returns_null_after_session_was_replaced()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (old, _) = InstallPreparedSession(registry);
+
+            // 换一个新局进注册表
+            var (fresh, _) = InstallPreparedSession(registry);
+
+            var sub = await registry.SubscribeThenStartAsync(old);
+            Assert.Null(sub);
+
+            // ★ 新局不受影响
+            var ok = await registry.SubscribeThenStartAsync(fresh);
+            Assert.NotNull(ok);
+            ok!.Hub.Unsubscribe(ok.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑥ ★ 与既有生产语义一致：已结束的会话不给订阅（终态由 4004 关闭码下发）
+    //    ★ 留痕：本条曾写成"既没在跑、又不会启动的会话也要拒绝"——那是**我自行加码**
+    //      的条件（原生产代码只判 HasEnded），已按用户 2026-10-12 的要求撤回，
+    //      故此处只断言与既有语义一致的那一条。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_refuses_subscription_for_ended_session()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+            // 把会话置于"已结束"——与既有 GetWsSubscriptionAsync 的
+            // `session is { HasEnded: false }` 判据对齐。
+            typeof(Session)
+                .GetField("_hasEnded", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .SetValue(session, true);
+
+            var sub = await registry.SubscribeThenStartAsync(session);
+            Assert.Null(sub);
+
+            // ★ 也不得把它启动起来
+            Assert.Null(typeof(Session)
+                .GetField("_gameTask", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .GetValue(session));
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑨ ★★ R8 复审：**被拒绝的会话不得占用 pending 槽**，也不得启动。
+    //
+    // ★ 留痕（重要）：**"Start 抛异常时退订"这条真正的异常路径尚未被测试覆盖**。
+    //   `Session.Start()` 是非虚方法且其同步路径（_loading=true 后 Task.Run）
+    //   不抛异常 ⇒ 无法在不引入**产品侧受控启动注入点**的前提下让它同步失败。
+    //   我**不**用"验证成功路径的退订"冒充异常路径覆盖——
+    //   那是"增加通过数量"而非机制证明。列入扩展清单，落地后补真正的用例。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_rejects_ended_session_without_starting_it()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+
+            // 已结束 ⇒ 接缝在订阅之前就拒绝
+            typeof(Session)
+                .GetField("_hasEnded", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .SetValue(session, true);
+            Assert.Null(await registry.SubscribeThenStartAsync(session));
+
+            // ★ 被拒绝 ⇒ **不得启动**它（这才是接缝的职责边界）
+            Assert.Null(typeof(Session)
+                .GetField("_gameTask", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .GetValue(session));
+
+            // ★ 留痕：pending 槽的清理由 DestroySession 负责（本用例直接伪造 HasEnded、
+            //   不走 DestroySession），故此处**不断言** pending 已被清——那不是接缝的职责。
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑩ ★★★ D（第二批复审落地）：**接缝内即时首帧**——真正抓得住错误实现的验收
+    //
+    // ★ 为什么要受控启动委托：原先用「反射预塞 _gameTask + 接缝返回后再 Publish」，
+    //   两条都抓不住内部顺序（Start 会 Task.Run 覆盖预置；Publish 发生在返回之后）。
+    //   现在把"启动这一步"换成受控动作，**在接缝内部、订阅已建立之后**立即 Publish。
+    //   ★ 若把接缝内两步反转为「Start → Subscribe」，同一个断言**必然失败**。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public async Task Seam_delivers_frame_published_inside_the_seam_by_the_start_step()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, _) = InstallPreparedSession(registry);
+
+            // ★ 受控启动：在接缝内部、订阅建立之后**立即**发布首帧
+            var sub = await registry.SubscribeThenStartAsync(session, s =>
+                s.IO.WriteLine("{\"kind\":\"first-frame-inside-seam\"}"));
+
+            Assert.NotNull(sub);
+            // ★ 首帧必须已在订阅的 Channel 里 —— 若接缝先启动后订阅，本断言必失败
+            Assert.True(sub!.Reader.TryRead(out var got));
+            Assert.Equal("{\"kind\":\"first-frame-inside-seam\"}", got);
+            sub.Hub.Unsubscribe(sub.Reader);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    [Fact]
+    public async Task Seam_unsubscribes_and_reclaims_when_start_throws()
+    {
+        var registry = CreateRegistry();
+        try
+        {
+            var (session, hub) = InstallPreparedSession(registry);
+            // ★ 先建立一个"旁路订阅者"——它不该受本次失败影响（验证是**精确**回收）
+            var bystander = hub.Subscribe();
+
+            // ★ 受控启动：同步抛异常
+            await Assert.ThrowsAsync<InvalidOperationException>(() =>
+                registry.SubscribeThenStartAsync(session, _ =>
+                    throw new InvalidOperationException("启动失败")));
+
+            // ★ 精确回收：接缝内建立的 reader **不得残留**在 hub 的订阅者列表里。
+            //   （只数订阅者数量——失败路径下那个 reader 没有返回给调用方，
+            //     无法直接从外部拿到它；而"数量回到基线"足以证明它已退订。）
+            var subscribers = (System.Collections.IList)typeof(OutputHub)
+                .GetField("_subscribers", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .GetValue(hub)!;
+            // ★ 只剩我自己建的 bystander，没有多出残留
+            //   （xUnit2013：不用 Assert.Equal 查集合大小，这里用带消息的布尔断言）
+            Assert.True(subscribers.Count == 1,
+                $"启动失败后 hub 只应剩 1 个订阅者（bystander），实际 {subscribers.Count}");
+
+            // ★ bystander 仍能收帧（证明回收是**精确**的，没有把别人的订阅也干掉）
+            session.IO.WriteLine("{\"kind\":\"after-failed-start\"}");
+            Assert.True(bystander.TryRead(out var bystanderGot));
+            Assert.Equal("{\"kind\":\"after-failed-start\"}", bystanderGot);
+
+            // ★ 会话复位为"已准备待启动"（pending 指回它）⇒ 允许重试
+            var pending = typeof(SessionRegistry)
+                .GetField("_pendingMauiSession", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
+                .GetValue(registry);
+            Assert.Same(session, pending);
+
+            // ★ 重试可成功（证明复位真的可用）
+            var retry = await registry.SubscribeThenStartAsync(session, s =>
+                s.IO.WriteLine("{\"kind\":\"retry-ok\"}"));
+            Assert.NotNull(retry);
+            Assert.True(retry!.Reader.TryRead(out var got));
+            Assert.Equal("{\"kind\":\"retry-ok\"}", got);
+
+            retry.Hub.Unsubscribe(retry.Reader);
+            hub.Unsubscribe(bystander);
+        }
+        finally { registry.DisposeAll(); }
+    }
+
+    // ---------------------------------------------------------------------
+    // ★★★ C7 · 身份判定测试（独立审阅 要求：只能标为"身份判定测试"）
+    //
+    // 覆盖**生产屏障本体** `SessionTurnGate.Evaluate`（Core 侧，BridgeHost 调用它）。
+    // ★ 不断言 BridgeHost——EraCore.Tests 不引用 EraCore.Maui，触达不到该类型。
+    //   这里验的是**被生产调用的同一份判定逻辑**，不是另写一份。
+    // ---------------------------------------------------------------------
+
+    private static Session NewSession() =>
+        MakeSession(new OutputHub());
+
+    [Fact]
+    public void Gate_allows_when_owner_is_current_and_host_alive()
+    {
+        var owner = NewSession();
+        var d = SessionTurnGate.Evaluate(owner, owner, hostDisposed: false, frameSessionId: owner.Id);
+        Assert.True(d.Allow, $"应放行：{d.Reason}");
+    }
+
+    [Fact]
+    public void Gate_denies_when_owner_is_no_longer_current()
+    {
+        var old = NewSession();
+        var current = NewSession();
+        // ★ 换局：owner 已是旧会话（即便帧内 sessionId 与 owner 一致）
+        var d = SessionTurnGate.Evaluate(old, current, hostDisposed: false, frameSessionId: old.Id);
+        Assert.False(d.Allow);
+    }
+
+    [Fact]
+    public void Gate_denies_when_host_disposed()
+    {
+        var owner = NewSession();
+        var d = SessionTurnGate.Evaluate(owner, owner, hostDisposed: true, frameSessionId: owner.Id);
+        Assert.False(d.Allow);
+    }
+
+    [Fact]
+    public void Gate_denies_when_frame_sessionId_differs_from_owner()
+    {
+        var owner = NewSession();
+        var d = SessionTurnGate.Evaluate(owner, owner, hostDisposed: false, frameSessionId: "别人的会话");
+        Assert.False(d.Allow);
+    }
+
+    [Fact]
+    public void Gate_missing_frame_sessionId_is_not_a_bypass()
+    {
+        var owner = NewSession();
+        var current = NewSession();
+
+        // ★ 缺字段 + owner 已旧 ⇒ 必须拒（缺字段不得成为绕过通路的依据）
+        Assert.False(SessionTurnGate.Evaluate(owner, current, false, frameSessionId: null).Allow);
+        // ★ 缺字段 + 宿主已退出 ⇒ 必须拒
+        Assert.False(SessionTurnGate.Evaluate(owner, owner, true, frameSessionId: null).Allow);
+        // ★ 缺字段但 owner 仍有效、宿主未退出 ⇒ 才放行（且 reason 说明缺字段）
+        var ok = SessionTurnGate.Evaluate(owner, owner, false, frameSessionId: null);
+        Assert.True(ok.Allow, ok.Reason);
+    }
+
+    [Fact]
+    public void Gate_frame_id_extraction_returns_null_on_unparsable_input()
+    {
+        Assert.Null(SessionTurnGate.TryReadFrameSessionId("not-json"));
+        Assert.Null(SessionTurnGate.TryReadFrameSessionId("{\"state\":\"WaitInput\"}"));
+        Assert.Equal("S1", SessionTurnGate.TryReadFrameSessionId("{\"sessionId\":\"S1\"}"));
+    }
+
+}
diff --git a/EraCore.Tests/SpriteCreateGRegistryTests.cs b/EraCore.Tests/SpriteCreateGRegistryTests.cs
new file mode 100644
index 00000000..03a96256
--- /dev/null
+++ b/EraCore.Tests/SpriteCreateGRegistryTests.cs
@@ -0,0 +1,129 @@
+using System;
+using System.IO;
+using MinorShift.Emuera;
+using MinorShift.Emuera.Primitives;
+using MinorShift.Emuera.UI.Game.Image;
+using Xunit;
+
+namespace Emuera.Headless.Tests;
+
+/// <summary>
+/// ★ 2026-10-09 新增：<c>SPRITECREATE</c> 不再「谎报成功」。
+///
+/// <para>修前：<see cref="AppContents.CreateSpriteG"/> 是空方法体，而调用方照样返回 1
+/// ⇒ 合成名之后**查不到** ⇒ <c>SPRITECREATED</c>/<c>SPRITEWIDTH</c>/<c>SPRITEHEIGHT</c> 对运行时合成名恒 0。
+/// 而游戏拿 <c>SPRITECREATED</c> 当**缓存守卫**（eraTW <c>BODY_INFO\ALTER_IMAGE_SET.ERB:9</c>）
+/// ⇒ 每次重跑合成、零报错。</para>
+///
+/// <para>GamePaths 是静态 Current ⇒ 与同类测试一样放串行隔离集合。
+/// ★ 本测试**不需要图片夹具**：合成名不经文件系统。</para>
+/// </summary>
+[Collection("GamePathsIsolated")]
+public class SpriteCreateGRegistryTests : IDisposable
+{
+    private readonly string _root;
+
+    public SpriteCreateGRegistryTests()
+    {
+        _root = Path.Combine(Path.GetTempPath(), "emuera_spritereg_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_root);
+        GamePaths.Resolve(_root, new FileSystemGameDirAccessor());
+    }
+
+    public void Dispose()
+    {
+        try { Directory.Delete(_root, true); } catch { }
+    }
+
+    /// <summary>造一块已知尺寸的画布（6 参形式里 rect 之外还依赖 parent 尺寸做回退）。</summary>
+    private static GraphicsImage Canvas(int id, int w, int h)
+    {
+        var g = AppContents.GetGraphics(id);
+        g.GCreate(w, h, false);
+        return g;
+    }
+
+    [Fact]
+    public void CreateSpriteG_makes_name_resolvable()
+    {
+        var g = Canvas(990001, 100, 50);
+        AppContents.CreateSpriteG("__合成_可查__", g, new EmuRectangle(0, 0, 100, 50));
+
+        var sprite = AppContents.GetSprite("__合成_可查__");
+
+        // ① SPRITECREATED 判定依赖 IsCreated
+        Assert.NotNull(sprite);
+        Assert.True(sprite!.IsCreated, "★ 修前这里必为 null —— 那正是「谎报成功」的根因");
+    }
+
+    [Fact]
+    public void CreateSpriteG_reports_rect_size()
+    {
+        var g = Canvas(990002, 100, 50);
+        AppContents.CreateSpriteG("__合成_尺寸__", g, new EmuRectangle(0, 0, 37, 19));
+
+        var sprite = AppContents.GetSprite("__合成_尺寸__");
+
+        // ② SPRITEWIDTH / SPRITEHEIGHT 读的就是 DestBaseSize
+        Assert.NotNull(sprite);
+        Assert.Equal(37, sprite!.DestBaseSize.Width);
+        Assert.Equal(19, sprite.DestBaseSize.Height);
+    }
+
+    [Fact]
+    public void Dispose_removes_registered_name()
+    {
+        var g = Canvas(990003, 20, 20);
+        AppContents.CreateSpriteG("__合成_释放__", g, new EmuRectangle(0, 0, 20, 20));
+        Assert.NotNull(AppContents.GetSprite("__合成_释放__"));
+
+        // ③ SPRITEDISPOSE（SpriteDisposeMethod 会先 GetSprite 确认存在，再调这里）
+        AppContents.SpriteDispose("__合成_释放__");
+
+        Assert.Null(AppContents.GetSprite("__合成_释放__"));
+    }
+
+    [Fact]
+    public void Zero_rect_falls_back_to_parent_size()
+    {
+        // 2 参形式传 (0,0,parent.W,parent.H)；但脚本也可能传全零矩形 ⇒ 必须退回父画布尺寸，
+        // 否则会登记一个 0×0 的假精灵（那等于换一种方式撒谎）。
+        var g = Canvas(990004, 64, 32);
+        AppContents.CreateSpriteG("__合成_零矩形__", g, default);
+
+        var sprite = AppContents.GetSprite("__合成_零矩形__");
+
+        Assert.NotNull(sprite);
+        Assert.Equal(64, sprite!.DestBaseSize.Width);
+        Assert.Equal(32, sprite.DestBaseSize.Height);
+    }
+
+    [Fact]
+    public void Negative_origin_rect_uses_width_height_only()
+    {
+        // ReadRectangle 允许负起点（WinForms 语义：四角形可正可负，只要与父图画布相交）。
+        // ⇒ 登记尺寸只能取 Width/Height，不能把负数当尺寸。
+        var g = Canvas(990005, 100, 100);
+        AppContents.CreateSpriteG("__合成_负起点__", g, new EmuRectangle(-10, -5, 40, 30));
+
+        var sprite = AppContents.GetSprite("__合成_负起点__");
+
+        Assert.NotNull(sprite);
+        Assert.Equal(40, sprite!.DestBaseSize.Width);
+        Assert.Equal(30, sprite.DestBaseSize.Height);
+    }
+
+    [Fact]
+    public void Recreate_overwrites_previous_entry()
+    {
+        var g = Canvas(990006, 100, 100);
+        AppContents.CreateSpriteG("__合成_覆盖__", g, new EmuRectangle(0, 0, 10, 10));
+        AppContents.CreateSpriteG("__合成_覆盖__", g, new EmuRectangle(0, 0, 80, 60));
+
+        var sprite = AppContents.GetSprite("__合成_覆盖__");
+
+        Assert.NotNull(sprite);
+        Assert.Equal(80, sprite!.DestBaseSize.Width);
+        Assert.Equal(60, sprite.DestBaseSize.Height);
+    }
+}
diff --git a/EraCore.Tests/SqlSessionIsolationTests.cs b/EraCore.Tests/SqlSessionIsolationTests.cs
new file mode 100644
index 00000000..2f36bf4b
--- /dev/null
+++ b/EraCore.Tests/SqlSessionIsolationTests.cs
@@ -0,0 +1,652 @@
+using System;
+using System.Collections;
+using System.IO;
+using System.Reflection;
+using System.Threading;
+using System.Threading.Tasks;
+using Microsoft.Data.Sqlite;
+using MinorShift.Emuera.GameData.Function;
+using MinorShift.Emuera.Runtime.Config;
+using MinorShift.Emuera.Server;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+/// <summary>
+/// SQL 运行时（<see cref="EESqlRuntime"/>）会话隔离回归。
+///
+/// <para><b>缺陷</b>：<c>_conns</c> / <c>_readers</c> 是进程级静态，而既有的 <c>Reset()</c>
+/// 全仓零调用方（死代码）⇒ 旧会话结束后连接仍留在池里，新会话用同名连接时直接拿到旧会话的连接
+/// ⇒ 跨游戏目录读到并写坏旧库。</para>
+///
+/// <para><b>本文件的定位</b>：把“真实会话链已复现的换局串库”转成调用真实生产代码的正式回归。
+/// 两条腿：</para>
+/// <list type="bullet">
+/// <item><b>作用域级</b>——真实 <see cref="GlobalStatic.OpenScope"/> 会话作用域 + 真实
+/// <see cref="EESqlRuntime"/> 指令入口（等价 ERB 的 <c>SQL_*</c> 路径）；</item>
+/// <item><b>会话级</b>——真实 <c>SessionRegistry.ReplaceForLoadGameAsync</c> 换局事务 +
+/// 真实 ERB 游戏夹具（ERB 内直接写 <c>SQL_CONNECT</c> / <c>SQL_EXECUTE_NONQUERY</c>）。</item>
+/// </list>
+///
+/// <para><b>★ 数据归属判据（本轮修正）</b>：库内容一律用
+/// <see cref="ReadIndependent"/>——一条**独立的只读 SQL 连接**查询真实记录，
+/// <b>不经</b>被测 <see cref="EESqlRuntime"/>。★ 不再用“扫描库文件字节”作判据：
+/// SQLite 文件可能保留已删除 / 被替换记录的旧字节，字节命中**不能**证明当前记录归属
+/// （它只能作非决定性诊断，本文件已移除该手段）。</para>
+///
+/// <para><b>预置方式</b>：两侧标记由 <see cref="GameDir.SeedDatabase"/> 用独立连接写入并**立即关闭**
+/// （<c>Pooling=false</c>）——既不进入被测命名连接池，也不经过被测运行时代码；
+/// 因此“B 读到 B 自己预置的标记”这一判据与“会话自身写入”完全解耦。</para>
+///
+/// <para><b>测试隔离</b>：静态池跨用例存活，故每个用例起始显式调用生产 API
+/// <c>EESqlRuntime.Reset()</c> 做隔离。它不构成生产修复的依赖——生产路径的释放由
+/// 会话作用域结束触发（见 <see cref="Scope_end_releases_connections_readers_and_reader_ids"/>）。</para>
+///
+/// <para><b>不做什么</b>：不调用 Reset / 清池 / 强制 GC 去“帮助”被测路径通过；
+/// 观测连接只读、不创建、不迁移、不改库。</para>
+/// </summary>
+[Collection("ServerState")]
+public sealed class SqlSessionIsolationTests
+{
+    // ------------------------------------------------------------------
+    // 观测：只读反射读取生产静态池（不做任何生产流程没有做的清理）
+    // ------------------------------------------------------------------
+
+    private static IDictionary SqlPool(string field)
+        => (IDictionary)typeof(EESqlRuntime)
+            .GetField(field, BindingFlags.NonPublic | BindingFlags.Static)!
+            .GetValue(null)!;
+
+    private static int ConnCount() => SqlPool("_conns").Count;
+
+    private static int ReaderCount() => SqlPool("_readers").Count;
+
+    /// <summary>观测池内某连接名当前指向哪个数据源（判断“缓存里指向谁”）。</summary>
+    private static string? ConnDataSource(string name)
+    {
+        var conn = SqlPool("_conns")[name];
+        return conn?.GetType().GetProperty("DataSource")?.GetValue(conn) as string;
+    }
+
+    /// <summary>观测连接对象自身的状态（Open / Closed）——对象级释放证据。</summary>
+    private static string? ConnState(object? conn)
+        => conn?.GetType().GetProperty("State")?.GetValue(conn)?.ToString();
+
+    private static FieldInfo Field(Type type, string name)
+        => type.GetField(name, BindingFlags.Instance | BindingFlags.NonPublic)!;
+
+    private static SessionRegistry CreateRegistry()
+        => new(new SessionRegistryTests.NullTerminalSetup(), new GameConfigService(new ConfigData()));
+
+    /// <summary>反射装入一个未启动的会话（与既有 SessionLifecycleSafetyTests 同款可控夹具手段）。</summary>
+    private static Session InstallSession(SessionRegistry registry)
+    {
+        var hub = new OutputHub();
+        var session = new Session(new HttpSessionIO(hub), new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        Field(typeof(SessionRegistry), "_session").SetValue(registry, session);
+        Field(typeof(SessionRegistry), "_sessionHub").SetValue(registry, hub);
+        return session;
+    }
+
+    // ------------------------------------------------------------------
+    // ★ 独立只读查询：数据归属的唯一判据
+    // ------------------------------------------------------------------
+
+    /// <summary>表中某 key 的当前值；表中确实没有该 key 时返回 null。</summary>
+    /// <remarks>
+    /// 独立连接、只读打开、禁用连接池、当场 Dispose。不经被测 <c>EESqlRuntime</c>。
+    /// ★ 文件不存在直接失败——避免“查询动作自动建库”把缺席误读成空结果。
+    /// </remarks>
+    private static string? ReadIndependentOrNull(string dbPath, string key)
+    {
+        Assert.True(File.Exists(dbPath), "独立查询前库文件必须已存在：" + dbPath);
+        var cs = new SqliteConnectionStringBuilder
+        {
+            DataSource = dbPath,
+            Mode = SqliteOpenMode.ReadOnly,   // 只读：不创建、不迁移、不改库
+            Pooling = false,                  // 不留在 SQLite 连接池里
+        }.ToString();
+        using var conn = new SqliteConnection(cs);
+        conn.Open();
+        using var cmd = conn.CreateCommand();
+        cmd.CommandText = "SELECT v FROM t WHERE k = $k";
+        cmd.Parameters.AddWithValue("$k", key);
+        var value = cmd.ExecuteScalar();
+        return value is null or DBNull ? null : Convert.ToString(value);
+    }
+
+    /// <summary>独立查询并要求记录存在（缺失即失败，且诊断信息带库路径与 key）。</summary>
+    private static string ReadIndependent(string dbPath, string key)
+        => ReadIndependentOrNull(dbPath, key)
+           ?? throw new InvalidOperationException(
+               $"独立只读查询未取得记录：db={dbPath} key={key}（记录缺失，不是空值）");
+
+    // ------------------------------------------------------------------
+    // 夹具
+    // ------------------------------------------------------------------
+
+    /// <summary>运行时生成的隔离游戏目录（不硬编码本机路径、不触碰真实游戏材料）。</summary>
+    private sealed class GameDir : IDisposable
+    {
+        public string Root { get; }
+        public string DbPath => Path.Combine(Root, "plugins", "data.db");
+
+        public GameDir(string tag)
+        {
+            Root = Path.Combine(Path.GetTempPath(), "erarelay-sql-" + tag + "-" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(Path.Combine(Root, "csv"));
+            Directory.CreateDirectory(Path.Combine(Root, "erb"));
+            Directory.CreateDirectory(Path.Combine(Root, "plugins"));
+        }
+
+        /// <summary>
+        /// ★ 用**独立连接**预置库与记录（不经被测运行时代码、不进它的事件命名连接池）。
+        /// 连接写完立即关闭（<c>Pooling=false</c>）⇒ 会话启动前该库已是“已存在且有数据”的状态，
+        /// 于是“新会话读到什么”完全由被测路径决定。
+        /// 无记录时仅建表（用于需要空表的用例）。
+        /// </summary>
+        public void SeedDatabase(params (string Key, string Value)[] rows)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(DbPath)!);
+            var cs = new SqliteConnectionStringBuilder
+            {
+                DataSource = DbPath,
+                Mode = SqliteOpenMode.ReadWriteCreate,
+                Pooling = false,
+            }.ToString();
+            using (var conn = new SqliteConnection(cs))
+            {
+                conn.Open();
+                using (var create = conn.CreateCommand())
+                {
+                    create.CommandText = "CREATE TABLE IF NOT EXISTS t (k TEXT PRIMARY KEY, v TEXT)";
+                    create.ExecuteNonQuery();
+                }
+                foreach (var (key, value) in rows)
+                {
+                    using var insert = conn.CreateCommand();
+                    insert.CommandText = "INSERT OR REPLACE INTO t (k, v) VALUES ($k, $v)";
+                    insert.Parameters.AddWithValue("$k", key);
+                    insert.Parameters.AddWithValue("$v", value);
+                    insert.ExecuteNonQuery();
+                }
+            }
+        }
+
+        /// <summary>
+        /// 复制仓库既有 test_game 的静态素材（csv / img / resources）作最小可用游戏，
+        /// 但<b>不</b>复制它的 erb（避免与本夹具的入口标签重名），随后写入本夹具自己的 ERB。
+        /// ERB 只**写**一个独立 key（<paramref name="wroteKey"/>）——库里的初始标记由
+        /// <see cref="SeedDatabase"/> 预置，故“读到的标记”与“会话自己写的值”互不掩盖。
+        /// </summary>
+        public void WriteGameFixture(string wroteKey, string wroteValue)
+        {
+            var source = SessionRegistryTests.FindTestGameDir();
+            foreach (var name in new[] { "csv", "img", "resources" })
+            {
+                var src = Path.Combine(source, name);
+                if (Directory.Exists(src))
+                    CopyTree(src, Path.Combine(Root, name));
+            }
+            Directory.CreateDirectory(Path.Combine(Root, "erb"));
+            Directory.CreateDirectory(Path.Combine(Root, "plugins"));
+            File.WriteAllText(Path.Combine(Root, "erb", "SQL_PROBE.ERB"),
+                "@SYSTEM_TITLE\n" +
+                "SQL_CONNECT \"DB\", \"plugins/data.db\"\n" +
+                "SQL_EXECUTE_NONQUERY \"DB\", \"CREATE TABLE IF NOT EXISTS t (k TEXT PRIMARY KEY, v TEXT)\"\n" +
+                "SQL_EXECUTE_NONQUERY \"DB\", \"INSERT OR REPLACE INTO t (k,v) VALUES ('" + wroteKey + "','" + wroteValue + "')\"\n" +
+                "QUIT\n");
+        }
+
+        private static void CopyTree(string source, string destination)
+        {
+            Directory.CreateDirectory(destination);
+            foreach (var file in Directory.GetFiles(source))
+                File.Copy(file, Path.Combine(destination, Path.GetFileName(file)), overwrite: true);
+            foreach (var dir in Directory.GetDirectories(source))
+                CopyTree(dir, Path.Combine(destination, Path.GetFileName(dir)));
+        }
+
+        /// <summary>
+        /// 尽力清理：SQLite 连接池可能仍持有文件句柄（这不是本缺陷的判据），
+        /// 删除失败时保留临时目录，不让清理动作污染测试结论。
+        /// </summary>
+        public void Dispose()
+        {
+            try { Directory.Delete(Root, recursive: true); } catch { }
+        }
+    }
+
+    // 生产指令入口都是 (db, sql, object[]? ps) 形态；ERB 的 SQL_* 无参调用即 ps=null。
+    private static void NonQuery(string db, string sql) => EESqlRuntime.ExecNonQuery(db, sql, null);
+    private static string Scalar(string db, string sql) => EESqlRuntime.ExecScalarString(db, sql, null);
+    private static long Reader(string db, string sql) => EESqlRuntime.OpenReader(db, sql, null);
+
+    private const string CreateTable = "CREATE TABLE IF NOT EXISTS t (k TEXT PRIMARY KEY, v TEXT)";
+
