@@ -0,0 +1,95 @@
+import type { DisplayEntry, DisplayLine, PrintSegment } from '../types/protocol';
+
+/**
+ * lineLayout —— 按「字符列」给一行内的条目定位。
+ *
+ * 为什么需要：前端此前完全忽略 `ButtonRef.col` / `width`，靠 monospace 流式排列对齐。
+ * 但按钮行的列位是引擎按显示宽度**逐项累加**得出的，流式排列会让逐项舍入误差累积，
+ * 使同一列在不同行落到不同位置（实测同一列落到 28 与 57），纵向怎么都对不齐。
+ * 改为按列位摆放后，每行的 `[` 都落在同一列上。
+ *
+ * ★ 度量口径必须与 C# `TerminalDisplayWidth.IsWideChar` 完全一致 ——
+ *   差一个字符的判定，整行就会偏移一列。改动前先对照那边的实现。
+ */
+
+/**
+ * 该码位是否占 2 列（全角）。与 C# `TerminalDisplayWidth.IsWideChar` 同口径。
+ *
+ * 注意 Block Elements（U+2580-259F，如 ░▒▓█）在游戏脚本中按**半角**使用，
+ * 因此不列入全角——这是引擎与终端渲染之间最容易搞错的一条。
+ */
+export function isWideChar(code: number): boolean {
+  // CJK 统一汉字 / 韩文 / 兼容汉字
+  if ((code >= 0x2e80 && code <= 0x9fff)
+    || (code >= 0xac00 && code <= 0xd7af)
+    || (code >= 0xf900 && code <= 0xfaff)) return true;
+  // 全角 ASCII 变体与全角符号
+  if ((code >= 0xff01 && code <= 0xff60)
+    || (code >= 0xffe0 && code <= 0xffe6)) return true;
+  // CJK 兼容形式
+  if (code >= 0xfe30 && code <= 0xfe4f) return true;
+  // 制表符（━┃┏┗ 等）：游戏设计为全角
+  if (code >= 0x2500 && code <= 0x257f) return true;
+  // 几何图形（●■◆▲ 等）：游戏设计为全角
+  if (code >= 0x25a0 && code <= 0x25ff) return true;
+  // 杂项符号（★☆ 等）：游戏设计为全角
+  if (code >= 0x2600 && code <= 0x26ff) return true;
+  return false;
+}
+
+/** 字符串的显示列数（半角 1 列、全角 2 列）。 */
+export function displayWidth(s: string): number {
+  let w = 0;
+  for (let i = 0; i < s.length; i += 1) {
+    w += isWideChar(s.charCodeAt(i)) ? 2 : 1;
+  }
+  return w;
+}
+
+/** 条目里各文本片段的显示列数之和。
+ *  图片/形状片段的列宽需引擎侧的字体度量才能精确换算，这里不参与定位——
+ *  带图片的按钮总是自带 `col`/`width`，不依赖本函数推算。 */
+function segmentsWidth(segments: PrintSegment[]): number {
+  let w = 0;
+  for (const seg of segments) {
+    if (seg.text) w += displayWidth(seg.text);
+  }
+  return w;
+}
+
+/** 一个条目在行内的落位。 */
+export interface EntryPlacement {
+  entry: DisplayEntry;
+  /** 起始列（0 基）。 */
+  col: number;
+  /** 占用的列数。 */
+  width: number;
+}
+
+/**
+ * 把一行展开成带列位的条目序列（保持原顺序）。
+ *
+ * 按钮优先走引擎给出的 `col` / `width`（权威值）；其余条目从当前游标累加自身的
+ * 显示列数。这样即使文本条目夹在按钮之间，后续按钮的列位也仍然以引擎值为准。
+ */
+export function layoutLine(line: DisplayLine): EntryPlacement[] {
+  const out: EntryPlacement[] = [];
+  let cursor = 0;
+  for (const entry of line.entries) {
+    const btn = entry.button;
+    const width = Math.max(0, btn?.width ?? segmentsWidth(entry.segments));
+    const col = btn?.col ?? cursor;
+    out.push({ entry, col, width });
+    cursor = col + width;
+  }
+  return out;
+}
+
+/** 一行占用的总列数（用于生成网格模板）。 */
+export function lineColumns(line: DisplayLine): number {
+  let max = 0;
+  for (const p of layoutLine(line)) {
+    max = Math.max(max, p.col + p.width);
+  }
+  return max;
+}
