diff --git a/EraCore.Maui/Platforms/Windows/CrashLog.cs b/EraCore.Maui/Platforms/Windows/CrashLog.cs
new file mode 100644
index 00000000..29071ec1
--- /dev/null
+++ b/EraCore.Maui/Platforms/Windows/CrashLog.cs
@@ -0,0 +1,306 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using System.Threading.Tasks;
+
+namespace EraCore.Maui;
+
+/// <summary>
+/// ★ Windows 端崩溃与诊断落盘（2026-10-03）——与 <c>Platforms/Android/CrashLog.cs</c> 对称。
+/// <para>
+/// <b>动机（两条，均由需求方 2026-10-03 提出）</b>：
+/// <list type="number">
+///   <item><b>崩溃看不见</b>：Windows 版此前只有 <c>Console.WriteLine</c>（DEBUG 下 <c>AllocConsole</c> 的那个窗口），
+///     <b>窗口一关日志即消失</b>；WinUI 未处理异常导致进程以 <c>0xC000027B</c> 退出时<b>不留任何痕迹</b>，
+///     「提升稳定性」根本无从下手。</item>
+///   <item><b>「程序位置」会让全部写入被拒</b>：实测把 exe 放在<b>桌面</b>目录下运行时，该进程的<b>所有</b>文件写入
+///     都被系统拒绝（<c>UnauthorizedAccessException</c>，连 <c>%LOCALAPPDATA%</c> 都写不进），换到 D 盘即正常。
+///     ★ 但「换到 D 盘」对<b>单分区 Windows 平板（只有 C:）不成立</b> → 必须让程序<b>自己说清：
+///     能不能写、写到了哪、哪个位置为什么写不了</b>。</item>
+/// </list>
+/// </para>
+/// <para>
+/// <b>做三件事</b>：
+/// ① 把 <c>Console.Out/Error</c> 整体 <b>tee 到日志文件</b>——既有全部诊断（<c>[maui]</c>/<c>[bridge]</c>/<c>[server]</c>）
+///    <b>不改任何调用点</b>即落盘；
+/// ② 挂全局未捕获异常（AppDomain / TaskScheduler / WinUI <c>Application.UnhandledException</c>）；
+/// ③ ★ <b>写能力探测</b>：逐个试候选目录，把「每个候选是否可写、失败异常类型」写进会话头
+///    —— 这是回答「这台机器/这个位置到底能不能跑」的<b>唯一可靠依据</b>。
+/// </para>
+/// <para>
+/// <b>落点</b>（按序试，第一个能写的胜出）：<c>&lt;exe 目录&gt;\logs\</c> → <c>%LOCALAPPDATA%\EmueraCore\logs\</c>
+/// → <c>%TEMP%\EraCore\logs\</c>。
+/// </para>
+/// <para>
+/// <b>铁律</b>：本类<b>绝不因自身失败而影响启动</b>——所有 IO 都吞异常，最坏情况只是「没有日志」。
+/// </para>
+/// </summary>
+internal static class CrashLog
+{
+    private const string LogFileName = "eracore-maui.log";
+
+    private static readonly object Gate = new();
+    private static readonly StringBuilder ProbeReport = new();
+
+    private static bool _installDone;
+    private static bool _teeDone;
+    private static TextWriter? _fileWriter;
+    private static string? _logPath;
+
+    /// <summary>当前生效的日志文件路径；未启用时为 <c>null</c>。</summary>
+    internal static string? LogPath
+    {
+        get { lock (Gate) { return _logPath; } }
+    }
+
+    /// <summary>候选日志目录（按优先级）。探测结果会写进会话头。</summary>
+    private static IEnumerable<string> CandidateDirs()
+    {
+        // ① exe 同级的 logs\ —— 最直观、便于用户直接找到并回传
+        yield return Path.Combine(AppContext.BaseDirectory, "logs");
+
+        // ② %LOCALAPPDATA%\EmueraCore\logs\ —— 与发现记录（eracore-maui-server.json）同一父目录
+        var local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
+        if (!string.IsNullOrEmpty(local))
+            yield return Path.Combine(local, "EmueraCore", "logs");
+
+        // ③ %TEMP%\EraCore\logs\ —— 最后兜底（通常最宽松）
+        yield return Path.Combine(Path.GetTempPath(), "EraCore", "logs");
+    }
+
+    /// <summary>
+    /// 安装钩子 + 探测落点 + 打开写入器。重复调用无副作用。
+    /// 时机：<see cref="WinUI.App"/> 构造（早于 <c>CreateMauiApp</c>），与 Android 侧从
+    /// <c>MainApplication</c> 静态构造安装对称。
+    /// </summary>
+    internal static void Install()
+    {
+        lock (Gate)
+        {
+            if (_installDone)
+                return;
+            _installDone = true;
+        }
+
+        PickLogPath();
+
+        AppDomain.CurrentDomain.UnhandledException += (_, e) => Write(
+            "AppDomain.UnhandledException",
+            e.ExceptionObject as Exception,
+            e.ExceptionObject?.ToString());
+
+        TaskScheduler.UnobservedTaskException += (_, e) =>
+        {
+            Write("TaskScheduler.UnobservedTaskException", e.Exception, null);
+            e.SetObserved();
+        };
+    }
+
+    /// <summary>
+    /// 挂 WinUI 层的未处理异常。<b>必须由 <see cref="WinUI.App"/> 自己调用</b>（能拿到实例事件），
+    /// 这是 UI 线程异常（进程以 0xC000027B 消失那一类）唯一能留下证据的地方。
+    /// </summary>
+    internal static void HookWinUI(Microsoft.UI.Xaml.Application app)
+    {
+        try
+        {
+            app.UnhandledException += (_, e) => Write("WinUI.UnhandledException", e.Exception, null);
+        }
+        catch (Exception ex)
+        {
+            Write("HookWinUI", ex, null);
+        }
+    }
+
+    /// <summary>
+    /// ★ 把 <c>Console.Out/Error</c> tee 到日志文件。
+    /// <b>必须在 <c>AllocConsole()</c> 之后调用</b>——否则会抓住「还没有 console」时的空 writer，
+    /// 反而让 console 窗口看不到任何输出（调试体验倒退）。
+    /// </summary>
+    internal static void InstallConsoleTee()
+    {
+        lock (Gate)
+        {
+            if (_teeDone)
+                return;
+            _teeDone = true;
+
+            var path = _logPath;
+            if (path == null)
+                return;
+
+            try
+            {
+                var writer = TextWriter.Synchronized(new StreamWriter(
+                    new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite),
+                    new UTF8Encoding(encoderShouldEmitUTF8Identifier: false))
+                {
+                    AutoFlush = true,
+                });
+                _fileWriter = writer;
+
+                // 注意：先取到"当前"的 Console.Out/Error 再替换，Tee 内部持有原始 writer，
+                // 不会因为 SetOut 之后再次读取 Console.Out 而递归。
+                Console.SetOut(new TeeWriter(Console.Out, writer));
+                Console.SetError(new TeeWriter(Console.Error, writer));
+            }
+            catch (Exception ex)
+            {
+                _fileWriter = null;
+                Console.Error.WriteLine($"[crashlog] console tee 安装失败: {ex.GetType().Name}: {ex.Message}");
+            }
+        }
+    }
+
+    /// <summary>开一次引导记录：写会话头（含写能力探测结果）。</summary>
+    internal static void BeginSession()
+    {
+        var sb = new StringBuilder();
+        sb.AppendLine("==================== boot " + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff") + " ====================");
+        sb.Append("exe      : ").AppendLine(Environment.ProcessPath ?? "(unknown)");
+        sb.Append("baseDir  : ").AppendLine(AppContext.BaseDirectory);
+        sb.Append("cwd      : ").AppendLine(Environment.CurrentDirectory);
+        sb.Append("logPath  : ").AppendLine(_logPath ?? "(none)");
+        sb.Append("process  : ").Append(Environment.Is64BitProcess ? "x64" : "x86")
+          .Append("  user=").Append(Environment.UserName)
+          .Append("  os=").AppendLine(Environment.OSVersion.VersionString);
+        sb.AppendLine("---- 写能力探测（★ 回答「这台机器/这个位置能不能跑」） ----");
+        lock (Gate)
+        {
+            sb.Append(ProbeReport);
+        }
+        sb.AppendLine("---- 探测结束 ----");
+
+        Append(sb.ToString());
+    }
+
+    /// <summary>记录一个引导步骤（定位「进程静默消失」用）。</summary>
+    internal static void Mark(string step)
+        => Append($"[{DateTime.Now:HH:mm:ss.fff}] {step}{Environment.NewLine}");
+
+    /// <summary>落盘一条异常记录。自身绝不抛异常——否则会把原始崩溃信息盖掉。</summary>
+    internal static void Write(string source, Exception? ex, string? fallback)
+    {
+        var sb = new StringBuilder();
+        sb.Append("==== ").Append(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff"))
+          .Append(" | ").Append(source).AppendLine(" ====");
+        if (ex is not null)
+            sb.AppendLine(ex.ToString());
+        else if (!string.IsNullOrEmpty(fallback))
+            sb.AppendLine(fallback);
+
+        var text = sb.ToString();
+        Append(text);
+
+        // 同时走 stderr（已被 tee 到文件）——保证在 console 窗口里也看得见。
+        try { Console.Error.Write(text); } catch { /* ignore */ }
+    }
+
+    /// <summary>逐个试候选目录，记录每个的可写性，并选定第一个能写的。</summary>
+    private static void PickLogPath()
+    {
+        lock (Gate)
+        {
+            if (_logPath != null)
+                return;
+
+            foreach (var dir in CandidateDirs())
+            {
+                try
+                {
+                    Directory.CreateDirectory(dir);
+                    var path = Path.Combine(dir, LogFileName);
+                    // FileMode.Append 会创建文件并需要写权限——本身就是一次真实的写能力探测。
+                    using (new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
+                    {
+                    }
+
+                    // ★ 落点取【第一个】可写的；但探测继续跑完，以便把完整"哪里能写"矩阵写进会话头
+                    //   （否则日志里只剩"第一个 OK"，回答不了「这台机器哪些位置能写」）。
+                    if (_logPath == null)
+                        _logPath = path;
+                    ProbeReport.Append("  [OK]   ").AppendLine(path);
+                }
+                catch (Exception ex)
+                {
+                    ProbeReport.Append("  [FAIL] ").Append(dir)
+                               .Append("  → ").Append(ex.GetType().Name).Append(": ")
+                               .AppendLine(ex.Message);
+                }
+            }
+        }
+    }
+
+    /// <summary>追加到日志文件；writer 不可用时退回「逐个候选路径直接追加」。绝不抛。</summary>
+    private static void Append(string text)
+    {
+        var w = _fileWriter;
+        if (w != null)
+        {
+            try
+            {
+                w.Write(text);
+                w.Flush();
+                return;
+            }
+            catch
+            {
+                // 落盘失败 → 走下面的兜底。
+            }
+        }
+
+        foreach (var dir in CandidateDirs())
+        {
+            try
+            {
+                Directory.CreateDirectory(dir);
+                File.AppendAllText(Path.Combine(dir, LogFileName), text);
+                return;
+            }
+            catch
+            {
+                // 换下一个落点；全部失败则只能放弃。
+            }
+        }
+    }
+
+    /// <summary>把输出同时写到「原始 writer」与「日志文件」。任一失败不影响另一方。</summary>
+    private sealed class TeeWriter : TextWriter
+    {
+        private readonly TextWriter _console;
+        private readonly TextWriter _file;
+
+        internal TeeWriter(TextWriter console, TextWriter file)
+        {
+            _console = console;
+            _file = file;
+        }
+
+        public override Encoding Encoding => _console.Encoding;
+
+        public override void Write(char value)
+        {
+            try { _console.Write(value); } catch { /* ignore */ }
+            try { _file.Write(value); } catch { /* ignore */ }
+        }
+
+        public override void Write(string? value)
+        {
+            try { _console.Write(value); } catch { /* ignore */ }
+            try { _file.Write(value); } catch { /* ignore */ }
+        }
+
+        public override void WriteLine()
+        {
+            try { _console.WriteLine(); } catch { /* ignore */ }
+            try { _file.WriteLine(); } catch { /* ignore */ }
+        }
+
+        public override void Flush()
+        {
+            try { _console.Flush(); } catch { /* ignore */ }
+            try { _file.Flush(); } catch { /* ignore */ }
+        }
+    }
+}
