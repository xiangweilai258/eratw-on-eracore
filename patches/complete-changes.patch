 });
+
+describe('useGameStore - 自动适配缩放（autoFitScale）', () => {
+  // ★★ 背景（2026-10-10）：引擎的 `windowWidth`（= `Config.WindowX`）是**排版坐标系宽度（逻辑宽）**，
+  //   由宿主固定成游戏设计画布宽，不再跟随设备像素 —— 否则同一份内容在每台设备上排出的
+  //   换行与列数都不同，而原版（GEmuera：Godot 固定逻辑画布 + 整幅等比放大）是「处处一致」。
+  //   适配屏幕的职责因此落到视图层：按「容器可用宽 ÷ 逻辑宽」把整幅画面等比缩放。
+  //   ★ 与用户手动捏合是**两级相乘**关系，自动适配不得吃掉用户的手动值。
+  beforeEach(() => {
+    setActivePinia(createPinia());
+    vi.stubGlobal('localStorage', { getItem: () => null, setItem: vi.fn() });
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it('默认 1.0——不影响既有的 effectiveScale 语义', () => {
+    const game = useGameStore();
+    expect(game.autoFitScale).toBe(1.0);
+    game.setScale(1.5);
+    expect(game.effectiveScale).toBe(1.5);
+  });
+
+  it('★ 与用户手动缩放两级相乘（自动适配不吃掉手动值）', () => {
+    const game = useGameStore();
+    game.setScale(1.5);
+    game.setAutoFitScale(0.8);
+    expect(game.effectiveScale).toBeCloseTo(1.2, 5);
+  });
+
+  it('★ 不受用户缩放那套 [0.5, 2.0] 限制（小屏 fit 系数必然小于 0.5）', () => {
+    const game = useGameStore();
+    game.setAutoFitScale(0.3);
+    expect(game.autoFitScale).toBe(0.3);
+    expect(game.effectiveScale).toBeCloseTo(0.3, 5);
+  });
+
+  it('防爆范围 [0.1, 4.0]：超范围夹住，非法值回落 1.0', () => {
+    const game = useGameStore();
+    game.setAutoFitScale(99);
+    expect(game.autoFitScale).toBe(4.0);
+    game.setAutoFitScale(0.001);
+    expect(game.autoFitScale).toBe(0.1);
+    game.setAutoFitScale(Number.NaN);
+    expect(game.autoFitScale).toBe(1.0);
+    game.setAutoFitScale(0);
+    expect(game.autoFitScale).toBe(1.0);
+  });
+
+  it('★ isMinScale / isMaxScale 只看用户系数（否则小屏上一直显示"已到最小"）', () => {
+    const game = useGameStore();
+    game.setAutoFitScale(0.3);
+    expect(game.isMinScale).toBe(false);
+    game.setScale(0.5);
+    expect(game.isMinScale).toBe(true);
+  });
+
+  it('★ 不持久化——每次布局变化都要重算', () => {
+    const setItem = vi.fn();
+    vi.stubGlobal('localStorage', { getItem: () => null, setItem });
+    const game = useGameStore();
+    game.setAutoFitScale(0.7);
+    expect(game.autoFitScale).toBe(0.7);
+    expect(setItem).not.toHaveBeenCalled();
+  });
+});
