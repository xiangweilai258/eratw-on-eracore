+    // ★★★ C7 · 顺序确定性测试（独立审阅 要求：必须复用生产屏障，不得另写一份）
+    //
+    // 生产形状（BridgeHost.PostTurnForSession）：
+    //     ① 入队前 Evaluate(owner, _session, _disposed, frameId)
+    //     ② Dispatch(() => { Evaluate(owner, _session, _disposed, frameId)  ← 读"此刻"的值
+    //                        并投递 })
+    // 本测试逐字复刻这个形状（含"回调时重新读取当前会话"这一点）。
+    // ---------------------------------------------------------------------
+
+    /// <summary>复刻生产的两步投递，返回"是否真的调用了前端"。</summary>
+    private static bool DeliverWithGate(
+        Session? owner, string turnJson, Session? currentAtEnqueue, bool disposedAtEnqueue,
+        Func<Session?> currentNow, Func<bool> disposedNow,
+        Action<string> postToFrontend)
+    {
+        // ① 入队前核验（此刻的值）
+        var frameId = SessionTurnGate.TryReadFrameSessionId(turnJson);
+        if (!SessionTurnGate.Evaluate(owner, currentAtEnqueue, disposedAtEnqueue, frameId).Allow)
+            return false;
+
+        // ② 回调内核验——**重新读取此刻的当前会话与退出状态**（不复用入队时的结果）
+        var later = SessionTurnGate.Evaluate(owner, currentNow(), disposedNow(), frameId);
+        if (!later.Allow)
+            return false;
+
+        postToFrontend(turnJson);
+        return true;
+    }
+
+    [Fact]
+    public void Turn_queued_before_switch_is_dropped_when_dispatched_after_switch()
+    {
+        var old = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var fresh = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var oldTurn = "{\"sessionId\":\"" + old.Id + "\",\"state\":\"WaitInput\"}";
+
+        var posted = new List<string>();
+
+        // 入队时：当前会话还是 old；回调时：已换成 fresh（换局发生在排队之后）
+        var delivered = DeliverWithGate(
+            owner: old,
+            turnJson: oldTurn,
+            currentAtEnqueue: old, disposedAtEnqueue: false,
+            currentNow: () => fresh,          // ★ 回调时读到的已是新会话
+            disposedNow: () => false,
+            postToFrontend: t => posted.Add(t));
+
+        Assert.False(delivered);                    // ★ 旧帧未被投递
+        Assert.Empty(posted);                       // ★ 前端一次也没被调用
+    }
+
+    [Fact]
+    public void Turn_queued_before_dispatch_is_dropped_when_host_disposed_in_between()
+    {
+        var owner = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var turn = "{\"sessionId\":\"" + owner.Id + "\"}";
+        var posted = new List<string>();
+
+        var delivered = DeliverWithGate(
+            owner: owner,
+            turnJson: turn,
+            currentAtEnqueue: owner, disposedAtEnqueue: false,
+            currentNow: () => owner,
+            disposedNow: () => true,                // ★ 回调时宿主已退出
+            postToFrontend: t => posted.Add(t));
+
+        Assert.False(delivered);
+        Assert.Empty(posted);
+    }
+
+    [Fact]
+    public void Current_owner_turn_is_delivered_normally()
+    {
+        var owner = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var turn = "{\"sessionId\":\"" + owner.Id + "\",\"state\":\"WaitInput\"}";
+        var posted = new List<string>();
+
+        var delivered = DeliverWithGate(
+            owner: owner,
+            turnJson: turn,
+            currentAtEnqueue: owner, disposedAtEnqueue: false,
+            currentNow: () => owner,                // 未换局
+            disposedNow: () => false,
+            postToFrontend: t => posted.Add(t));
+
+        Assert.True(delivered, "当前 owner 的帧必须正常投递");
+        Assert.Single(posted);
+        Assert.Equal(turn, posted[0]);
+    }
+
+    [Fact]
+    public void Old_owner_turn_with_matching_frame_id_is_still_dropped_after_switch()
+    {
+        // ★ 帧内 sessionId 与 owner 一致也**救不了**它——owner 判定优先。
+        var old = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var fresh = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var oldTurn = "{\"sessionId\":\"" + old.Id + "\"}";
+        var posted = new List<string>();
+
+        var delivered = DeliverWithGate(
+            owner: old, turnJson: oldTurn,
+            currentAtEnqueue: old, disposedAtEnqueue: false,
+            currentNow: () => fresh,
+            disposedNow: () => false,
+            postToFrontend: t => posted.Add(t));
+
+        Assert.False(delivered);
+        Assert.Empty(posted);
+    }
+
+}
