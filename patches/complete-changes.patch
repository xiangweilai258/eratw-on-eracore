@@ -0,0 +1,61 @@
+using MinorShift.Emuera.Server;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+public class MauiLoadCoordinatorTests
+{
+    [Fact]
+    public void Http_ticket_preserves_identity_and_can_only_be_consumed_once()
+    {
+        var coordinator = new MauiLoadCoordinator();
+        var ticket = coordinator.Register("game", ControlIdentity.Agent("agent-token"));
+        Assert.True(coordinator.TryConsume(ticket.RequestId, "game", out var consumed));
+        Assert.Same(ticket, consumed);
+        Assert.Equal(ControlIdentity.Agent("agent-token"), consumed!.Identity);
+        Assert.False(coordinator.TryConsume(ticket.RequestId, "game", out _));
+    }
+
+    [Fact]
+    public void Same_path_new_request_cancels_old_generation()
+    {
+        var coordinator = new MauiLoadCoordinator();
+        var old = coordinator.Register("game", ControlIdentity.Agent("old"));
+        var current = coordinator.Register("game", ControlIdentity.User);
+        Assert.True(old.CancellationToken.IsCancellationRequested);
+        Assert.False(coordinator.IsCurrent(old));
+        Assert.False(coordinator.TryConsume(old.RequestId, "game", out _));
+        Assert.True(coordinator.TryConsume(current.RequestId, "game", out _));
+    }
+
+    [Fact]
+    public void Unknown_id_or_changed_path_never_becomes_user_request()
+    {
+        var coordinator = new MauiLoadCoordinator();
+        var ticket = coordinator.Register("game", ControlIdentity.Agent("token"));
+        Assert.False(coordinator.TryConsume("unknown", "game", out _));
+        Assert.False(coordinator.TryConsume(ticket.RequestId, "another-game", out _));
+        Assert.True(coordinator.TryConsume(ticket.RequestId, "game", out _));
+    }
+
+    [Fact]
+    public void Invalidate_cancels_initialization_and_disallows_commit()
+    {
+        var coordinator = new MauiLoadCoordinator();
+        var ticket = coordinator.Register("game", ControlIdentity.User);
+        coordinator.Invalidate();
+        Assert.True(ticket.CancellationToken.IsCancellationRequested);
+        Assert.False(coordinator.TryCommit(ticket, () => throw new Xunit.Sdk.XunitException("过时代际不得提交")));
+    }
+
+    [Fact]
+    public void Current_commit_runs_once_in_same_generation()
+    {
+        var coordinator = new MauiLoadCoordinator();
+        var ticket = coordinator.Register("game", ControlIdentity.User);
+        var commits = 0;
+        Assert.True(coordinator.TryCommit(ticket, () => commits++));
+        Assert.False(coordinator.TryCommit(ticket, () => commits++));
+        Assert.Equal(1, commits);
+    }
+}
