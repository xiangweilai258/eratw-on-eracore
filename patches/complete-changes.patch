+        StopVueReadyWatchdog();
         FlushAutoLoad();
     }
 
+    // ==================== ★★★ 白屏兜底 ====================
+    // 背景：有些设备的系统 WebView 残缺（只有外壳、缺核心渲染库）⇒ Chromium 渲染子进程起不来
+    //       ⇒ 界面一片纯白，而且**前端 JS 根本没跑**（所以前端自检不可能发现，只能在这层兜）。
+    // 判据：设完 URL 后 N 秒内没收到 Vue 握手（首条 scanGames）⇒ 判定"没跑起来"。
+    // ★ 为什么用原生面板而不是网页：渲染进程死了，网页里画什么都看不见，原生控件不受影响。
+
+    /// <summary>启动"等 Vue 握手"看门狗；重复调用会先撤掉上一个。</summary>
+    private void StartVueReadyWatchdog()
+    {
+        StopVueReadyWatchdog();
+        var timer = Dispatcher.CreateTimer();
+        timer.Interval = TimeSpan.FromSeconds(VueReadyTimeoutSeconds);
+        timer.IsRepeating = false;
+        timer.Tick += (_, _) =>
+        {
+            StopVueReadyWatchdog();
+            if (_vueReady)
+                return;   // 已握手（竞态兜底）——什么都不做
+            ShowWebViewFailedPanel();
+        };
+        _readyWatchdog = timer;
+        timer.Start();
+#if ANDROID
+        Android.Util.Log.Info("EmueraMaui", $"VueReady watchdog started ({VueReadyTimeoutSeconds}s)");
+#endif
+    }
+
+    /// <summary>撤掉看门狗（已握手 / 重试时调用）。</summary>
+    private void StopVueReadyWatchdog()
+    {
+        _readyWatchdog?.Stop();
+        _readyWatchdog = null;
+    }
+
+    /// <summary>★ 显示白屏兜底面板，并把可复制的诊断信息填进去。</summary>
+    private void ShowWebViewFailedPanel()
+    {
+        WebViewFailedDetail.Text = BuildDiagnosticsLine();
+        WebViewFailedPanel.IsVisible = true;
+        Console.WriteLine("[maui] ★★ WebView 未在超时内握手 ⇒ 显示白屏兜底面板");
+#if ANDROID
+        Android.Util.Log.Warn("EmueraMaui", "Vue handshake timeout — showing WebView-failed panel");
+#endif
+    }
+
+    /// <summary>拼一行诊断信息（面板底部显示 / 复制用）。★ 不含任何隐私内容。</summary>
+    private string BuildDiagnosticsLine()
+    {
+        var parts = new List<string> { $"等握手超时 {VueReadyTimeoutSeconds}s" };
+#if ANDROID
+        try
+        {
+            // ★ 注（留痕）：曾想附上 WebView 版本（`android.webkit.WebView.getCurrentWebViewPackage`），
+            //   但 MAUI 的 WebView 类在当前绑定下没有该成员 ⇒ 编译期 CS0117。故只记型号与系统版本
+            //   —— 这两项已足够判断"是不是那类残缺 WebView 的白牌/工业机"。
+            parts.Add($"设备 {Android.OS.Build.Model} ｜ Android {Android.OS.Build.VERSION.Release}(API {(int)Android.OS.Build.VERSION.SdkInt})");
+        }
+        catch { /* 取不到就算了 —— 诊断信息不该反过来把流程搞挂 */ }
+#else
+        parts.Add($"平台 {DeviceInfo.Platform} {DeviceInfo.VersionString}");
+#endif
+        return string.Join(" ｜ ", parts);
+    }
+
+    /// <summary>「重试」——重新加载 WebView 并重启看门狗（万一是偶发）。</summary>
