+  });
+
+  it('★ C3 旧失败不得收尾新请求', () => {
+    const spy = vi.spyOn(useConnectionStore(), 'requestSnapshotRefresh')
+      .mockImplementation(() => new Promise(() => { /* 挂起 */ }));
+    try {
+      const g = useGameStore();
+      g.setSnapshot(cSnap('S1', 10, 20) as never);
+      g.requestRecovery();
+      const oldId = g.recoveryInFlight!;
+
+      g.reset();
+      g.setSnapshot(cSnap('S1', 10, 20) as never);
+      g.requestRecovery();
+      const newId = g.recoveryInFlight!;
+
+      g.failRecovery(oldId);                     // ★ 旧失败收尾
+
+      expect(g.recoveryInFlight).toBe(newId);     // 新请求不受影响
+    } finally { spy.mockRestore(); }
+  });
+});
+
+
+describe('C7 · 旧首帧先到的接管顺序（确定性）', () => {
+  beforeEach(() => setActivePinia(createPinia()));
+  afterEach(() => { vi.unstubAllGlobals(); vi.restoreAllMocks(); });
+
+  it('★★ 如实记录：前端在无身份基准时**挡不住**旧首帧（来源屏障在原生侧）', () => {
+    const g = useGameStore();
+    g.setSnapshot(cSnap('S1', 10, 20) as never);
+    g.reset();                      // 无身份基准
+
+    // ★ 若旧帧真的漏到前端，它会被登记——因为 turn 帧**不携带来源代**，
+    //   前端读"本地当前代"证明不了消息来自哪一代（我先前的承诺已在代码注释中撤回）。
+    g.applyTurn(turn(1, 2, 'S1', 'OLD', 'Quit'));
+    expect(g.activeSessionId).toBe('S1');
+
+    // ⇒ 真正的屏障是**原生侧**：BridgeHost.PostTurnForSession 用它持有的 Session
+    //   逐帧核对帧内 sessionId，旧会话的帧**在离开原生之前**即被丢弃，
+    //   前端根本收不到（见 BridgeHostSessionOrderTests）。
+    // ★ 本用例把"前端不具备来源鉴别能力"这一事实固定下来，
+    //   避免误以为前端已能鉴别而放松原生侧屏障。
+  });
+
+  it('★ 同序：S1 已建立 → reset → 直接 S2 首帧到（无旧帧）⇒ 身份为 S2', () => {
+    const g = useGameStore();
+    g.setSnapshot(cSnap('S1', 10, 20) as never);
+    g.reset();
+
+    g.applyTurn(turn(1, 2, 'S2', 'NEW'));
+    expect(g.activeSessionId).toBe('S2');
+    expect(texts(g)).toContain('NEW');
+  });
+
+  it('★ 旧会话的退出/错误帧（终态）在新会话之后不得被接纳', () => {
+    const g = useGameStore();
+    g.setSnapshot(cSnap('S2', 10, 20) as never);   // 当前是 S2
+    g.serverState = 'WaitInput';
+
+    // S1 的退出帧（旧会话）晚到
+    g.applyTurn(turn(1, 2, 'S1', 'QUIT-OLD', 'Quit'));
+
+    // ★ 顶层状态不被旧会话的 Quit 覆盖
+    expect(g.serverState).toBe('WaitInput');
+    expect(texts(g)).not.toContain('QUIT-OLD');
+  });
+});
