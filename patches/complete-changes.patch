+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import { setActivePinia, createPinia } from 'pinia';
+import { useGameStore } from '../game';
+
+/**
+ * ★★ 第二批 · F3：显示区间水位的**前端判定**。
+ *
+ * 契约（用户 2026-10-12 收紧）：不能只有一个 displaySeq 然后直接过滤——
+ *   ① 快照携带「会话身份 + 内容水位」；
+ *   ② 增量表达区间 [baseDisplaySeq, displaySeq]；
+ *   ③ 当前画面水位 == base ⇒ 相接可应用；>= displaySeq ⇒ 已包含忽略；
+ *      落在中间/缺口/身份不符 ⇒ 不猜着应用，走有界恢复。
+ *
+ * ★ 这些用例走**真实 game store**（不是复制一份逻辑自测）。
+ */
+
+/** 构造一个带水位的快照。 */
+function snap(seq: number | null, session: string | null, lines: string[] = ['Base']) {
+  return {
+    lines: lines.map((t) => ({ entries: [{ segments: [{ text: t }] }], isLineEnd: true })),
+    state: 'WaitInput',
+    inputType: null,
+    needValue: false,
+    protocolVersion: 14,
+    generation: 0,
+    displaySeq: seq,
+    sessionId: session,
+  } as never;
+}
+
+/** 构造一帧带区间水位的增量。 */
+function turn(
+  base: number | null,
+  end: number | null,
+  session: string | null,
+  appends: string[],
+  state = 'WaitInput',
+) {
+  const diff =
+    appends.length === 0
+      ? null
+      : {
+          lineOps: appends.map((t) => ({
+            type: 'append',
+            newLines: [{ entries: [{ segments: [{ text: t }] }], isLineEnd: true }],
+          })),
+          baseDisplaySeq: base,
+          displaySeq: end,
+        };
+  return JSON.stringify({
+    state,
+    inputType: null,
+    needValue: false,
+    generation: 0,
+    diff,
+    baseDisplaySeq: base,
+    displaySeq: end,
+    sessionId: session,
+  });
+}
+
+const texts = (g: ReturnType<typeof useGameStore>): string =>
+  g.displayState.lines
+    .flatMap((l) => l.entries)
+    .flatMap((e) => e.segments ?? [])
+    .map((s) => s.text ?? '')
+    .join('');
+
+describe('game store — F3 显示区间水位判定', () => {
+  beforeEach(() => setActivePinia(createPinia()));
+
+  // ① 相接 ⇒ 应用
+  it('基线相接 ⇒ 整帧应用，水位推进到终点', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(3, 'S1'));
+    g.applyTurn(turn(3, 4, 'S1', ['A']));
+
+    expect(texts(g)).toContain('A');
+    expect(g.appliedDisplaySeq).toBe(4);
+  });
+
+  // ② ★ 已包含 ⇒ 忽略（这就是 F3 要修的"重复 X"）
+  it('画面已包含该增量 ⇒ 忽略，不再重复应用', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(5, 'S1', ['Base', 'X']));
+    // 这帧的区间终点 <= 当前水位 ⇒ 已包含
+    g.applyTurn(turn(4, 5, 'S1', ['X']));
+
+    expect(g.lastWatermarkVerdict).toBe('ignored-stale');
+    // X 只出现一次
+    const t = texts(g);
+    expect(t.match(/X/g)?.length).toBe(1);
+  });
+
+  // ③ ★★ 用户要求的必测形态：快照只含 X，随后收到覆盖 X+Y 的增量
+  //     ⇒ 快照落在区间中间 ⇒ 不得整段接受（重复 X），也不得整段丢弃（丢 Y）
+  it('★ 快照只含 X，随后来一帧覆盖 X+Y ⇒ 不重复 X，也不丢后续推进', () => {
+    const g = useGameStore();
+    // 画面当前只到水位 2（只含 X）
+    g.setSnapshot(snap(2, 'S1', ['X']));
+
+    // 增量区间 [1, 3]：基线 1、终点 3 —— 当前水位 2 **落在中间**
+    g.applyTurn(turn(1, 3, 'S1', ['X', 'Y']));
+
+    expect(g.lastWatermarkVerdict).toBe('needs-recovery');
+    // 关键：X 不得被重复应用（也说明没有"整段接受"）
+    expect(texts(g).match(/X/g)?.length).toBe(1);
+    // ★★ 恢复是**有界**的：不会无限积帧 / 无限重试。
+    // ★ R1 复审后语义变更：预算由 recoveryBudget 承担（真实请求次数），
+    //   watermarkRecoveryAttempts 已不再被写入。此处断言**新的**有界判据，
+    //   真实请求的发生与次数上限由 gameRecovery.test.ts 覆盖（更强的形式）。
+    expect(g.recoveryBudget).toBeGreaterThan(0);
+    expect(g.recoveryBudget).toBeLessThanOrEqual(3);
+  });
+
+  // ④ 恢复次数到达上限后停止（防无限重试）
+  it('★ 反复落入恢复 ⇒ 计数有上限，不再无限增长', async () => {
+    // ★ R1 后恢复是**真实请求**，故这里必须给受控的失败 fetch——
+    //   否则会打到真实网络，行为不确定（这正是先前两版失败的原因）。
+    const snapshotCalls: string[] = [];
+    const fetchStub = vi.fn((url: string) => {
+      if (url.endsWith('/snapshot')) {
+        snapshotCalls.push(url);
+        return Promise.resolve(new Response('nope', { status: 500 }));  // 失败 ⇒ 明确收尾
+      }
+      if (url.endsWith('/control/wait')) return new Promise<Response>(() => { /* 长轮询挂起 */ });
+      if (url.endsWith('/session')) return Promise.resolve(new Response('', { status: 201 }));
+      return Promise.resolve(new Response(JSON.stringify({ state: 'idle', controller: null }), { status: 200 }));
+    });
+    vi.stubGlobal('fetch', fetchStub);
+
+    try {
+      const g = useGameStore();
+      g.setSnapshot(snap(2, 'S1', ['X']));
+      // ★ 每次都让微任务跑完：失败收尾要真实发生，否则后续都只是"去重"（在途未释放）
+      for (let i = 0; i < 12; i++) {
+        g.applyTurn(turn(1, 99, 'S1', ['X']));
+        for (let k = 0; k < 10; k++) await Promise.resolve();
+      }
+      // ★ 预算封顶为 3（不再无限增长）
+      expect(g.recoveryBudget).toBe(3);
+      // ★ 真实尝试次数也封顶（不是只在计数器上打转）
+      expect(snapshotCalls.length).toBeLessThanOrEqual(3);
+    } finally {
+      vi.unstubAllGlobals();
+    }
+  });
+
+  // ⑤ ★ 旧会话的迟到帧必须被拒（且顶层状态也不许倒灌）
+  it('★ 旧会话的迟到帧 ⇒ 整帧丢弃，顶层状态不倒灌', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 'S2', ['Base']));
+    g.applyTurn(turn(1, 2, 'S1', ['OLD'], 'Quit'));
+
+    expect(g.lastWatermarkVerdict).toBe('ignored-session');
+    expect(texts(g)).not.toContain('OLD');
+    // ★ 顶层 state 也不能被旧会话的 Quit 覆盖
+    expect(g.displayState.state).toBe('WaitInput');
+  });
+
+  // ⑥ 会话切换 ⇒ 旧水位作废（计数器会归零）
+  it('★ 快照换了会话 ⇒ 水位与恢复计数一并重置', () => {
+    const g = useGameStore();
