@@ -0,0 +1,184 @@
+using System.Text;
+using Android.App;
+using Android.Runtime;
+
+namespace EraCore.Maui;
+
+/// <summary>
+/// Android 端崩溃落盘。
+/// <para>
+/// <b>动机</b>：目标设备（荣耀 ROD-W09 / Android 14）使用华为 HiLog，
+/// <c>adb logcat</c> 只能读到内核与电源相关日志——应用自身、<c>ActivityTaskManager</c>
+/// 以及 <c>AndroidRuntime</c> 的输出一律不可见。崩溃时
+/// <c>ApplicationExitInfo</c> 只给出 <c>reason=4 (APP CRASH(EXCEPTION))</c> 且 <c>trace=null</c>，
+/// 拿不到任何堆栈，排障无法进行。
+/// </para>
+/// <para>
+/// 因此把未处理异常同时写到两个位置，任一可读即可取回：
+/// <list type="bullet">
+///   <item><c>/sdcard/eracore-crash.log</c>——依赖 MANAGE_EXTERNAL_STORAGE（本应用已申请并在设备上授权）</item>
+///   <item><c>/sdcard/Android/data/&lt;包名&gt;/files/eracore-crash.log</c>——应用专属外部目录，无需任何权限，adb 可直接读取</item>
+/// </list>
+/// </para>
+/// <para>
+/// <b>安装时机</b>：由 <see cref="MainApplication"/> 的静态构造函数触发，早于 <c>OnCreate</c>。
+/// 原生层崩溃（reason=5 APP CRASH(NATIVE)）与 JNI 引导阶段的失败不在覆盖范围内。
+/// </para>
+/// </summary>
+internal static class CrashLog
+{
+    private const string Tag = "EraCoreCrash";
+    private const string FileName = "eracore-crash.log";
+    private const string BootFileName = "eracore-boot.log";
+
+    private static readonly object Gate = new();
+    private static bool _installed;
+
+    /// <summary>注册全局异常钩子。重复调用无副作用。</summary>
+    internal static void Install()
+    {
+        lock (Gate)
+        {
+            if (_installed)
+                return;
+            _installed = true;
+        }
+
+        AppDomain.CurrentDomain.UnhandledException += (_, e) => Write(
+            "AppDomain.UnhandledException",
+            e.ExceptionObject as Exception,
+            e.ExceptionObject?.ToString());
+
+        TaskScheduler.UnobservedTaskException += (_, e) =>
+        {
+            Write("TaskScheduler.UnobservedTaskException", e.Exception, null);
+            e.SetObserved();
+        };
+
+        // MonoVM 未捕获异常——Android 上托管异常逃逸到 Java 层前会先走这里，是最有价值的一条。
+        AndroidEnvironment.UnhandledExceptionRaiser += (_, e) =>
+            Write("AndroidEnvironment.UnhandledExceptionRaiser", e.Exception, null);
+
+        Write("Install", null, "crash handlers installed");
+    }
+
+    /// <summary>
+    /// 开一次引导记录：清空 boot 文件并写会话头。
+    /// 与 <see cref="Mark"/> 配合，用于定位「进程静默消失、连异常都没有」的启动失败——
+    /// 在 HiLog 设备上这是唯一能看到进度的手段。
+    /// </summary>
+    internal static void BeginSession()
+    {
+        var header = new StringBuilder()
+            .Append("==== boot session ")
+            .Append(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff"))
+            .AppendLine(" ====")
+            .ToString();
+
+        foreach (var path in BootCandidatePaths())
+        {
+            try
+            {
+                File.WriteAllText(path, header);
+                return;
+            }
+            catch
+            {
+                // 换下一个落点。
+            }
+        }
+    }
+
+    /// <summary>记录一个引导步骤。自身绝不抛异常。</summary>
+    internal static void Mark(string step)
+    {
+        var line = $"[{DateTime.Now:HH:mm:ss.fff}] {step}{Environment.NewLine}";
+        foreach (var path in BootCandidatePaths())
+        {
+            try
+            {
+                File.AppendAllText(path, line);
+                return;
+            }
+            catch
+            {
+                // 换下一个落点。
+            }
+        }
+    }
+
+    /// <summary>落盘一条记录。自身绝不抛异常——否则会把原始崩溃信息盖掉。</summary>
+    internal static void Write(string source, Exception? ex, string? fallback)
+    {
+        var sb = new StringBuilder();
+        sb.Append("==== ")
+          .Append(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff"))
+          .Append(" | ")
+          .Append(source)
+          .AppendLine(" ====");
+
+        if (ex is not null)
+            sb.AppendLine(ex.ToString());
+        else if (!string.IsNullOrEmpty(fallback))
+            sb.AppendLine(fallback);
+
+        var text = sb.ToString();
+
+        try
+        {
+            Android.Util.Log.Error(Tag, text);
+        }
+        catch
+        {
+            // HiLog 设备上这条多半看不到，忽略。
+        }
+
+        foreach (var path in CandidatePaths())
+        {
+            try
+            {
+                File.AppendAllText(path, text);
+            }
+            catch
+            {
+                // 换下一个落点；全部失败则只能放弃。
+            }
+        }
+    }
+
+    private static IEnumerable<string> CandidatePaths()
+    {
+        string? externalFilesDir = null;
+        try
+        {
+            externalFilesDir = Android.App.Application.Context.GetExternalFilesDir(null)?.AbsolutePath;
+        }
+        catch
+        {
+            // Context 尚未就绪时忽略。
+        }
+
+        if (!string.IsNullOrEmpty(externalFilesDir))
+            yield return Path.Combine(externalFilesDir, FileName);
+
+        yield return "/sdcard/" + FileName;
+    }
+
+    private static IEnumerable<string> BootCandidatePaths()
+    {
+        string? externalFilesDir = null;
+        try
+        {
+            externalFilesDir = Android.App.Application.Context.GetExternalFilesDir(null)?.AbsolutePath;
+        }
+        catch
+        {
+            // Context 尚未就绪时忽略。
+        }
+
+        if (!string.IsNullOrEmpty(externalFilesDir))
+            yield return Path.Combine(externalFilesDir, BootFileName);
+
+        yield return "/sdcard/" + BootFileName;
+    }
+}
