+    [Fact]
+    public void Scope_end_releases_connections_readers_and_reader_ids()
+    {
+        EESqlRuntime.Reset();
+        using var a = new GameDir("release-a");
+        a.SeedDatabase();                            // 独立连接预置空表
+        long leakedReaderId;
+        object? leakedConn;
+        using (GlobalStatic.OpenScope(new ConfigData()))
+        {
+            EESqlRuntime.Connect("DB", "Data Source=" + a.DbPath);
+            leakedReaderId = Reader("DB", "SELECT k FROM t");
+            Assert.True(leakedReaderId > 0);
+            Assert.Equal(1, ConnCount());
+            Assert.Equal(1, ReaderCount());
+            leakedConn = SqlPool("_conns")["DB"];
+            Assert.Equal("Open", ConnState(leakedConn));
+        }
+
+        // ★ 会话作用域结束 = 生产唯一的会话级清理边界：连接与未关闭 reader 都必须被释放
+        Assert.Equal(0, ConnCount());
+        Assert.Equal(0, ReaderCount());
+        // ★ 对象级证据：不是"从字典里删掉"，而是连接本身已关闭
+        // （文件句柄可能仍被 SQLite 连接池保留 —— 那不是本缺陷的判据，见类注释）
+        Assert.Equal("Closed", ConnState(leakedConn));
+        // ★ 措辞边界：此处只证明“该编号在池中不复可用”，不证明编号永不复用
+        Assert.False(EESqlRuntime.ReaderRead(leakedReaderId), "该 reader 编号在清空后不得仍可读");
+
+        // 重复清理安全（幂等，不抛）
+        EESqlRuntime.Reset();
+        EESqlRuntime.Reset();
+        Assert.Equal(0, ConnCount());
+        Assert.Equal(0, ReaderCount());
+    }
+
+    /// <summary>
+    /// ★ Reset 的健壮性：多个 reader 同时打开（<c>OpenReader</c> 走**主连接** ⇒ 多条 reader 项
+    /// 持有同一个连接对象）。清理时同一连接会被重复 Dispose，且第二次读 <c>Conn.DataSource</c>
+    /// 时该连接已 Dispose —— 必须不抛、且不能因为这一项而漏清后面的连接。
+    /// </summary>
+    [Fact]
+    public void Reset_tolerates_multiple_readers_sharing_one_connection_and_clears_all()
+    {
+        EESqlRuntime.Reset();
+        using var a = new GameDir("multi-reader-a");
+        using var b = new GameDir("multi-reader-b");
+        a.SeedDatabase();
+        b.SeedDatabase();
+        long r1, r2;
+        using (GlobalStatic.OpenScope(new ConfigData()))
+        {
+            EESqlRuntime.Connect("DB", "Data Source=" + a.DbPath);
+            r1 = Reader("DB", "SELECT k FROM t");
+            r2 = Reader("DB", "SELECT k FROM t");
+            Assert.True(r1 > 0 && r2 > 0);
+            Assert.Equal(1, ConnCount());     // 同一连接名
+            Assert.Equal(2, ReaderCount());   // 两条 reader 项共享它
+
+            // 再挂一个独立连接，用来验证“前面的项出问题不会漏清后面的”
+            EESqlRuntime.Connect("OTHER", "Data Source=" + b.DbPath);
+            Assert.Equal(2, ConnCount());
+        }
+
+        Assert.Equal(0, ConnCount());
+        Assert.Equal(0, ReaderCount());
+        Assert.False(EESqlRuntime.ReaderRead(r1));
+        Assert.False(EESqlRuntime.ReaderRead(r2));
+    }
