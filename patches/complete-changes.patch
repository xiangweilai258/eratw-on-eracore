+/// <summary>
+/// ★★ C7（第二批复审）：**原生侧 turn 投递门**——决定某一帧是否允许离开原生去调用前端。
+///
+/// <para><b>为什么门必须在原生侧</b>：前端 <c>applyTurn</c> 读的是"本地当前代"，
+/// 而 turn 帧<b>本身不携带来源代</b> ⇒ 读到当前代只能证明"此刻是第几代"，
+/// <b>证明不了这条消息来自哪一代</b>。因此来源判别必须落在持有会话身份的原生侧。</para>
+///
+/// <para><b>判定规则</b>（用户 2026-10-13 确认，全部满足才放行）：
+/// <list type="number">
+/// <item><b>owner 仍是宿主当前会话</b>——首要判据；换局后旧 owner 一律丢弃。</item>
+/// <item><b>宿主未退出</b>（<c>hostDisposed == false</c>）。</item>
+/// <item>帧内 <c>sessionId</c> <b>存在时</b>必须与 <c>owner.Id</c> 一致（辅助核验）。</item>
+/// </list>
+/// ★ <b>缺字段不是绕过通路</b>：1、2 任一不满足就丢弃，<b>与帧内有没有 sessionId 无关</b>。
+///   帧内 sessionId 缺失时，仍须通过 1、2 才能放行。</para>
+///
+/// <para><b>纯函数</b>：无 IO、无锁、不读时钟；便于确定性测试直接覆盖本规则。</para>
+/// </summary>
+internal static class SessionTurnGate
+{
+    /// <summary>判定结果（放行 / 丢弃 + 原因，便于留痕与测试断言）。</summary>
+    internal readonly record struct Decision(bool Allow, string? Reason)
+    {
+        internal static Decision Pass(string? reason = null) => new(true, reason);
+        internal static Decision Deny(string reason) => new(false, reason);
+    }
+
+    /// <summary>
+    /// 核心判定。<b>生产与测试走同一份逻辑</b>（不另写一份）。
+    /// </summary>
+    /// <param name="owner">投递泵在**捕获时**持有的会话（可能是旧局）。</param>
+    /// <param name="currentSession">宿主**此刻**的当前会话（可为 null = 已无会话）。</param>
+    /// <param name="hostDisposed">宿主此刻是否已退出。</param>
+    /// <param name="frameSessionId">帧内 sessionId；<b>null = 字段缺失或不可解析</b>（不得据此放行旧 owner）。</param>
+    internal static Decision Evaluate(
+        Session? owner,
+        Session? currentSession,
+        bool hostDisposed,
+        string? frameSessionId)
+    {
+        // ② 宿主已退出 ⇒ 一律丢弃（与帧内字段无关）
+        if (hostDisposed)
+            return Decision.Deny("宿主已退出");
+        // ① owner 必须仍是宿主当前会话——换局后旧 owner 一律丢弃
+        if (owner == null)
+            return Decision.Deny("无捕获 owner");
+        if (!ReferenceEquals(owner, currentSession))
+            return Decision.Deny("owner 已是旧会话");
+        // ③ 帧内 sessionId 存在时必须一致（**辅助**核验；缺失不放行规则，只是不做这一项）
+        if (frameSessionId != null && !string.Equals(frameSessionId, owner.Id, StringComparison.Ordinal))
+            return Decision.Deny("帧 sessionId 与 owner 不一致");
+        // ★ 走到这里说明 1、2 均已通过；帧内字段缺失**不构成**绕过。
+        return Decision.Pass(frameSessionId == null ? "帧无 sessionId，但 owner 仍有效" : null);
+    }
+
+    /// <summary>
+    /// 尽力从 turn JSON 读出 <c>sessionId</c>；解析失败或字段缺失返回 <b>null</b>。
+    /// ★ 解析失败<b>不放行</b>——放行与否仍由 <see cref="Evaluate"/> 的 owner 判据决定。
+    /// </summary>
+    internal static string? TryReadFrameSessionId(string turnJson)
+    {
+        try
+        {
+            using var doc = System.Text.Json.JsonDocument.Parse(turnJson);
+            return doc.RootElement.TryGetProperty("sessionId", out var s) && s.ValueKind == System.Text.Json.JsonValueKind.String
+                ? s.GetString()
+                : null;
+        }
+        catch (System.Text.Json.JsonException)
+        {
+            return null;
+        }
+    }
+}
