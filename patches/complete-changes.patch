diff --git a/EraCore.Core/Shared/Runtime/Utils/EESqlRuntime.cs b/EraCore.Core/Shared/Runtime/Utils/EESqlRuntime.cs
new file mode 100644
index 00000000..94a6144d
--- /dev/null
+++ b/EraCore.Core/Shared/Runtime/Utils/EESqlRuntime.cs
@@ -0,0 +1,351 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Xml;
+using Microsoft.Data.Sqlite;
+
+namespace MinorShift.Emuera.GameData.Function;
+
+/// <summary>
+/// EE v56 SQL 运行时（eraTW 画蛇添足版 qol 数据库支持）。
+/// SQL_CONNECT / SQL_EXECUTE_* / SQL_READER_* / SQL_IMPORT_MAP_XML 的真实现。
+/// - 命名连接池（QOL_DISH_DB / TR_DB / GRAPH_DB ...）
+/// - reader 用独立连接（避免同连接多活动 reader 冲突）；内存库 reader 走主连接
+/// - 相对 Data Source 相对游戏目录（Program.ExeDir）解析
+/// </summary>
+internal static class EESqlRuntime
+{
+    private sealed class ReaderEntry
+    {
+        public SqliteConnection Conn = null!;
+        public SqliteCommand Cmd = null!;
+        public SqliteDataReader Reader = null!;
+    }
+
+    private static readonly Dictionary<string, SqliteConnection> _conns = new(StringComparer.OrdinalIgnoreCase);
+    private static readonly Dictionary<long, ReaderEntry> _readers = new();
+    private static long _nextRid = 1;
+
+    private static string NormalizeDataSource(string? connStr)
+    {
+        if (string.IsNullOrWhiteSpace(connStr))
+            return ":memory:";
+        string? ds;
+        try
+        {
+            var b = new SqliteConnectionStringBuilder(connStr);
+            ds = b.DataSource;
+        }
+        catch
+        {
+            // 直接给路径/相对路径时
+            ds = connStr.Trim();
+            int eq = ds.IndexOf('=');
+            if (eq > 0 && ds.Substring(0, eq).Trim().Equals("Data Source", StringComparison.OrdinalIgnoreCase))
+                ds = ds.Substring(eq + 1).Trim();
+        }
+        if (string.IsNullOrWhiteSpace(ds) || ds.StartsWith(":memory:", StringComparison.OrdinalIgnoreCase))
+            return ds;
+        ds = ds.Replace('\\', '/');
+        if (!Path.IsPathRooted(ds))
+        {
+            string exe = string.IsNullOrEmpty(Program.ExeDir) ? Directory.GetCurrentDirectory() : Program.ExeDir;
+            ds = Path.Combine(exe, ds);
+        }
+        string? dir = Path.GetDirectoryName(ds);
+        if (!string.IsNullOrEmpty(dir))
+        {
+            try { Directory.CreateDirectory(dir); } catch { }
+        }
+        return ds;
+    }
+
+    private static SqliteConnection GetConn(string name, string? connStr)
+    {
+        if (_conns.TryGetValue(name, out var exist))
+            return exist;
+        string? ds = NormalizeDataSource(connStr);
+        string full = ds.StartsWith(":memory:", StringComparison.OrdinalIgnoreCase)
+            ? "Data Source=:memory:"
+            : "Data Source=" + ds;
+        var conn = new SqliteConnection(full);
+        conn.Open();
+        _conns[name] = conn;
+        return conn;
+    }
+
+    /// <summary>SQL_CONNECT name[, connStr]</summary>
+    public static long Connect(string name, string? connStr)
+    {
+        var conn = GetConn(name, connStr);
+        LogOp("connect", $"name={name}  connStr={connStr ?? "(null)"}  → DataSource={conn.DataSource}");
+        return 0;
+    }
+
+    /// <summary>
+    /// 诊断探针：记录关键 SQL 操作到 sql-connect.log（连接 / XML 导入 / 写操作）。
+    /// 用途：确认 eraTW 的 qol 数据库与翻译库导入是否真的执行过 ——
+    /// 「没报错」不足以证明「执行过」，必须有正向证据。
+    /// </summary>
+    private static void LogOp(string op, string detail)
+    {
+        try
+        {
+            System.IO.File.AppendAllText(
+                System.IO.Path.Combine(AppContext.BaseDirectory, "sql-connect.log"),
+                $"[{op}] {detail}\n");
+        }
+        catch { }
+    }
+
+    private static SqliteCommand Build(SqliteConnection conn, string sql, object[]? ps)
+    {
+        var cmd = conn.CreateCommand();
+        cmd.CommandText = sql;
+        if (ps != null)
+        {
+            for (int i = 0; i < ps.Length; i++)
+            {
+                if (ps[i] == null) continue;
+                cmd.Parameters.AddWithValue("@" + i, ps[i]);
+            }
+        }
+        return cmd;
+    }
+
+    /// <summary>SQL_(P_)EXECUTE_NONQUERY(db, sql[, p...])</summary>
+    public static long ExecNonQuery(string db, string sql, object[]? ps)
+    {
+        try
+        {
+            var conn = GetConn(db, null);
+            using var cmd = Build(conn, sql, ps);
+            return cmd.ExecuteNonQuery();
+        }
+        catch (Exception ex)
+        {
+            TryDebug("NONQUERY", db, sql, ex);
+            return 0;
+        }
+    }
+
+    public static long ExecScalarLong(string db, string sql, object[]? ps)
+    {
+        try
+        {
+            var conn = GetConn(db, null);
+            using var cmd = Build(conn, sql, ps);
+            object? r = cmd.ExecuteScalar();
+            return r == null || r is DBNull ? 0 : Convert.ToInt64(r);
+        }
+        catch (Exception ex)
+        {
+            TryDebug("SCALAR_LONG", db, sql, ex);
+            return 0;
+        }
+    }
+
+    public static string ExecScalarString(string db, string sql, object[]? ps)
+    {
+        try
+        {
+            var conn = GetConn(db, null);
+            using var cmd = Build(conn, sql, ps);
+            object? r = cmd.ExecuteScalar();
+            return r == null || r is DBNull ? "" : (Convert.ToString(r) ?? "");
+        }
+        catch (Exception ex)
+        {
+            TryDebug("SCALAR_STR", db, sql, ex);
+            return "";
+        }
+    }
+
+    /// <summary>SQL_(P_)EXECUTE_READER → reader id（走主连接：能看到事务内未提交数据）</summary>
+    public static long OpenReader(string db, string sql, object[]? ps)
+    {
+        try
+        {
+            var conn = GetConn(db, null); // 主连接：GRAPH_DB_REBUILD 事务内可见
+            var cmd = Build(conn, sql, ps);
+            var reader = cmd.ExecuteReader();
+            long id = _nextRid++;
+            _readers[id] = new ReaderEntry { Conn = conn, Cmd = cmd, Reader = reader };
+            return id;
+        }
+        catch (Exception ex)
+        {
+            TryDebug("OPEN_READER", db, sql, ex);
+            return 0;
+        }
+    }
+
+    public static bool ReaderRead(long id)
+    {
+        try
+        {
+            if (!_readers.TryGetValue(id, out var e)) return false;
+            return e.Reader.Read();
+        }
+        catch { return false; }
+    }
+
+    public static long ReaderGetLong(long id, int col)
+    {
+        try
+        {
+            if (!_readers.TryGetValue(id, out var e)) return 0;
+            object v = e.Reader.GetValue(col);
+            return v == null || v is DBNull ? 0 : Convert.ToInt64(v);
+        }
+        catch { return 0; }
+    }
+
+    public static string ReaderGetString(long id, int col)
+    {
+        try
+        {
+            if (!_readers.TryGetValue(id, out var e)) return "";
+            object v = e.Reader.GetValue(col);
+            return v == null || v is DBNull ? "" : (Convert.ToString(v) ?? "");
+        }
+        catch { return ""; }
+    }
+
+    public static bool ReaderIsNull(long id, int col)
+    {
+        try
+        {
+            if (!_readers.TryGetValue(id, out var e)) return true;
+            return e.Reader.IsDBNull(col);
+        }
+        catch { return true; }
+    }
+
+    public static void ReaderClose(long id)
+    {
+        try
+        {
+            if (!_readers.TryGetValue(id, out var e)) return;
+            _readers.Remove(id);
+            e.Reader.Dispose();
+            e.Cmd.Dispose();
+            // 主连接复用，不在此关闭
+        }
+        catch { }
+    }
+
+    /// <summary>
+    /// SQL_IMPORT_MAP_XML(db, table, xmlPath)：从 &lt;map&gt;&lt;p&gt;&lt;k&gt;..&lt;/k&gt;&lt;v&gt;..&lt;/v&gt;&lt;/p&gt; 导入 k/v 到表。
+    /// </summary>
+    public static long ImportMapXml(string db, string table, string xmlPath)
+    {
+        try
+        {
+            string full = xmlPath;
+            if (!Path.IsPathRooted(full))
+            {
+                string exe = string.IsNullOrEmpty(Program.ExeDir) ? Directory.GetCurrentDirectory() : Program.ExeDir;
+                full = Path.Combine(exe, full);
+            }
+            if (!File.Exists(full))
+            {
+                TryDebug("IMPORT_XML", db, xmlPath, new FileNotFoundException(full));
+                LogOp("import-map-xml", $"db={db} table={table} xml={xmlPath} → 文件不存在");
+                return 0;
+            }
+            var conn = GetConn(db, null);
+            using (var cmd = conn.CreateCommand())
+            {
+                cmd.CommandText = "CREATE TABLE IF NOT EXISTS [" + table + "] (k TEXT PRIMARY KEY, v TEXT)";
+                cmd.ExecuteNonQuery();
+            }
+            using (var tx = conn.BeginTransaction())
+            {
+                using var ins = conn.CreateCommand();
+                ins.Transaction = tx;
+                ins.CommandText = "INSERT OR REPLACE INTO [" + table + "] (k, v) VALUES (@k, @v)";
+                var pk = ins.CreateParameter(); pk.ParameterName = "@k";
+                var pv = ins.CreateParameter(); pv.ParameterName = "@v";
+                ins.Parameters.Add(pk); ins.Parameters.Add(pv);
+
+                using var xr = XmlReader.Create(full, new XmlReaderSettings { DtdProcessing = DtdProcessing.Ignore });
+                string? k = null, v = null;
+                bool inK = false, inV = false;
+                while (xr.Read())
+                {
+                    if (xr.NodeType != XmlNodeType.Element && xr.NodeType != XmlNodeType.Text && xr.NodeType != XmlNodeType.EndElement)
+                        continue;
+                    if (xr.NodeType == XmlNodeType.Element)
+                    {
+                        if (xr.Name == "k") inK = true;
+                        else if (xr.Name == "v") inV = true;
+                        continue;
+                    }
+                    if (xr.NodeType == XmlNodeType.Text)
+                    {
+                        if (inK) k = (k ?? "") + xr.Value;
+                        else if (inV) v = (v ?? "") + xr.Value;
+                        continue;
+                    }
+                    if (xr.NodeType == XmlNodeType.EndElement)
+                    {
+                        if (xr.Name == "k") inK = false;
+                        else if (xr.Name == "v") inV = false;
+                        else if (xr.Name == "p")
+                        {
+                            if (k != null)
+                            {
+                                pk.Value = k;
+                                pv.Value = v ?? "";
+                                ins.ExecuteNonQuery();
+                            }
+                            k = null; v = null;
+                        }
+                    }
+                }
+                tx.Commit();
+            }
+            LogOp("import-map-xml", $"db={db} table={table} xml={xmlPath} → 导入成功");
+            return 1;
+        }
+        catch (Exception ex)
+        {
+            TryDebug("IMPORT_XML", db, xmlPath, ex);
+            LogOp("import-map-xml", $"db={db} table={table} xml={xmlPath} → 失败: {ex.Message}");
+            return 0;
+        }
+    }
+
+    /// <summary>重置（换游戏/重启会话时调用）</summary>
+    public static void Reset()
+    {
+        foreach (var r in _readers.Values)
+        {
+            try { r.Reader.Dispose(); } catch { }
+            try { r.Cmd.Dispose(); } catch { }
+            if (r.Conn.DataSource != ":memory:")
+            {
+                try { r.Conn.Dispose(); } catch { }
+            }
+        }
+        _readers.Clear();
+        foreach (var c in _conns.Values)
+        {
+            try { c.Dispose(); } catch { }
+        }
+        _conns.Clear();
+        _nextRid = 1;
+    }
+
+    private static void TryDebug(string op, string db, string sql, Exception ex)
+    {
+        try
+        {
+            System.IO.File.AppendAllText(
+                System.IO.Path.Combine(AppContext.BaseDirectory, "sql-debug.log"),
+                $"[{op}] db={db}\n  sql: {sql}\n  {ex.Message}\n\n");
+        }
+        catch { }
+    }
+}
