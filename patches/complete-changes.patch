+        using var a = new GameDir("guard-a");
+        using var b = new GameDir("guard-b");
+        a.SeedDatabase(("marker", "A_VALUE"));
+        b.SeedDatabase(("marker", "B_VALUE"));
+        var registry = CreateRegistry();
+        var session = InstallSession(registry);
+        var ready = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var release = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        // 受控旧循环：在真实会话作用域内执行真实 SQL，然后停住（会话保持活跃）
+        var loop = Task.Run(() =>
+        {
+            using (GlobalStatic.OpenScope(new ConfigData()))
+            {
+                EESqlRuntime.Connect("DB", "Data Source=" + a.DbPath);
+                NonQuery("DB", "INSERT OR REPLACE INTO t (k,v) VALUES ('wrote','A_WROTE')");
+                ready.TrySetResult();
+                release.Task.GetAwaiter().GetResult();
+            }
+        });
+        Field(typeof(Session), "_gameTask").SetValue(session, loop);
+        try
+        {
+            await ready.Task.WaitAsync(TimeSpan.FromSeconds(10));
+            Assert.Equal(1, ConnCount());
+
+            // ① 无效候选目录：在旧局停止前就失败 ⇒ 旧会话与它的 SQL 资源都不能被提前清理
+            var pathError = await registry.ReplaceForLoadGameAsync(
+                Path.Combine(a.Root, "missing"), ControlIdentity.User);
+            Assert.Equal(LoadGameStatus.PathError, pathError.Status);
+            Assert.Same(session, registry.CurrentSession);
+            Assert.Equal(1, ConnCount());
+            // 活跃会话的连接必须仍可用（经被测路径读取，这正是被观测行为）
+            Assert.Equal("A_VALUE", Scalar("DB", "SELECT v FROM t WHERE k='marker'"));
+            // 独立复核：库内容未被清理动作破坏
+            Assert.Equal("A_VALUE", ReadIndependent(a.DbPath, "marker"));
+            Assert.Equal("A_WROTE", ReadIndependent(a.DbPath, "wrote"));
+
+            // ② 取消：请求在提交前取消 ⇒ 不得误清有效会话的 SQL 资源
+            using var cancel = new CancellationTokenSource();
+            cancel.Cancel();
+            var cancelled = await registry.ExecuteMauiLoadAsync(
+                GamePaths.Prepare(b.Root, new FileSystemGameDirAccessor()), ControlIdentity.User, session,
+                () => throw new InvalidOperationException("must not initialize"), cancel.Token);
+            Assert.Equal(MauiLoadStatus.Cancelled, cancelled.Status);
+            Assert.Same(session, registry.CurrentSession);
+            Assert.Equal(1, ConnCount());
+            Assert.Equal("A_VALUE", Scalar("DB", "SELECT v FROM t WHERE k='marker'"));
+            // b 库不应被这次取消的换局触碰
+            Assert.Equal("B_VALUE", ReadIndependent(b.DbPath, "marker"));
+            Assert.Null(ReadIndependentOrNull(b.DbPath, "wrote"));
+        }
+        finally
+        {
+            release.TrySetResult();
+            await loop.WaitAsync(TimeSpan.FromSeconds(10));
+            registry.DisposeAll();
+            EESqlRuntime.Reset();
+        }
+    }
+
+    [Fact]
+    public async Task Stopped_session_then_failed_start_still_releases_and_next_connect_is_isolated()
+    {
+        EESqlRuntime.Reset();
+        using var a = new GameDir("fail-a");
+        using var b = new GameDir("fail-b");
+        a.SeedDatabase(("marker", "A_VALUE"));
+        b.SeedDatabase(("marker", "B_VALUE"));
+        var registry = CreateRegistry();
+        var session = InstallSession(registry);
+        var ready = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var release = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var loop = Task.Run(() =>
+        {
+            using (GlobalStatic.OpenScope(new ConfigData()))
+            {
+                EESqlRuntime.Connect("DB", "Data Source=" + a.DbPath);
+                NonQuery("DB", "INSERT OR REPLACE INTO t (k,v) VALUES ('wrote','A_WROTE')");
+                ready.TrySetResult();
+                release.Task.GetAwaiter().GetResult();
+            }
+        });
+        Field(typeof(Session), "_gameTask").SetValue(session, loop);
+        try
+        {
+            await ready.Task.WaitAsync(TimeSpan.FromSeconds(10));
+            release.TrySetResult();
+            await loop.WaitAsync(TimeSpan.FromSeconds(10));   // 旧局已停止（含作用域退出）
+
+            // 旧局已停止、新局启动失败：旧资源仍必须已被释放
+            var failed = await registry.ExecuteMauiLoadAsync(
+                GamePaths.Prepare(b.Root, new FileSystemGameDirAccessor()), ControlIdentity.User,
+                () => throw new InvalidOperationException("controlled-initializer-failure"));
+            Assert.Equal(MauiLoadStatus.LoadFailed, failed.Status);
+            Assert.Equal(0, ConnCount());                      // ★ 旧会话的连接不得残留
+            Assert.Equal(0, ReaderCount());
+
+            // 下一次启动不串库：同名连接指向新目录时读到的是**新目录自己的**标记
+            using (GlobalStatic.OpenScope(new ConfigData()))
+            {
+                EESqlRuntime.Connect("DB", "Data Source=" + b.DbPath);
+                Assert.Equal("B_VALUE", Scalar("DB", "SELECT v FROM t WHERE k='marker'"));
+            }
+            // 独立复核：旧库内容保持，新库未被旧会话写入
+            Assert.Equal("A_VALUE", ReadIndependent(a.DbPath, "marker"));
+            Assert.Equal("A_WROTE", ReadIndependent(a.DbPath, "wrote"));
+            Assert.Null(ReadIndependentOrNull(b.DbPath, "wrote"));
+        }
+        finally
+        {
+            release.TrySetResult();
+            registry.DisposeAll();
+            EESqlRuntime.Reset();
+        }
+    }
+
+    /// <summary>
+    /// 有界等待一个确定性终态（夹具 ERB 以 QUIT 收尾 ⇒ HasEnded 必然到达）。
+    /// 轮询的是终态、不是碰运气的时间窗。
+    /// 注意：HasEnded 只说明游戏循环已收尾，作用域释放由随后 <c>Dispose</c>/<c>join</c> 保证。
+    /// </summary>
+    private static async Task WaitEndedAsync(Session? session)
+    {
+        var deadline = DateTime.UtcNow.AddSeconds(20);
+        while (session is { HasEnded: false } && DateTime.UtcNow < deadline)
+            await Task.Delay(25);
+        Assert.True(
+            session?.HasEnded == true,
+            "夹具会话应在时限内自然结束（ERB 以 QUIT 收尾）；"
+            + "实际 State=" + (session?.StateString ?? "(null)")
+            + " HasEnded=" + (session?.HasEnded.ToString() ?? "(null)")
+            + " LastError=" + (session?.LastError ?? "(null)"));
+    }
+}
