+// @vitest-environment happy-dom
+import { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';
+import { mount, flushPromises } from '@vue/test-utils';
+import { setActivePinia, createPinia } from 'pinia';
+import App from '../../App.vue';
+import { useGameStore } from '../../stores/game';
+
+/**
+ * F4（2026-10-13）：HTTP 退出反馈的 UI 行为测试——
+ * 证明用户**能看到**失败提示、**能使用**「重试停止」与「仅离开页面」，
+ * 不是只测 store 却宣称按钮已验证。
+ *
+ * 仅 HTTP 模式（isMauiEnvironment mocked false）呈现；MAUI 路径不在本轮范围。
+ */
+
+vi.mock('../../composables/useAppInit', () => ({ initAppState: vi.fn() }));
+vi.mock('../../composables/useGameStatusMonitor', () => ({
+  startGameStatusMonitor: vi.fn(),
+}));
+vi.mock('../../lib/mauiBridge', () => ({
+  isMauiEnvironment: vi.fn(() => false),
+  isAndroidMauiEnvironment: vi.fn(() => false),
+  loadGameFromPath: vi.fn(),
+  exitGame: vi.fn(),
+  setOrientationLock: vi.fn(),
+}));
+// WebGameList 等产品组件会读取该模块的其他导出 → 部分展开真实模块，只覆盖平台判定
+vi.mock('../../lib/gameLibrary', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../../lib/gameLibrary')>()),
+  isAndroidMauiEnvironment: vi.fn(() => false),
+}));
+
+function makeLocalStorage(): Storage {
+  const map = new Map<string, string>();
+  return {
+    getItem: (k: string) => (map.has(k) ? map.get(k)! : null),
+    setItem: (k: string, v: string) => {
+      map.set(k, v);
+    },
+    removeItem: (k: string) => {
+      map.delete(k);
+    },
+    clear: () => {
+      map.clear();
+    },
+    key: (i: number) => Array.from(map.keys())[i] ?? null,
+    get length() {
+      return map.size;
+    },
+  };
+}
+
+function jsonResponse(status: number, body: unknown): Response {
+  return {
+    status,
+    ok: status >= 200 && status < 300,
+    json: async () => body,
+    text: async () => JSON.stringify(body),
+  } as unknown as Response;
+}
+
+/** 挂载 App（HTTP 模式），预置"游戏中"状态。 */
+async function mountAppWithActiveGame(fetchMock: ReturnType<typeof vi.fn>) {
+  setActivePinia(createPinia());
+  vi.stubGlobal('localStorage', makeLocalStorage());
+  vi.stubGlobal('fetch', fetchMock);
+  const game = useGameStore();
+  game.setGameDir('D:/emuera/g1');
+  game.applyServerState('WaitInput');
+  game.setMainGameDir('D:/emuera');
+  const wrapper = mount(App);
+  await flushPromises();
+  return { wrapper, game };
+}
+
+describe('App · F4 HTTP 退出反馈 UI', () => {
+  let fetchMock: ReturnType<typeof vi.fn>;
+
+  beforeEach(() => {
+    fetchMock = vi.fn();
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+  });
+
+  it('409 后：用户能看到权限拒绝提示与「重试停止」「仅离开页面」按钮', async () => {
+    fetchMock.mockResolvedValueOnce(jsonResponse(409, { error: { code: 'CONTROL_NOT_CONTROLLER' } }));
+    const { wrapper, game } = await mountAppWithActiveGame(fetchMock);
+
+    await game.exitGameHttp();
+    await flushPromises();
+
+    const bar = wrapper.find('[data-testid="exit-feedback"]');
+    expect(bar.exists()).toBe(true);
+    expect(bar.text()).toContain('退出被拒绝，当前没有所需控制权限。');
+    expect(wrapper.find('[data-testid="exit-retry"]').exists()).toBe(true);
+    expect(wrapper.find('[data-testid="exit-abandon"]').exists()).toBe(true);
+    // 游戏状态未被清
+    expect(game.gameDir).toBe('D:/emuera/g1');
+    wrapper.unmount();
+  });
+
+  it('未确认结果：提示文案为「尚未确认游戏停止，后台可能仍在运行。」', async () => {
+    fetchMock.mockRejectedValueOnce(new TypeError('Failed to fetch'));
+    const { wrapper, game } = await mountAppWithActiveGame(fetchMock);
+
+    await game.exitGameHttp();
+    await flushPromises();
+
+    expect(wrapper.find('[data-testid="exit-feedback"]').text()).toContain(
+      '尚未确认游戏停止，后台可能仍在运行。',
+    );
+    wrapper.unmount();
+  });
+
+  it('点「重试停止」→ 第二次 DELETE 成功 → 提示消失、回到列表态', async () => {
+    fetchMock
+      .mockResolvedValueOnce(jsonResponse(409, { error: { code: 'CONTROL_NOT_CONTROLLER' } }))
+      .mockResolvedValueOnce(jsonResponse(200, { removed: true }))
+      .mockResolvedValueOnce(
+        jsonResponse(200, { rootDir: 'D:/emuera', rootDirExists: true, games: [] }),
+      );
+    const { wrapper, game } = await mountAppWithActiveGame(fetchMock);
+
+    await game.exitGameHttp();
+    await flushPromises();
+    expect(wrapper.find('[data-testid="exit-feedback"]').exists()).toBe(true);
+
+    await wrapper.find('[data-testid="exit-retry"]').trigger('click');
+    await flushPromises();
+
+    // DELETE 恰好两次（409 一次 + 重试成功一次）
+    const deleteCalls = fetchMock.mock.calls.filter((c) => c[1]?.method === 'DELETE');
+    expect(deleteCalls.length).toBe(2);
+    expect(game.gameDir).toBeNull();
+    // 回到列表态（Transition out-in 切换需要等动画帧，用 waitFor 轮询）
+    await vi.waitFor(() => {
+      expect(wrapper.findComponent({ name: 'WebGameList' }).exists()).toBe(true);
+    });
+    // 提示消失
+    expect(wrapper.find('[data-testid="exit-feedback"]').exists()).toBe(false);
+    wrapper.unmount();
+  });
+
+  it('点「仅离开页面」→ 不再发 DELETE、回列表态、未确认提示保留', async () => {
+    fetchMock.mockResolvedValueOnce(jsonResponse(409, { error: { code: 'CONTROL_NOT_CONTROLLER' } }));
+    const { wrapper, game } = await mountAppWithActiveGame(fetchMock);
+
+    await game.exitGameHttp();
+    await flushPromises();
+
+    await wrapper.find('[data-testid="exit-abandon"]').trigger('click');
+    await flushPromises();
+
+    // 不再发 DELETE（列表页挂载可能有自己的请求，故按 DELETE 计数断言）
+    const deleteCallsAfter = fetchMock.mock.calls.filter((c) => c[1]?.method === 'DELETE');
+    expect(deleteCallsAfter.length).toBe(1); // 只有最初那次 409 的 DELETE
+    expect(game.gameDir).toBeNull(); // 本地视图已清
+    // 回到列表态（等 Transition 切换完成）
+    await vi.waitFor(() => {
+      expect(wrapper.findComponent({ name: 'WebGameList' }).exists()).toBe(true);
+    });
+    // 未确认提示保留
+    const bar = wrapper.find('[data-testid="exit-feedback"]');
+    expect(bar.exists()).toBe(true);
+    expect(bar.text()).toContain('退出被拒绝，当前没有所需控制权限。');
+    wrapper.unmount();
+  });
+
+  it('提示可手动关闭', async () => {
+    fetchMock.mockResolvedValueOnce(jsonResponse(409, { error: { code: 'CONTROL_NOT_CONTROLLER' } }));
+    const { wrapper, game } = await mountAppWithActiveGame(fetchMock);
+
+    await game.exitGameHttp();
+    await flushPromises();
+    expect(wrapper.find('[data-testid="exit-feedback"]').exists()).toBe(true);
+
+    await wrapper.find('[data-testid="exit-feedback-close"]').trigger('click');
+    await flushPromises();
+    expect(game.exitFeedback).toBeNull();
+    expect(wrapper.find('[data-testid="exit-feedback"]').exists()).toBe(false);
+    wrapper.unmount();
+  });
+
+  it('MAUI 模式不渲染退出反馈条（本轮仅 HTTP 路径）', async () => {
+    const { isMauiEnvironment } = await import('../../lib/mauiBridge');
+    (isMauiEnvironment as ReturnType<typeof vi.fn>).mockReturnValue(true);
+    fetchMock.mockResolvedValueOnce(jsonResponse(409, { error: { code: 'X' } }));
+    const { wrapper, game } = await mountAppWithActiveGame(fetchMock);
+
+    // MAUI 路径走 beginExitGame（无 exitFeedback 写入）；即便有人写了 feedback 也不显示
+    game.beginExitGame();
+    await flushPromises();
+
+    expect(wrapper.find('[data-testid="exit-feedback"]').exists()).toBe(false);
+    wrapper.unmount();
+  });
+});
