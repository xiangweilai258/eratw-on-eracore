+import { describe, it, expect, beforeEach } from 'vitest';
+import { setActivePinia, createPinia } from 'pinia';
+import { useGameStore } from '../game';
+import type { DisplayLine, PrintSegment } from '../../types/protocol';
+
+/**
+ * `needsTextInput` 单测——回答「★ 此刻需要用户打字吗」。
+ *
+ * 触发场景：`App.vue` 用它给键盘按钮亮灯，`TerminalView.vue` 用它决定输入栏显隐。
+ *
+ * ★ 判据（2026-10-07 经 Windows 实机验证后定稿）：
+ *   ① `state === 'WaitInput'`
+ *   ② `needValue === true` —— 协议说本回合需要一个值
+ *   ③ `!hasActiveButtons` —— 画面上**没有**本回合可点的按钮
+ * 三个条件同时成立才为 true。
+ *
+ * ★★ 教训留痕（**首版判据只按 `inputType` 枚举，被 Windows 实机推翻**）：
+ * eraTW **标题画面**就是 `inputType=IntValue` + `needValue=true`，而屏上的
+ * `[0] 开始游戏 / [1] 继续游戏 / [2] DEMO` **本身就是本回合按钮**——点它们即完成输入。
+ * 只看 `inputType` 会让键盘灯在标题画面就常亮（实测截图确认），提示随之失去意义。
+ * ⇒ 「画面上有没有可点的按钮」这个问题**本来就只能从渲染层回答**，
+ * `hasActiveButtons` 是**正确的数据源**；旧逻辑的错**不在用它**，
+ * 而在**没同时看 `needValue`**（只要没按钮就弹输入框，不管游戏要不要值）。
+ */
+
+// ---------- 夹具 ----------
+
+function seg(text: string): PrintSegment {
+  return { text };
+}
+
+function diffLine(text: string): DisplayLine {
+  return { entries: [{ segments: [seg(text)] }], isLineEnd: true };
+}
+
+interface FrameOpts {
+  needValue: boolean;
+  inputType?: string | null;
+  state?: string;
+  generation?: number;
+  /** 每个元素是一个按钮的 generation；省略 = 该行无按钮。 */
+  buttonGens?: number[];
+}
+
+/** 构造一个 append diff 帧。`buttonGens` 与 `generation` 相等才算"本回合可用按钮"。 */
+function frame(opts: FrameOpts): string {
+  const generation = opts.generation ?? 0;
+  const gens = opts.buttonGens ?? [];
+  const entries =
+    gens.length > 0
+      ? gens.map((bg, i) => ({
+          segments: [seg(`[btn${i}]`)],
+          button: { value: i, isInteger: true, col: i * 5, width: 4, generation: bg },
+        }))
+      : [{ segments: [seg('纯文本')] }];
+
+  return JSON.stringify({
+    state: opts.state ?? 'WaitInput',
+    inputType: opts.inputType === undefined ? null : opts.inputType,
+    needValue: opts.needValue,
+    generation,
+    diff: { lineOps: [{ type: 'append', newLines: [{ entries, isLineEnd: true }] }] },
+  });
+}
+
+function freshGame() {
+  setActivePinia(createPinia());
+  return useGameStore();
+}
+
+// ---------- 测试 ----------
+
+describe('useGameStore - needsTextInput', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia());
+  });
+
+  // ---------- ① needValue 是硬门槛 ----------
+
+  it('AnyKey（needValue=false）→ 不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: false, inputType: 'AnyKey' }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  it('EnterKey（needValue=false）→ 不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: false, inputType: 'EnterKey' }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  it('Void（needValue=false，「不能输入，只能等」）→ 不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: false, inputType: 'Void' }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  it('★ 协议自相矛盾（needValue=false 却给 StrValue）→ 以 needValue 为准，不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: false, inputType: 'StrValue' }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  // ---------- ② needValue=true 且画面上无按钮 → 需要打字 ----------
+
+  for (const t of ['IntValue', 'StrValue', 'AnyValue']) {
+    it(`${t} + needValue=true + 无按钮 → ★ 需要打字（键盘按钮应亮灯）`, () => {
+      const game = freshGame();
+      game.applyTurn(frame({ needValue: true, inputType: t }));
+      expect(game.hasActiveButtons).toBe(false);
+      expect(game.needsTextInput).toBe(true);
+    });
+  }
+
+  // ---------- ③ needValue=true 但画面上有本回合按钮 → 不需要打字 ----------
+
+  it('★★ 回归锚点：IntValue + needValue=true + 有本回合按钮 → 不需要打字（eraTW 标题画面形态）', () => {
+    // 这是首版判据被实机推翻的形态：Windows 上加载 eraTW 后停在标题，
+    // state=WaitInput / inputType=IntValue / needValue=true，
+    // 而屏上有 [0] 开始游戏 / [1] 继续游戏 / [2] DEMO 三个**本回合按钮**。
+    // 点这些按钮即完成输入 ⇒ 键盘灯**不该亮**。
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: true, inputType: 'IntValue', buttonGens: [0, 0, 0] }));
+
+    expect(game.hasActiveButtons).toBe(true);
+    expect(game.needsTextInput).toBe(false); // ★ 有按钮可点 → 不提示键盘
+  });
+
+  for (const t of ['IntButton', 'StrButton']) {
+    it(`${t} + needValue=true + 有本回合按钮 → 不需要打字（值由按钮给出）`, () => {
+      const game = freshGame();
+      game.applyTurn(frame({ needValue: true, inputType: t, buttonGens: [0, 0] }));
+
+      expect(game.hasActiveButtons).toBe(true);
+      expect(game.needsTextInput).toBe(false);
+    });
+  }
+
+  // ---------- ④ 只有过期按钮 → 需要打字 ----------
+
+  it('★★ 回归锚点：StrValue + needValue=true + 只剩过期按钮 → 需要打字（外部用户撞到的形态）', () => {
+    // 真实外部用户报告「新开游戏一进去点哪里都没反应」的形态：
+    // 屏上画着「是/否」等按钮，但它们是**上一回合遗留**（generation 过期、点了无效），
+    // 而游戏其实在等一个**文本输入** ⇒ 键盘灯必须亮，用户才知道去点它。
+    const game = freshGame();
+    game.applyTurn(
+      frame({ needValue: true, inputType: 'StrValue', generation: 0, buttonGens: [1, 1] }),
+    );
+
+    expect(game.currentTurnGeneration).toBe(0);
+    expect(game.hasActiveButtons).toBe(false); // 按钮 generation=1 ≠ 当前 0 → 过期
+    expect(game.needsTextInput).toBe(true); // ★ 亮灯提示用户去点键盘
+  });
+
+  // ---------- ⑤ 边界 ----------
+
+  it('非 WaitInput（Running）→ 不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: true, inputType: 'StrValue', state: 'Running' }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  it('非 WaitInput（Quit）→ 不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: true, inputType: 'StrValue', state: 'Quit' }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  it('inputType=null + needValue=false → 不需要打字', () => {
+    const game = freshGame();
+    game.applyTurn(frame({ needValue: false, inputType: null }));
+    expect(game.needsTextInput).toBe(false);
+  });
+
+  it('diffLine 夹具产生的纯文本行不含按钮（自检）', () => {
+    expect(diffLine('x').entries).toHaveLength(1);
+  });
+});
