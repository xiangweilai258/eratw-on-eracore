+		}
+
+		public override void DoInstruction(ExpressionMediator exm, InstructionLine func, ProcessState state)
+		{
+			if (GlobalStatic.Process.SkipPrint)
+				return;
+			var arg = (SpHtmlPrint)func.Argument;
+			// Opt 为 null（调用方未给第二参数）时短路，不去读 ConstInt。
+			//
+			// 两件事一起做，缺一不可：
+			//   ① 制表补齐——右侧补半角空格到 PrintCLength+1，**这就是按钮之间的间隔**。
+			//      eraTW 的 SHOP.ERB 连写三次按钮、中间不加任何空格，间隔完全靠它。
+			//   ② 攒进缓冲区而非立即成行——并排的按钮在下次 Flush 时统一排版，
+			//      放不下时引擎自行折行（即原版行为）。
+			//
+			//   ★ 补齐必须与「按实际列数算宽度」配套（见 ConsolePrintManager.BuildPrintOpsForLine）：
+			//     补出来的空格是该按钮文本的一部分，会被计入它的显示列数，于是下一个按钮的
+			//     col 正好落在补齐后的列位上——间隔与列位同时正确。若宽度仍按标签字符数量，
+			//     补齐就会让 col 逐行漂移（曾实测同一列落到 28 与 57 两处）。
+			if (arg.IsConst) exm.Console.PrintHtml(PadForPrintLC(arg.ConstStr), arg.Opt == null || arg.ConstInt != 0);
+			else exm.Console.PrintHtml(PadForPrintLC(arg.Str.GetStrValue(exm)), arg.Opt == null || arg.Opt.GetIntValue(exm) != 0);
+		}
+	}
+
+	/// <summary>
+	/// PRINTC 左对齐（LC）的制表补齐：在右侧补半角空格到 <c>Config.PrintCLength + 1</c>。
+	///
+	/// ★ 宽度必须用 <see cref="TerminalDisplayWidth.GetDisplayWidth"/>，**不能**用 Shift-JIS
+	///   字节数——两者对一个字符的判定并不相同：全角空格 U+3000 在 Shift-JIS 里占 2 字节，
+	///   而显示宽度表把它算作 1 列（其全角判定区间覆盖不到 U+3000）。补齐宽度与
+	///   ConsolePrintManager.BuildPrintOpsForLine 累加 col 的口径一旦不同源，补出来的空格
+	///   就与实际占用的列数对不上，同一列在不同行会落到相差一两格的位置（实测第二列在
+	///   26/27/28 之间漂移），纵向看起来就是"没对齐"。
+	///
+	/// 原本已达目标宽度则不加；标签解析失败时退化为原样输出，保证不影响可用性。
+	/// </summary>
+	private static string PadForPrintLC(string html)
+	{
+		if (string.IsNullOrEmpty(html))
+			return html;
+		int target = Config.PrintCLength + 1;
+		if (target <= 1)
+			return html;
+		int width;
+		try
+		{
+			width = TerminalDisplayWidth.GetDisplayWidth(HtmlManager.Html2PlainText(html));
+		}
+		catch (Exception)
+		{
+			return html;
+		}
+		return width >= target ? html : html + new string(' ', target - width);
+	}
+
