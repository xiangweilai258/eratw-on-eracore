+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.Json;
+using MinorShift.Emuera;
+using MinorShift.Emuera.GameView;
+using MinorShift.Emuera.Runtime;
+using MinorShift.Emuera.Runtime.Config;
+using MinorShift.Emuera.Server;
+using MinorShift.Emuera.Terminal.Platform;
+using MinorShift.Emuera.UI.Game;
+using Xunit;
+
+namespace Emuera.Headless.Tests;
+
+/// <summary>
+/// ★★ 第二批 · F3：**显示区间水位**（会话身份 + baseDisplaySeq → displaySeq）。
+///
+/// <para>依据 <c>会话可靠性审查记录</c>「F3 · 快照后再应用增量，没有水位保证，会重复画面」。
+/// 另按用户 2026-10-12 的契约收紧：**不能只有一个 displaySeq 然后直接过滤**——
+/// 一个增量可能覆盖一段显示变化（X+Y），而快照可能落在**这段变化的中间**（已含 X）。
+/// 故增量必须能表达「从哪个基线推进到哪个水位」。</para>
+///
+/// <para>本组验证**服务端产出的区间是否自洽**（内容与水位同源、区间连续、可判定相接与已包含）；
+/// 前端的应用 / 恢复策略另有前端测试。</para>
+/// </summary>
+[Collection("ServerState")]
+public sealed class DisplayWatermarkTests : IDisposable
+{
+    private readonly IDisposable _scope;
+    private readonly EmueraConsole _console;
+    private readonly DisplayState _displayState;
+
+    public DisplayWatermarkTests()
+    {
+        _scope = GlobalStatic.OpenScope(new ConfigData());
+        var ui = new HeadlessConsole();
+        _console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+        _displayState = new DisplayState(_console, "MS Gothic");
+    }
+
+    public void Dispose() => _scope.Dispose();
+
+    /// <summary>与既有测试同一惯例：本类自带一份 NullTerminalSetup（各测试类各持一份）。</summary>
+    private sealed class WatermarkNullTerminalSetup : ITerminalSetup
+    {
+        public bool IsAnsiEnabled => false;
+        public bool TryEnableAnsi() => false;
+        public bool TrySetConsoleSize(int cols, int rows) => false;
+        public string? DetectFont() => null;
+        public bool TryPrepareVtInput() => false;
+    }
+
+    /// <summary>模拟一次真实打印：行入显示列表 + 入 pendingOps（照 DisplayDiffTests 的写法）。</summary>
+    private static void PrintLineIn(EmueraConsole console, string text)
+    {
+        var line = new ConsoleDisplayLine(
+            new[] { TestButtonFactory.CreateNonButton(text) }, isLogical: true, temporary: false);
+        console.DisplayLineList.Add(line);
+        console._state._pendingOps.Enqueue(new PrintOp(
+            new List<PrintSegment> { new(text, null, null, null, null) }, button: null));
+    }
+
+    private void PrintLine(string text) => PrintLineIn(_console, text);
+
+    // ---------------------------------------------------------------------
+    // ① 水位随内容推进而递增（不是随"取快照次数"）
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Snapshot_seq_advances_with_content_not_with_get_calls()
+    {
+        PrintLine("A");
+        var s1 = _displayState.Current;
+        var seq1 = s1.displaySeq!.Value;
+
+        // ★ 连续取快照但**没有内容变化** ⇒ 水位不得前进
+        var s1b = _displayState.Current;
+        Assert.Equal(seq1, s1b.displaySeq!.Value);
+
+        // 内容推进 ⇒ 水位前进
+        PrintLine("B");
+        var s2 = _displayState.Current;
+        Assert.True(s2.displaySeq!.Value > seq1,
+            "有新的 pendingOp 时水位必须前进——它由**重建**驱动，不随 GET /snapshot 次数递增");
+    }
+
+    // ---------------------------------------------------------------------
+    // ①-b ★★ R7 复审补测：水位实际由 **Rebuild** 递增，**不等于**由内容变化递增。
+    //
+    // 独立审阅 指出（源码级）：Rebuild 无条件 ++；而"删除不存在的背景图""清空本来就空的
+    // 背景列表"这类**等值**操作也会入 pending 队列，触发一次内容等价的重建。
+    // ⇒ 准确说法是"重建产物与它的编号配对"，**不是**"随真实内容变化推进"。
+    //
+    // ★ 本组把这个事实**测出来**，而不是只改措辞。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void No_pending_ops_means_no_rebuild_and_no_seq_advance()
+    {
+        PrintLine("A");
+        var before = _displayState.Current.displaySeq!.Value;
+
+        // ★ 没有 pendingOp ⇒ Rebuild 不会发生 ⇒ 水位不动
+        var again = _displayState.Current;
+        Assert.Equal(before, again.displaySeq!.Value);
+        Assert.Null(_displayState.ComputeDiff());   // no-op ⇒ null，不推进
+        Assert.Equal(before, _displayState.Current.displaySeq!.Value);
+    }
+
+    [Fact]
+    public void Pending_op_forces_rebuild_and_seq_advances_even_when_snapshot_content_looks_equal()
+    {
+        PrintLine("A");
+        var baseline = _displayState.Current;         // 建立基线快照
+        var before = baseline.displaySeq!.Value;
+        var linesBefore = baseline.lines.Count;
+
+        // ★ 塞一个 pendingOp（重复打印同文本）：
+        //   pendingOp 非空 ⇒ Rebuild 被触发 ⇒ 水位前进。
+        //   这就是 R7 所说的"水位由**重建**推进"的实证。
+        PrintLine("A");
+        var after = _displayState.Current;
+        Assert.True(after.displaySeq!.Value > before,
+            "**真实内容变化**（多出一行）必须推进水位");
+        Assert.True(after.lines.Count > linesBefore);
+    }
+
+    // ---------------------------------------------------------------------
+    // ①-c ★★★ R7 契约（2026-10-12 复审修正后）：**等值内容不推进水位**
+    //
+    // 走 独立审阅 指出的**真实等值路径**（ConsolePrintManager，均为无条件 Enqueue）：
+    //   · RemoveBgImage：删除一张**不存在**的背景图 ⇒ FindIndex < 0，什么也没删
+    //   · ClearBgImage：清空**本来就空**的背景列表
+    // 它们会触发一次内容**等值**的 Rebuild。契约要求：水位**不得**因此推进。
+    //
+    // ★ 为什么必须这样：前端把「水位 ≥ 某增量终点」判为"已被画面包含"并丢弃该增量。
+    //   若水位被等值重建虚增，**真实的变化会被误判为已包含而丢失**。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Removing_a_nonexistent_bg_image_does_not_advance_seq()
+    {
+        PrintLine("A");
+        var baseline = _displayState.Current;
+        var before = baseline.displaySeq!.Value;
+
+        // ★ 真实等值路径：删一张**不存在**的背景图
+        _console.RemoveBgImage("不存在的背景图");
+        var after = _displayState.Current;
+
+        Assert.Equal(before, after.displaySeq!.Value);
+        Assert.Null(after.bgImages);   // 确实什么也没删
+    }
+
+    [Fact]
+    public void Clearing_already_empty_bg_images_does_not_advance_seq()
+    {
+        PrintLine("A");
+        var baseline = _displayState.Current;
+        var before = baseline.displaySeq!.Value;
+
+        // ★ 真实等值路径：清空本来就空的背景列表
+        _console.ClearBgImage();
+        var after = _displayState.Current;
+
+        Assert.Equal(before, after.displaySeq!.Value);
+    }
+
+    [Fact]
+    public void Real_bg_image_change_does_advance_seq()
+    {
+        PrintLine("A");
+        var before = _displayState.Current.displaySeq!.Value;
+
+        // ★ 真实变化路径：确实加了一张背景图 ⇒ 水位**必须**推进
+        _console.SetBgImage("a.png", 1, 0.5f);
+        var after = _displayState.Current;
+
+        Assert.True(after.displaySeq!.Value > before,
+            "真实的背景变化必须推进水位——否则前端会把它误判为已包含而丢弃");
+        Assert.NotNull(after.bgImages);
+    }
+
+    // ---------------------------------------------------------------------
+    // ② 快照内容与其水位**同源**（同一次读取里两者取自同一份 _current）
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Snapshot_lines_and_seq_come_from_the_same_current()
+    {
+        PrintLine("only-line");
+        var snap = _displayState.Current;
+
+        Assert.Single(snap.lines);
+        Assert.NotNull(snap.displaySeq);
+        Assert.Equal(1, snap.displaySeq!.Value);
+    }
+
+    // ---------------------------------------------------------------------
+    // ③ ★★ 区间语义：增量表达 [base, seq]，且连续增量的区间首尾相接
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Diff_carries_interval_and_consecutive_diffs_are_contiguous()
+    {
+        PrintLine("X");
+        Assert.Null(_displayState.ComputeDiff());   // 首帧（HTTP 模式）→ null，_previous 就位
+
+        PrintLine("Y");
+        var d1 = _displayState.ComputeDiff();
+        Assert.NotNull(d1);
+        var b1 = d1!.baseDisplaySeq!.Value;
+        var e1 = d1.displaySeq!.Value;
+        Assert.True(b1 < e1, "增量区间必须非退化（基线 < 终点）");
+
+        PrintLine("Z");
+        var d2 = _displayState.ComputeDiff();
+        Assert.NotNull(d2);
+        var b2 = d2!.baseDisplaySeq!.Value;
+        var e2 = d2.displaySeq!.Value;
+
+        // ★ 连续性判据：下一段增量的基线 == 上一段增量的终点
+        Assert.Equal(e1, b2);
+        Assert.True(e2 > e1);
+    }
+
+    // ---------------------------------------------------------------------
+    // ④ ★★ 用户要求的必测形态：一次增量覆盖 X+Y，快照落在区间中间
+    //     ⇒ 既不能整段接受（重复 X）、也不能整段丢弃（丢 Y）⇒ 可判定为"需有界恢复"
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Snapshot_inside_a_diff_interval_is_detectable()
+    {
+        // ★★★ R9（2026-10-12 复审重做）：按 独立审阅 指定的**真实顺序**构造，不再伪造中点。
+        //
+        //   1) 建基线：_previous 定格在基线，水位 = 1
+        //   2) 打印 X
+        //   3) **真实读取 Current 快照 S**（这一步只推进 _current，不动 _previous）⇒ 水位 = 2
+        //   4) 打印 Y
+        //   5) ComputeDiff ⇒ base = _previous 的水位(1)，end = 当前水位(3)
+        //   ⇒ 严格 base(1) < S.displaySeq(2) < end(3)，**快照真的落在区间中间**。
+        //
+        // ★ 为什么第 3 步能成立：快照只 Rebuild + drain，不推进 _previous；
+        //   而 _previous 仍停在第 1 步的基线 ⇒ 随后的 diff 自然跨越了它。
+        //   ★ 此前做不到，是因为水位随 Rebuild 无条件推进导致取值巧合；R7 修正后
+        //   重建与内容推进已区分开，这条路径才真实可用。
+        PrintLine("baseline");
+        var firstDiff = _displayState.ComputeDiff();   // 首帧 null，_previous 就位
+        Assert.Null(firstDiff);
+        var baseSeq = _displayState.Current.displaySeq!.Value;
+
+        PrintLine("X");
+        var snapshotS = _displayState.Current;         // ★ 真实读取快照 S
+        Assert.True(Contains(snapshotS.lines, "X"), "快照 S 应含 X");
+
+        PrintLine("Y");
+        var span = _displayState.ComputeDiff();
+        Assert.NotNull(span);
+
+        var b = span!.baseDisplaySeq!.Value;
+        var e = span.displaySeq!.Value;
+        var s = snapshotS.displaySeq!.Value;
+
+        // ★ 严格不等式：快照真的落在区间中间
+        Assert.True(b < s, $"base({b}) 必须 < 快照水位({s})");
+        Assert.True(s < e, $"快照水位({s}) 必须 < 区间终点({e})");
+        Assert.True(b == baseSeq, "区间起点应就是建基线时的水位");
+
+        // ★ 核对实际内容：S 含 X 不含 Y；end 之后两者都在
+        Assert.True(Contains(snapshotS.lines, "X"), "快照 S 必须含 X");
+        Assert.False(Contains(snapshotS.lines, "Y"), "快照 S 不应含 Y（Y 在其后打印）");
+        var finalLines = _displayState.Current.lines;
+        Assert.True(Contains(finalLines, "X") && Contains(finalLines, "Y"), "终点内容应同时含 X 与 Y");
+    }
+
+    /// <summary>快照行里是否出现指定文本（按 segment 文本包含判定）。</summary>
+    private static bool Contains(List<DisplayLine> lines, string text)
+        => lines.Any(l => l.entries.Any(e => e.segments != null
+            && e.segments.Any(sg => (sg.text ?? string.Empty).Contains(text))));
+
+    // ---------------------------------------------------------------------
+    // ⑤ 首帧（MAUI 全量 diff）也带区间：基线 0 → 当前水位
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void First_full_diff_for_maui_starts_from_zero_baseline()
+    {
+        // ★ 本类构造函数已经开了 GlobalStatic.OpenScope —— 此处**不再嵌套开**，
+        //   只另建一套 console/state（不共享 _displayState 的 _previous）。
+        var ui = new HeadlessConsole();
+        var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+        // MAUI 模式：fullDiffOnFirstTurn = true，首帧返回全量 AppendLinesOp
+        var state = new DisplayState(console, "MS Gothic", fullDiffOnFirstTurn: true);
+
+        PrintLineIn(console, "first");
+        var diff = state.ComputeDiff();
+        Assert.NotNull(diff);
+
+        Assert.Equal(0, diff!.baseDisplaySeq!.Value);
+        Assert.True(diff.displaySeq!.Value > 0);
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑥ diff 为 null（本回合显示未变）⇒ 不携带区间（没有内容变化就没有区间）
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Noop_diff_is_null_so_it_carries_no_interval()
+    {
+        PrintLine("A");
+        Assert.Null(_displayState.ComputeDiff());   // 首帧 null
+        Assert.Null(_displayState.ComputeDiff());   // 内容未变 ⇒ 仍 null
+    }
+
+    // ---------------------------------------------------------------------
+    // ⑦ 快照 JSON 真正带上 displaySeq 与 sessionId（wire 形态）
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Snapshot_json_carries_displaySeq_and_sessionId()
+    {
+        PrintLine("A");
+        var json = _displayState.GetSnapshotJson("abcd1234");
+        using var doc = JsonDocument.Parse(json);
+        var root = doc.RootElement;
+
+        Assert.True(root.TryGetProperty("displaySeq", out var seq), "快照必须携带 displaySeq");
+        Assert.True(seq.GetInt64() > 0);
+        Assert.True(root.TryGetProperty("sessionId", out var sid), "快照必须携带 sessionId");
+        Assert.Equal("abcd1234", sid.GetString());
+        Assert.Equal(14, root.GetProperty("protocolVersion").GetInt32());
+    }
+
+    // ---------------------------------------------------------------------
+    // ★★ R4（第二批复审 · 独立审阅 第 3 点）：**快照与 Turn 取自同一次捕获**（后端证明）
+    //
+    // 独立审阅 要求：「快照不能只从 CaptureTopLevel 取 seq，再另读 console 拼状态。」
+    // 且「**不以仅前端手造数据测试代替后端证明**」——故这里在**真实 DisplayState +
+    // 真实 AgentJsonlProtocol** 上验证。
+    // ---------------------------------------------------------------------
+
+    [Fact]
+    public void Snapshot_and_turn_share_one_capture_so_state_matches_stateSeq()
+    {
+        var ui = new HeadlessConsole();
+        var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+        var state = new DisplayState(console, "MS Gothic");
+        var io = NewProbeIO();
+        // ★ 真实协议层——快照探针由它在构造时装配
+        var protocol = new AgentJsonlProtocol(console, ui, io, state);
+
+        // 打印一行，触发一次内容推进
+        PrintLineIn(console, "X");
+
+        // ① 快照侧先观察到"纯顶层变化"：把 console 状态改为另一个状态
+        console._state.State = ConsoleState.Error;
+        var snapshot = state.Current;      // ← 走 Current/TryUpdate → Rebuild → 探针 → CaptureTopLevel
+
+        // ② 随后 Turn 侧取值
+        var turnJson = protocol.BuildTurnForTest();
+
+        using var snapDoc = JsonDocument.Parse(state.GetSnapshotJson("S1"));
+        using var turnDoc = JsonDocument.Parse(turnJson);
+
+        // ★ 核心断言：两者的顶层**状态字段**一致
+        Assert.Equal(snapDoc.RootElement.GetProperty("state").GetString(),
+                     turnDoc.RootElement.GetProperty("state").GetString());
+        // ★ 且 stateSeq 一致（来自同一次捕获机制，不分属两个时刻）
+        Assert.Equal(snapDoc.RootElement.GetProperty("stateSeq").GetInt64(),
+                     turnDoc.RootElement.GetProperty("stateSeq").GetInt64());
+        // ★ 状态确实是"Error"（证明这个断言不是两个 null 巧合相等）
+        Assert.Equal("Error", turnDoc.RootElement.GetProperty("state").GetString());
+    }
+
+    [Fact]
+    public void Snapshot_does_not_consume_one_shot_error_or_timeout_flags()
+    {
+        var ui = new HeadlessConsole();
+        var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+        var state = new DisplayState(console, "MS Gothic");
+        var io = NewProbeIO();
+        var protocol = new AgentJsonlProtocol(console, ui, io, state);
+
+        PrintLineIn(console, "X");
+
+        // ★ 预设一次性旗标：error 与 timedOut
+        protocol.PendingRejectReasonForTest = "拒绝原因";
+        protocol.PendingTimeoutForTest = true;
+
+        // 快照侧读取——**不得消费**这两个一次性字段
+        var snapshotJson = state.GetSnapshotJson("S1");
+        using (var doc = JsonDocument.Parse(snapshotJson))
+        {
+            // 快照是"当前状态"，不含本回合的一次性字段
+            Assert.False(doc.RootElement.TryGetProperty("error", out _),
+                "快照不应携带本回合的一次性 error");
+        }
+
+        // ★ 关键：旗标仍在——随后 Turn 仍能读到（证明没被快照吃掉）
+        var turnJson = protocol.BuildTurnForTest();
+        using var turnDoc = JsonDocument.Parse(turnJson);
+        Assert.Equal("拒绝原因", turnDoc.RootElement.GetProperty("error").GetString());
+        Assert.True(turnDoc.RootElement.GetProperty("timedOut").GetBoolean());
+    }
+
+    [Fact]
+    public void Generation_only_advance_still_advances_stateSeq()
+    {
+        var ui = new HeadlessConsole();
+        var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+        var state = new DisplayState(console, "MS Gothic");
+        var io = NewProbeIO();
+        var protocol = new AgentJsonlProtocol(console, ui, io, state);
+
+        console._state.State = ConsoleState.WaitInput;
+        var first = JsonDocument.Parse(protocol.BuildTurnForTest());
+        var seq1 = first.RootElement.GetProperty("stateSeq").GetInt64();
+        first.Dispose();
+
+        // ★ 顶层状态完全不变，**只有 generation 前进**（独立审阅 R4 第 2 点补正的核心场景）
+        console._state.lastButtonGeneration = 7;
+        var second = JsonDocument.Parse(protocol.BuildTurnForTest());
+        var seq2 = second.RootElement.GetProperty("stateSeq").GetInt64();
+        var gen2 = second.RootElement.GetProperty("generation").GetInt64();
+        second.Dispose();
+
+        Assert.Equal(7, gen2);
+        // ★ generation 前进必须让顶层序号前进，否则前端会把新按钮代次当旧帧丢弃
+        Assert.True(seq2 > seq1,
+            $"只有 generation 前进时 stateSeq 也必须前进（{seq1} → {seq2}）");
+    }
+
+    /// <summary>供上面用例使用的最小 SessionIO：真实的 HttpSessionIO + 独立 Hub（只读用途）。</summary>
+    private static HttpSessionIO NewProbeIO() => new HttpSessionIO(new OutputHub());
+      // ---------------------------------------------------------------------
+      // ★★ C4（独立审阅 指出我原测试证明不了）：**已建缓存之后**的纯顶层变化必须被快照观察到。
+      //
+      // 独立审阅 的理由：`Current` 此前只调 `TryUpdate`，无显示 pending 时直接返回缓存，
+      // 而顶层探针只在 Rebuild 内被调用 ⇒「先建缓存 → 纯状态/generation 变化 → 再取快照」
+      // 永远拿不到新顶层。我原来的用例先打印 X（恰好触发 Rebuild）⇒ 证明不了。
+      // ---------------------------------------------------------------------
+
+      [Fact]
+      public void Snapshot_refreshes_top_level_even_when_no_display_pending()
+      {
+          var ui = new HeadlessConsole();
+          var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+          var state = new DisplayState(console, "MS Gothic");
+          var io = NewProbeIO();
+          var protocol = new AgentJsonlProtocol(console, ui, io, state);
+
+          PrintLineIn(console, "X");
+          console._state.State = ConsoleState.WaitInput;
+
+          // ① **先建缓存**：取一次快照，让 _current 定稿
+          var first = state.Current;
+          var firstSeq = first.stateSeq!.Value;
+          var firstDisplaySeq = first.displaySeq!.Value;
+          var firstLines = first.lines.Count;
+
+          // ② 断言此刻**确实没有显示 pending**——否则本用例证明不了 C4
+          Assert.Equal(0, console.PendingOpCount);
+
+          // ③ 纯顶层变化：状态改变 + generation 前进，**不产生任何显示 op**
+          console._state.State = ConsoleState.Error;
+          console._state.lastButtonGeneration = 9;
+
+          // ④ 再取快照
+          var second = state.Current;
+
+          // ★ 顶层必须被刷新（这是 C4 的核心）
+          Assert.Equal("Error", second.state);
+          Assert.Equal(9, second.generation);
+          Assert.True(second.stateSeq!.Value > firstSeq,
+              $"纯顶层变化（无显示 op）后 stateSeq 必须前进：{firstSeq} → {second.stateSeq}");
+
+          // ★ 显示水位**不得**被虚增（顶层刷新与显示缓存彼此独立）
+          Assert.Equal(firstDisplaySeq, second.displaySeq!.Value);
+          Assert.Equal(firstLines, second.lines.Count);
+      }
+
+      [Fact]
+      public void Snapshot_generation_comes_from_the_same_capture_as_stateSeq()
+      {
+          var ui = new HeadlessConsole();
+          var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+          var state = new DisplayState(console, "MS Gothic");
+          var io = NewProbeIO();
+          var protocol = new AgentJsonlProtocol(console, ui, io, state);
+
+          PrintLineIn(console, "X");
+          var _ = state.Current;                     // 建缓存
+
+          console._state.lastButtonGeneration = 3;  // 只有 generation 前进
+          var snap = state.Current;
+
+          // ★ C5：快照的 generation 与 stateSeq **同源**——不二次读取
+          Assert.Equal(3, snap.generation);
+          Assert.NotNull(snap.stateSeq);
+          Assert.True(snap.stateSeq!.Value >= 2,
+              "generation 前进时快照的 stateSeq 也应已推进（同一捕获元组）");
+      }
+
+      [Fact]
+      public void Snapshot_read_does_not_bump_stateSeq_due_to_event_fields_being_excluded()
+      {
+          var ui = new HeadlessConsole();
+          var console = new EmueraConsole(ui, new WatermarkNullTerminalSetup());
+          var state = new DisplayState(console, "MS Gothic");
+          var io = NewProbeIO();
+          var protocol = new AgentJsonlProtocol(console, ui, io, state);
+
+          PrintLineIn(console, "X");
+          console._state.State = ConsoleState.WaitInput;
+          var _ = state.Current;
+          var seqBefore = state.Current.stateSeq!.Value;
+
+          // ★ 预置一次性事件字段（error），状态本身不变
+          protocol.PendingRejectReasonForTest = "某次拒绝";
+
+          // 取快照：forSnapshot 排除事件字段 ⇒ **不得**因此推进序号
+          var after = state.Current;
+          Assert.Equal(seqBefore, after.stateSeq!.Value);
+
+          // ★ 但随后的 Turn 仍能读到该事件，且它会触发一次推进
+          var turnJson = protocol.BuildTurnForTest();
+          using var doc = JsonDocument.Parse(turnJson);
+          Assert.Equal("某次拒绝", doc.RootElement.GetProperty("error").GetString());
+          Assert.True(doc.RootElement.GetProperty("stateSeq").GetInt64() > seqBefore,
+              "事件被 Turn 消费时应触发一次序号推进");
+      }
+
+}
