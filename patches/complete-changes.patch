+  });
+
+  async function mountLibrary(): Promise<{ wrapper: VueWrapper<any>; game: ReturnType<typeof useGameStore> }> {
+    const game = useGameStore();
+    const wrapper = mount(GameLibraryView, { props: { source } });
+    await wrapper.vm.$nextTick();
+    return { wrapper, game };
+  }
+
+  it('空态明确「游戏文件夹放在主目录下」且「每个游戏文件夹」含 CSV/ERB', async () => {
+    const { wrapper } = await mountLibrary();
+    const empty = wrapper.find('.empty-state');
+    expect(empty.exists()).toBe(true);
+
+    const hints = wrapper.findAll('.empty-hint').map((h) => h.text());
+    expect(hints).toContain('请将游戏文件夹放在主目录下');
+    expect(hints).toContain('每个游戏文件夹中需包含 CSV 和 ERB 子目录');
+    // 旧文案（易误读为主目录自身要含 csv/erb）不再出现
+    expect(wrapper.text()).not.toContain('游戏目录需要包含');
