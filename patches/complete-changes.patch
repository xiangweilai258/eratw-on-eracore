+using System;
+using System.IO;
+using MinorShift.Emuera;
+using MinorShift.Emuera.Assets;
+using MinorShift.Emuera.Primitives;
+using MinorShift.Emuera.UI.Game.Image;
+using Xunit;
+
+namespace Emuera.Headless.Tests;
+
+/// <summary>
+/// ★ 2026-10-09 新增：<c>GCREATEFROMFILE</c> 不再恒返回 0，
+/// 且合成名能回溯到「来源图片相对路径」—— 前端据此**直接读原文件**把图显示出来（eraTW「神签」）。
+///
+/// <para>★ 无头下**仍然拿不到像素**。本测试钉的是三件事：
+/// ① 画布能用「文件」建成且尺寸正确；② 合成名带着来源路径；③ 资源通道第 3 步能把合成名落到真实文件。</para>
+///
+/// <para>GamePaths 是静态 Current ⇒ 与同类测试一样放串行隔离集合。</para>
+/// </summary>
+[Collection("GamePathsIsolated")]
+public class GraphicsCreateFromFileTests : IDisposable
+{
+    private readonly string _root;
+
+    public GraphicsCreateFromFileTests()
+    {
+        _root = Path.Combine(Path.GetTempPath(), "emuera_gfrom_" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_root);
+        GamePaths.Resolve(_root, new FileSystemGameDirAccessor());
+    }
+
+    public void Dispose()
+    {
+        try { Directory.Delete(_root, true); } catch { }
+    }
+
+    /// <summary>写一个最小合法 PNG（签名 ＋ IHDR 即可 —— 尺寸探针只读头部，不校验 CRC）。</summary>
+    private void WritePng(string relativePath, int w, int h)
+    {
+        var full = Path.Combine(_root, relativePath);
+        Directory.CreateDirectory(Path.GetDirectoryName(full)!);
+        var b = new byte[33];
+        byte[] sig = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A];
+        Array.Copy(sig, 0, b, 0, 8);
+        b[11] = 13;                                   // IHDR 数据长度
+        b[12] = (byte)'I'; b[13] = (byte)'H'; b[14] = (byte)'D'; b[15] = (byte)'R';
+        b[16] = (byte)(w >> 24); b[17] = (byte)(w >> 16); b[18] = (byte)(w >> 8); b[19] = (byte)w;
+        b[20] = (byte)(h >> 24); b[21] = (byte)(h >> 16); b[22] = (byte)(h >> 8); b[23] = (byte)h;
+        b[24] = 8;   // bit depth
+        b[25] = 6;   // color type = RGBA
+        File.WriteAllBytes(full, b);
+    }
+
+    [Fact]
+    public void GCreateFromSize_marks_created_with_size_and_source()
+    {
+        var g = AppContents.GetGraphics(991001);
+        g.GCreateFromSize(37, 19, "pic/probe.png");     // ★ 无头版的「文件 → 画布」
+
+        Assert.True(g.IsCreated, "★ 修前 GCREATEFROMFILE 恒返回 0 ⇒ 画布永远不会被创建");
+        Assert.Equal(37, g.Width);
+        Assert.Equal(19, g.Height);
+        Assert.Equal("pic/probe.png", g.SourceFilePath);
+    }
+
+    [Fact]
+    public void CreateSpriteG_carries_source_to_registry()
+    {
+        var g = AppContents.GetGraphics(991002);
+        g.GCreateFromSize(40, 30, "pic/src.png");
+        AppContents.CreateSpriteG("__合成_带源__", g, new EmuRectangle(0, 0, 40, 30));
+
+        Assert.True(AppContents.TryResolveSpriteSource("__合成_带源__", out var rel));
+        Assert.Equal("pic/src.png", rel);
+    }
+
+    [Fact]
+    public void SpriteDispose_also_drops_source()
+    {
+        var g = AppContents.GetGraphics(991003);
+        g.GCreateFromSize(10, 10, "pic/x.png");
+        AppContents.CreateSpriteG("__合成_释放__", g, new EmuRectangle(0, 0, 10, 10));
+        Assert.True(AppContents.TryResolveSpriteSource("__合成_释放__", out _));
+
+        AppContents.SpriteDispose("__合成_释放__");
+
+        Assert.False(AppContents.TryResolveSpriteSource("__合成_释放__", out _));
+    }
+
+    [Fact]
+    public void AssetChannel_resolves_composite_name_to_source_file()
+    {
+        WritePng("pic/target.png", 12, 7);
+        var g = AppContents.GetGraphics(991004);
+        g.GCreateFromSize(12, 7, "pic/target.png");
+        AppContents.CreateSpriteG("__合成_取图__", g, new EmuRectangle(0, 0, 12, 7));
+
