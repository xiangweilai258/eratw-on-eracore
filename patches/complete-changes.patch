index 00000000..153095fc
--- /dev/null
+++ b/EraCore.Maui/Services/MauiServerHost.cs
@@ -0,0 +1,44 @@
+using MinorShift.Emuera.Server;
+
+namespace EraCore.Maui.Services;
+
+/// <summary>
+/// MAUI 侧对「托管宿主」的最小需求封装（2026-10-03，方案 B 引入）。
+/// <para>
+/// <b>为什么需要它</b>：MAUI 现在有<b>两个</b>宿主实现可跑同一份共享层：
+/// <list type="bullet">
+///   <item>Android → <see cref="HttpListenerHost"/>（BCL <c>System.Net.HttpListener</c>，不引 ASP.NET Core）</item>
+///   <item>Windows → <c>KestrelGameServer</c>（ASP.NET Core，与 CLI/Server 同栈）——
+///     因为实测该平台 app 内 HttpListener 起不来</item>
+/// </list>
+/// 而 MAUI 对宿主的实际需求只有两件：<b>端口</b>（写 agent 发现记录）与 <b>会话注册表</b>（建/退会话、取 turn 通道）。
+/// 本类把这个交叉点收在一个地方，<see cref="BridgeHost"/> 便无需知道自己是哪种宿主。
+/// </para>
+/// <para>
+/// <b>为什么不做成 Core 里的接口</b>：两个宿主的 <c>Sessions</c> 成员都是 <c>internal</c>
+/// （<see cref="SessionRegistry"/> 本身是 Core 的 internal 类型，不能出现在 public 签名上），
+/// 用接口就得写显式实现、还要为它新增一个 Core 文件；而 MAUI 已具备对 Core/Server 的
+/// <c>InternalsVisibleTo</c>，直接用适配器最省改动、语义也最直白。
+/// </para>
+/// </summary>
+internal sealed class MauiServerHost
+{
+    /// <summary>宿主实例（用于统一释放）——所有权归 <see cref="MauiControlServer"/>。</summary>
+    private readonly IDisposable _owner;
+
+    internal MauiServerHost(int port, SessionRegistry sessions, IDisposable owner)
+    {
+        Port = port;
+        Sessions = sessions;
+        _owner = owner;
+    }
+
+    /// <summary>实际监听端口（写 agent 发现记录用）。</summary>
+    internal int Port { get; }
+
+    /// <summary>共享层会话注册表——建会话 / 退会话 / 取 turn 订阅通道。</summary>
+    internal SessionRegistry Sessions { get; }
+
+    /// <summary>释放宿主（停监听 + 释放全部会话）。</summary>
+    internal void Dispose() => _owner.Dispose();
+}
diff --git a/EraCore.Maui/Services/OrientationLock.cs b/EraCore.Maui/Services/OrientationLock.cs
new file mode 100644
index 00000000..5da8e1fa
--- /dev/null
+++ b/EraCore.Maui/Services/OrientationLock.cs
@@ -0,0 +1,90 @@
+using Microsoft.Maui.Storage;
+
+namespace EraCore.Maui.Services;
+
+/// <summary>
+/// ★ 屏幕方向锁定（2026-10-08）。
+///
+/// <para>
+/// <b>背景</b>：era 游戏的窗口宽度是游戏自己定的（eraTW 为 <c>1800px</c>），横屏（1920）正好放得下，
+/// 而竖屏（1200）会把右侧内容裁掉 —— 2026-10-08 真机实测确认。所以**默认锁定横屏**更符合这类游戏的形态。
+/// </para>
+///
+/// <para>
+/// <b>为什么单独一个类</b>：这个状态有两个使用点 —— ① 设置页切换时（经 <c>BridgeHost</c> 回调下来）；
+/// ② **应用启动时**（<c>MainActivity.OnCreate</c> 要读回上次的选择并立即应用，所以「默认锁横屏」开机即生效）。
+/// 让 <c>BridgeHost</c> 直接碰平台 API 会破坏它的可跨平台单测性，故收敛到此处。
+/// </para>
+///
+/// <para>
+/// <b>持久化</b>：用 MAUI 的 <see cref="Preferences"/>（Android 上即 SharedPreferences），
+/// ★ key 与前端 localStorage 的那个是**两套**，此处是权威值（前端在 WebView 起来后可能还没消息发出，
+/// 启动期只能靠这里的值）。
+/// </para>
+/// </summary>
+public static class OrientationLock
+{
+    /// <summary>Preferences 键。★ 与前端 localStorage 的 <c>app.orientationLock</c> 是两套，此处为权威。</summary>
+    public const string PreferenceKey = "orientation_locked";
+
+    /// <summary>★ 默认值 = <c>true</c>（锁定横屏）—— 见类型注释里"背景"一节。</summary>
+    public const bool DefaultLocked = true;
+
+    /// <summary>当前是否锁定横屏（★ 从未设置过时为 <see cref="DefaultLocked"/>）。</summary>
+    public static bool IsLocked
+    {
+        get
+        {
+            try { return Preferences.Default.Get(PreferenceKey, DefaultLocked); }
+            catch { return DefaultLocked; }   // 取不到就按默认来，别让一个偏好设置把流程搞挂
+        }
+    }
+
+    /// <summary>
+    /// 设置并**立即应用**（设置页切换走这里）。★ 同时写盘，下次启动读回。
+    /// </summary>
+    public static void Set(bool locked)
+    {
+        try { Preferences.Default.Set(PreferenceKey, locked); }
+        catch (Exception ex) { Console.WriteLine($"[orientation] 写偏好失败：{ex.Message}"); }
+        ApplyToPlatform(locked);
+    }
+
+    /// <summary>
+    /// 只应用**已存的值**（启动时调用 —— <c>MainActivity.OnCreate</c>）。
+    /// ★ 不写盘：这里只是把上次的选择恢复出来。
+    /// </summary>
+    public static void ApplyStored() => ApplyToPlatform(IsLocked);
+
+    /// <summary>平台分支：只有 Android 有"屏幕方向"这个概念；★ 其他平台是空实现。</summary>
+    private static void ApplyToPlatform(bool locked)
+    {
+#if ANDROID
+        try
+        {
+            // Platform.CurrentActivity 是 MAUI 提供的当前 Activity——MainActivity 是 MauiAppCompatActivity，
+            // 所以这里拿到的就是它。RequestedOrientation 在运行时设置会**覆盖** manifest 里的声明值。
+            if (Microsoft.Maui.ApplicationModel.Platform.CurrentActivity is Android.App.Activity activity)
+            {
+                activity.RequestedOrientation = locked
+                    ? Android.Content.PM.ScreenOrientation.Landscape
+                    : Android.Content.PM.ScreenOrientation.FullSensor;
+                Android.Util.Log.Info("EmueraMaui",
+                    $"OrientationLock: {(locked ? "Landscape(锁定横屏)" : "FullSensor(跟随系统)")}");
+            }
+            else
+            {
+                Android.Util.Log.Warn("EmueraMaui", "OrientationLock: CurrentActivity 为 null，跳过");
+            }
+        }
+        catch (Exception ex)
+        {
+            // ★ 方向设置失败不该把游戏拖崩——记日志即可。
+            Android.Util.Log.Error("EmueraMaui", $"OrientationLock 应用失败：{ex}");
+        }
+#else
+        // ★ Windows 等平台没有屏幕方向，故意什么都不做（前端也不会显示那个按钮）。
+        _ = locked;
+#endif
+    }
+}
diff --git a/EraCore.Maui/Services/PreferencesAppSettingsStore.cs b/EraCore.Maui/Services/PreferencesAppSettingsStore.cs
new file mode 100644
index 00000000..d95ce503
--- /dev/null
+++ b/EraCore.Maui/Services/PreferencesAppSettingsStore.cs
@@ -0,0 +1,102 @@
+using System;
+using System.Collections.Generic;
+using Microsoft.Maui.Storage;
+using MinorShift.Emuera.Runtime.Config;
+
+namespace EraCore.Maui.Services;
+
+/// <summary>
+/// MAUI 全局设置存储（ADR-0030）——<see cref="IAppSettingsStore"/> 的 Preferences 实现。
+/// 键常量沿用 <see cref="BridgeHost"/>（<c>app.perf.*</c>/<c>app.diag.*</c> 等），数据格式与旧
+/// BridgeHost 直接读写逐位一致（agentLogEnabled 存 bool，其余存字符串，缺省 "auto"）。
+/// 行为兼容：Preferences 不可用时静默回退（Get→默认，Set→丢弃，与旧 try/catch 一致）。
+/// </summary>
+internal sealed class PreferencesAppSettingsStore : IAppSettingsStore
+{
+    private static readonly IReadOnlyDictionary<string, string> KeyMap = new Dictionary<string, string>(StringComparer.Ordinal)
+    {
+        [AppSettings.DisplayReportOverrideKey] = BridgeHost.DisplayReportOverrideKey,
+        [AppSettings.AgentLogEnabledKey] = BridgeHost.AgentLogEnabledKey,
+        [AppSettings.SweepGatePolicyKey] = BridgeHost.DiagSweepGatePolicyKey,
+        [AppSettings.SafReadDegreeKey] = BridgeHost.DiagSafReadDegreeKey,
+        [AppSettings.MaxParallelErbFilesKey] = BridgeHost.DiagMaxParallelErbFilesKey,
+        [AppSettings.DimLockPolicyKey] = BridgeHost.DiagDimLockPolicyKey,
+        [AppSettings.LazyFunctionLoadKey] = BridgeHost.PerfLazyFunctionLoadKey,
+        [AppSettings.IrDiskCacheLoadKey] = BridgeHost.PerfIrDiskCacheLoadKey,
+        [AppSettings.IrFirstDirListKey] = BridgeHost.PerfIrFirstDirListKey,
+        [AppSettings.IrFileListCacheKey] = BridgeHost.PerfIrFileListCacheKey,
+        [AppSettings.SrcContentCacheKey] = BridgeHost.PerfSrcContentCacheKey,
+        [AppSettings.ParallelErbLoadKey] = BridgeHost.PerfParallelErbLoadKey,
+        [AppSettings.ParallelParseScriptKey] = BridgeHost.PerfParallelParseScriptKey,
+    };
+
+    private static bool IsBoolKey(string key) => key == AppSettings.AgentLogEnabledKey;
+
+    public string? Get(string key)
+    {
+        if (!KeyMap.TryGetValue(key, out var prefKey))
+            return null;
+        try
+        {
+            // 契约：未设置返回 null（与 InMemory store 一致）——agentLog 的「仅显式设置时应用」
+            // 守卫依赖此语义（settingsReset 后未设置 → ApplyTo 不再干预）。
+            if (!Preferences.ContainsKey(prefKey))
+                return null;
+            return IsBoolKey(key)
+                ? (Preferences.Get(prefKey, false) ? "true" : "false")
+                : Preferences.Get(prefKey, "auto");
+        }
+        catch
+        {
+            return null;
+        }
+    }
+
+    public void Set(string key, string? value)
+    {
+        if (!KeyMap.TryGetValue(key, out var prefKey))
+            return;
+        try
+        {
+            if (value == null)
+            {
+                Preferences.Remove(prefKey);
+                return;
+            }
+            if (IsBoolKey(key))
+                Preferences.Set(prefKey, value == "true");
+            else
+                Preferences.Set(prefKey, value);
+        }
+        catch
+        {
+            // Preferences 不可用——仅持久化失败，运行时状态仍由 AppSettings 维护
+        }
+    }
+
+    public IEnumerable<KeyValuePair<string, string>> GetAll()
+    {
+        var dict = new Dictionary<string, string>(StringComparer.Ordinal);
+        foreach (var key in AppSettings.CanonicalKeys)
+        {
+            if (Get(key) is { } value)
+                dict[key] = value;
+        }
+        return dict;
+    }
+
+    public void Reset()
+    {
+        foreach (var prefKey in KeyMap.Values)
+        {
+            try
+            {
+                Preferences.Remove(prefKey);
+            }
+            catch
+            {
+                // Preferences 不可用——忽略
+            }
+        }
+    }
+}
