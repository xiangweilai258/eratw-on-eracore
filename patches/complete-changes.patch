+    [Fact]
+    public async Task Invalid_candidate_preserves_unset_current()
+    {
+        var previous = GamePaths.Current;
+        var registry = CreateRegistry();
+        try
+        {
+            GamePaths.SetCurrent(null!);
+            var result = await registry.ReplaceForLoadGameAsync(
+                Path.Combine(Path.GetTempPath(), "erarelay-missing-" + Guid.NewGuid().ToString("N")));
+            Assert.Equal(LoadGameStatus.PathError, result.Status);
+            Assert.Null(GamePaths.Current);
+            Assert.Null(registry.CurrentSession);
+        }
+        finally
+        {
+            registry.DisposeAll();
+            GamePaths.SetCurrent(previous);
+        }
+    }
+
+    [Fact]
+    public async Task Replacement_does_not_publish_candidate_until_old_loop_is_joined()
+    {
+        using var first = new Fixture();
+        using var second = new Fixture();
+        var previous = GamePaths.Current;
+        var oldPaths = GamePaths.Resolve(first.Root, new FileSystemGameDirAccessor());
+        var registry = CreateRegistry();
+        var old = new Session(new HttpSessionIO(new OutputHub()),
+            new SessionRegistryTests.NullTerminalSetup(), new ConfigData());
+        var canceled = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var release = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var cts = (CancellationTokenSource)GetField(typeof(Session), "_cts").GetValue(old)!;
+        using var registration = cts.Token.Register(() => canceled.TrySetResult());
+        // 注入受控旧循环：Dispose 已取消但 join 尚未完成时，可确定性检查共享路径。
+        var oldLoop = Task.Run(async () => await release.Task);
+        GetField(typeof(Session), "_gameTask").SetValue(old, oldLoop);
+        GetField(typeof(SessionRegistry), "_session").SetValue(registry, old);
+        Task<LoadGameResult>? replacement = null;
+        try
+        {
+            replacement = Task.Run(() => registry.ReplaceForLoadGameAsync(second.Root));
+            await canceled.Task.WaitAsync(TimeSpan.FromSeconds(10));
+            Assert.False(oldLoop.IsCompleted);
+            Assert.Same(oldPaths, GamePaths.Current);
+            release.TrySetResult();
+            var result = await replacement.WaitAsync(TimeSpan.FromSeconds(10));
+            Assert.Equal(LoadGameStatus.Success, result.Status);
+            Assert.Equal(Path.GetFullPath(second.Root) + Path.DirectorySeparatorChar, GamePaths.Current.ExeDir);
+            Assert.NotSame(old, registry.CurrentSession);
+        }
+        finally
+        {
+            release.TrySetResult();
+            if (replacement != null)
+                await replacement.WaitAsync(TimeSpan.FromSeconds(10));
+            registry.DisposeAll();
+            GamePaths.SetCurrent(previous);
+        }
+    }
