diff --git a/EraCore.Web/src/stores/__tests__/connection.test.ts b/EraCore.Web/src/stores/__tests__/connection.test.ts
index 22082b36..76f60a61 100644
--- a/EraCore.Web/src/stores/__tests__/connection.test.ts
+++ b/EraCore.Web/src/stores/__tests__/connection.test.ts
@@ -1028,3 +1028,161 @@ describe('useConnectionStore — issue 06 自动重连', () => {
     expect(conn.retryCount).toBe(0); // onopen 重置
   });
 });
+
+// ============================================================================
+// F2 · 连接代际隔离（第二批）
+//
+// 依据 会话可靠性审查记录「F2 · 旧 WebSocket 回调没有会话身份，
+// 能把新连接打成断开」：
+//   - 关闭回调不核对 socket 身份，直接清共享 ws、停控制监听、改状态；
+//   - 既有 FakeWebSocket 的 close 是同步回放，**测不到浏览器异步 closing 下旧事件迟到**。
+//
+// 本组用例补上那个缺口：让 A 的 close 事件在 B 已连上之后才到达。
+// 期望：旧代事件一律不影响新代状态。
+// ============================================================================
+describe('useConnectionStore — F2 连接代际隔离', () => {
+  let fetchSpy: ReturnType<typeof vi.spyOn>;
+  let originalWebSocket: typeof globalThis.WebSocket | undefined;
+
+  beforeEach(() => {
+    setActivePinia(createPinia());
+    fetchSpy = vi.spyOn(globalThis, 'fetch');
+    fetchSpy.mockImplementation(defaultFetchImpl());
+    originalWebSocket = globalThis.WebSocket;
+    FakeWebSocket.lastInstance = null;
+    FakeWebSocket.instances = [];
+    globalThis.WebSocket = FakeWebSocket as unknown as typeof globalThis.WebSocket;
+  });
+
+  afterEach(() => {
+    fetchSpy.mockRestore();
+    if (originalWebSocket === undefined) {
+      delete (globalThis as { WebSocket?: unknown }).WebSocket;
+    } else {
+      globalThis.WebSocket = originalWebSocket;
+    }
+  });
+
+  /** 建一条新连接并 onopen，返回该代 socket。 */
+  async function connectFreshSocket(): Promise<{
+    conn: ReturnType<typeof useConnectionStore>;
+    socket: FakeWebSocket;
+  }> {
+    const conn = useConnectionStore();
+    await conn.connect('ws://localhost:5173/ws');
+    const socket = FakeWebSocket.lastInstance;
+    expect(socket).not.toBeNull();
+    socket!.triggerOpen();
+    return { conn, socket: socket! };
+  }
+
+  it('★ 旧连接 A 的迟到 close（code=1000）不得把新连接 B 打成 disconnected', async () => {
+    // A 建立并连上
+    const { conn, socket: socketA } = await connectFreshSocket();
+    expect(conn.status).toBe('connected');
+
+    // A 主动断开 → 再建 B
+    conn.disconnect();
+    expect(conn.status).toBe('disconnected');
+
+    await conn.connect('ws://localhost:5173/ws');
+    const socketB = FakeWebSocket.lastInstance!;
+    expect(socketB).not.toBe(socketA); // 确实是新的一代
+    socketB.triggerOpen();
+    expect(conn.status).toBe('connected');
+
+    // ★ A 的 close 迟到——浏览器异步 closing 的真实形态
+    socketA.triggerClose(1000, 'A late normal close');
+
+    // ✓ 期望：B 仍是 connected（当前实现会变成 disconnected）
+    expect(conn.status).toBe('connected');
+  });
+
+  it('★ 旧连接 A 的迟到 close（异常码）不得触发 B 的重连调度', async () => {
+    const { conn, socket: socketA } = await connectFreshSocket();
+    conn.disconnect();
+
+    await conn.connect('ws://localhost:5173/ws');
+    const socketB = FakeWebSocket.lastInstance!;
+    socketB.triggerOpen();
+    expect(conn.status).toBe('connected');
+    const retryBefore = conn.retryCount;
+
+    // ★ A 的异常 close 迟到
+    socketA.triggerClose(4006, 'A late abnormal close');
+
+    // ✓ 期望：B 不受影响——不进入重连、重试计数不涨
+    expect(conn.status).toBe('connected');
+    expect(conn.retryCount).toBe(retryBefore);
+  });
+
+  it('★ 旧连接的迟到 close 不得把 closeReason 写到新连接上', async () => {
+    const { conn, socket: socketA } = await connectFreshSocket();
+    conn.disconnect();
+
+    await conn.connect('ws://localhost:5173/ws');
+    FakeWebSocket.lastInstance!.triggerOpen();
+    expect(conn.closeReason).toBeNull();
+
+    socketA.triggerClose(4006, 'A stale reason');
+
+    // ✓ 期望：新连接不该背上旧连接的断线原因
+    expect(conn.closeReason).not.toBe('A stale reason');
+  });
+
+  it('★ 旧连接 A 的迟到 snapshot 不得灌进新连接 B 的画面', async () => {
+    // 造一个"可手动放行"的 snapshot 响应：A 的那一次挂起，等 B 连上后再放行。
+    // ★ 这正是审查报告 F2 点名的同源窗口——只修 onclose 挡不住它。
+    let releaseA: (() => void) | null = null;
+    let snapshotCount = 0;
+
+    fetchSpy.mockImplementation(async (url: Parameters<typeof fetch>[0]) => {
+      const u = typeof url === 'string' ? url : url.toString();
+      if (u.endsWith('/session')) {
+        return new Response(JSON.stringify({ sessionId: 'abc', state: 'Idle' }), { status: 201 });
+      }
+      if (u.endsWith('/snapshot')) {
+        snapshotCount += 1;
+        if (snapshotCount === 1) {
+          // A 代的 snapshot——挂起，直到测试显式放行
+          await new Promise<void>((res) => { releaseA = res; });
+          return new Response(snapshotJson([{ entries: [{ segments: [{ text: 'A-MARKER' }] }], isLineEnd: true }]), { status: 200 });
+        }
+        return new Response(snapshotJson([{ entries: [{ segments: [{ text: 'B-MARKER' }] }], isLineEnd: true }]), { status: 200 });
+      }
+      return endControlWaitIfNeeded(u) ?? new Response('not found', { status: 404 });
+    });
+
+    const { useGameStore } = await import('../game');
+    const game = useGameStore();
+    const conn = useConnectionStore();
+
+    // A 建立 → onopen → 触发（挂起的）snapshot
+    await conn.connect('ws://localhost:5173/ws');
+    const socketA = FakeWebSocket.lastInstance!;
+    socketA.triggerOpen();
+    await vi.waitFor(() => expect(releaseA).not.toBeNull()); // 确认 A 的请求已发出并挂起
+
+    // A 断开 → B 建立并连上（B 的 snapshot 立即返回）
+    conn.disconnect();
+    await conn.connect('ws://localhost:5173/ws');
+    const socketB = FakeWebSocket.lastInstance!;
+    expect(socketB).not.toBe(socketA);
+    socketB.triggerOpen();
+    await vi.waitFor(() => {
+      const t = game.displayState.lines
+        .flatMap((l) => l.entries).flatMap((en) => en.segments ?? []).map((s) => s.text ?? '').join('');
+      expect(t).toContain('B-MARKER');
+    });
+
+    // ★ 放行 A 的迟到 snapshot——它 resolve 时已经是 B 代了
+    releaseA!();
+    await new Promise((r) => setTimeout(r, 30));
+
+    // ✓ 期望：A 的标记不得出现在画面上
+    const finalText = game.displayState.lines
+      .flatMap((l) => l.entries).flatMap((en) => en.segments ?? []).map((s) => s.text ?? '').join('');
+    expect(finalText).not.toContain('A-MARKER');
+    expect(finalText).toContain('B-MARKER');
+  });
+});
diff --git a/EraCore.Web/src/stores/__tests__/connectionEpoch.test.ts b/EraCore.Web/src/stores/__tests__/connectionEpoch.test.ts
new file mode 100644
index 00000000..9aa26d9f
--- /dev/null
+++ b/EraCore.Web/src/stores/__tests__/connectionEpoch.test.ts
@@ -0,0 +1,138 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { useGameStore } from '../game';
+import { useConnectionStore } from '../connection';
+
+/**
+ * ★★ R2 验收：连接终止必须**立即**使本代 token 失效。
+ *
+ * 依据 独立审阅 独立审阅报告 R2：原实现只在「下一次 connectInternal 开始」时递增 epoch，
+ * 于是存在一个真实窗口——**断开后、下一条连接建立之前**，本代的迟到事件仍然有效。
+ *
+ * ★ 与既有 connection.test.ts 的 F2 组区别：
+ *   F2 组覆盖「旧代 vs **已建立的新代**」；本组覆盖「旧代 vs **尚未建立任何新代**」——
+ *   后者正是原实现漏掉的那一段。
+ *
+ * ★ 用例与 独立审阅 的仓库外探针等价，但落在批准路径内、随主程回归一起跑。
+ */
+const lines = (text: string) => [{ entries: [{ segments: [{ text }] }], isLineEnd: true }];
+const snap = (seq: number, session = 'S1', text = 'X', generation = 20) => ({
+  lines: lines(text), state: 'WaitInput', inputType: 'IntValue', needValue: true,
+  protocolVersion: 14, generation, displaySeq: seq, sessionId: session,
+});
+const textOf = (g: ReturnType<typeof useGameStore>) =>
+  g.displayState.lines.flatMap((l) => l.entries).flatMap((e) => e.segments ?? []).map((s) => s.text ?? '').join('');
+
+async function flush() { for (let i = 0; i < 25; i++) await Promise.resolve(); }
+
+/** 故意保留迟到事件的假 socket——模拟浏览器异步关闭。 */
+class Socket {
+  static all: Socket[] = [];
+  onopen: ((...a: unknown[]) => void) | null = null;
+  onclose: ((...a: unknown[]) => void) | null = null;
+  onerror: ((...a: unknown[]) => void) | null = null;
+  onmessage: ((...a: unknown[]) => void) | null = null;
+  constructor(public url: string) { Socket.all.push(this); }
+  close() { /* ★ 不触发 onclose：迟到事件由测试显式驱动 */ }
+  send() { /* noop */ }
+}
+
+let conn: ReturnType<typeof useConnectionStore> | null = null;
+
+describe('R2 · 连接终止即失效旧代（断开与异常关闭后）', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia());
+    Socket.all = [];
+    conn = null;
+    vi.stubGlobal('WebSocket', Socket as unknown as typeof globalThis.WebSocket);
+  });
+  afterEach(() => {
+    conn?.disconnect();
+    useGameStore().reset();
+    vi.unstubAllGlobals();
+    vi.restoreAllMocks();
+  });
+
+  it('★ 主动断开后（尚未建立 B）放行 A 的在途快照 ⇒ 旧画面不得复活', async () => {
+    let resolve!: (r: Response) => void;
+    const pending = new Promise<Response>((r) => { resolve = r; });
+    vi.stubGlobal('fetch', vi.fn((url: string) => {
+      if (url.endsWith('/session')) return Promise.resolve(new Response('', { status: 201 }));
+      if (url.endsWith('/snapshot')) return pending;
+      if (url.endsWith('/control/wait')) return new Promise<Response>(() => { /* 长轮询保持挂起 */ });
+      return Promise.resolve(new Response(JSON.stringify({ state: 'idle', controller: null }), { status: 200 }));
+    }));
+
+    conn = useConnectionStore();
+    await conn.connect('ws://review/ws');
+    Socket.all[0].onopen!();
+    await flush();               // ★ A 的 GET /snapshot 已发出并挂起
+
+    conn.disconnect();            // 主动断开
+    const g = useGameStore();
+    g.reset();                    // 画面已清空
+
+    resolve(new Response(JSON.stringify(snap(2, 'OLD', 'OLD'))));   // ★ 迟到放行
+    await flush();
+
+    // ★ 原实现：OLD 被灌回空画面 → 这条曾失败
+    expect(textOf(g)).toBe('');
+  });
+
+  it('★ 异常关闭后的退避窗口内，本代在途快照同样不得生效', async () => {
+    let resolve!: (r: Response) => void;
+    const pending = new Promise<Response>((r) => { resolve = r; });
+    vi.stubGlobal('fetch', vi.fn((url: string) => {
+      if (url.endsWith('/session')) return Promise.resolve(new Response('', { status: 201 }));
+      if (url.endsWith('/snapshot')) return pending;
+      if (url.endsWith('/control/wait')) return new Promise<Response>(() => { /* 挂起 */ });
+      return Promise.resolve(new Response(JSON.stringify({ state: 'idle', controller: null }), { status: 200 }));
+    }));
+    vi.useFakeTimers({ shouldAdvanceTime: true });
+
+    try {
+      conn = useConnectionStore();
+      await conn.connect('ws://review/ws');
+      const socketA = Socket.all[0];
+      socketA.onopen!();
+      await flush();
+
+      // 异常关闭（非 1000）⇒ 进入退避重连，但**新连接尚未建立**
+      socketA.onclose!({ code: 4006, reason: 'drop' });
+      expect(conn.status).toBe('reconnecting');
+
+      const g = useGameStore();
+      g.reset();
+
+      resolve(new Response(JSON.stringify(snap(2, 'OLD', 'OLD'))));   // ★ 迟到放行
+      await flush();
+
+      expect(textOf(g)).toBe('');
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('★ 断开后旧代的失败分支不得写入新状态的 closeReason', async () => {
+    let reject!: (e: unknown) => void;
+    const pending = new Promise<Response>((_, rj) => { reject = rj; });
+    vi.stubGlobal('fetch', vi.fn((url: string) => {
+      if (url.endsWith('/session')) return Promise.resolve(new Response('', { status: 201 }));
+      if (url.endsWith('/snapshot')) return pending;
+      if (url.endsWith('/control/wait')) return new Promise<Response>(() => { /* 挂起 */ });
+      return Promise.resolve(new Response(JSON.stringify({ state: 'idle', controller: null }), { status: 200 }));
+    }));
+
+    conn = useConnectionStore();
+    await conn.connect('ws://review/ws');
+    Socket.all[0].onopen!();
+    await flush();
+
+    conn.disconnect();
+    reject(new Error('A 失败原因'));     // ★ 迟到的失败
+    await flush();
+
+    // ★ closeReason 此刻应仍为 null（断开时清空后未被旧代失败覆盖）
+    expect(conn.closeReason ?? '').not.toContain('A 失败原因');
+  });
+});
