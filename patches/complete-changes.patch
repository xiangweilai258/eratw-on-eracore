+<script setup lang="ts">
+/**
+ * AboutView —— 「关于」页（2026-10-08 要求）。
+ *
+ * ★ 为什么需要它：这是**给别人用的必备件** —— 别人打开总得知道
+ *   ① 这软件是什么、什么版本 ② 从哪来的 ③ 引擎是谁的功劳 ④ 游戏本体为什么不在里面。
+ *   ★ 其中「引擎署名」与「游戏本体免责」还是**合规必需**。
+ *
+ * ★ 版本号来源（★ 关键）：**不在这里写死**。构建时由 `vite.config.ts` 通过
+ *   `define` 把 `APP_VERSION` 环境变量注入为 `__APP_VERSION__`；
+ *   出包脚本从 `EraCore.Maui.csproj` 的 `ApplicationDisplayVersion` 取值传进来。
+ *   ★ 这样界面上的版本**永远等于 APK 的真实版本**，不会出现"包里 0.4.3、界面写 0.4.2"。
+ */
+import { computed } from 'vue';
+import { useUiStore } from '../stores/ui';
+
+const ui = useUiStore();
+
+/** 构建期注入的产品版本（见文件头说明）；本地 dev 下会是 'dev'。 */
+declare const __APP_VERSION__: string;
+const appVersion = computed<string>(() => {
+  try {
+    return typeof __APP_VERSION__ === 'string' && __APP_VERSION__ ? __APP_VERSION__ : 'dev';
+  } catch {
+    // 未注入（例如某些测试环境）——不让它把页面搞崩
+    return 'dev';
+  }
+});
+
+/** MAUI 还是浏览器？决定要不要显示"技术信息"里的宿主行。 */
+const isMaui = computed<boolean>(() => {
+  if (typeof window === 'undefined') return false;
+  const { protocol, hostname } = window.location;
+  return protocol === 'ms-appx-web:' || protocol === 'file:'
+    || (protocol === 'https:' && (hostname === 'app.local' || hostname === 'game.local'));
+});
+
+/** 运行宿主描述——出问题时这个比版本号更有用。 */
+const hostText = computed<string>(() => {
+  if (typeof navigator === 'undefined') return '未知';
+  const ua = navigator.userAgent;
+  if (/Android/i.test(ua)) {
+    const m = /Android\s+([\d.]+)/i.exec(ua);
+    return m ? `Android ${m[1]}` : 'Android';
+  }
+  if (/Windows/i.test(ua)) return 'Windows';
+  return '浏览器';
+});
+
+const REPO_URL = 'https://github.com/xiangweilai258/eratw-on-eracore';
+const RELEASES_URL = `${REPO_URL}/releases`;
+const UPSTREAM_URL = 'https://github.com/LaoBro/era-core';
+
+function goBack(): void {
+  ui.switchView('terminal');
+}
+</script>
