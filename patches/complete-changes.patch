+			// Opt 为 null（调用方未给第二参数）时短路，不去读 ConstInt。
+			if (arg.IsConst) exm.Console.PrintHtml(PadForPrintC(arg.ConstStr), arg.Opt == null || arg.ConstInt != 0);
