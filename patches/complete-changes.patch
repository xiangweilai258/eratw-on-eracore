+// @vitest-environment happy-dom
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { mount } from '@vue/test-utils';
+import { createPinia, setActivePinia } from 'pinia';
+import TerminalDisplay from '../TerminalDisplay.vue';
+import { useGameStore } from '../../stores/game';
+import { useConnectionStore } from '../../stores/connection';
+import type { ButtonRef, DisplayEntry, DisplayLine, PrintSegment } from '../../types/protocol';
+
+/**
+ * TerminalDisplay「按字符列摆放」组件级测试（2026-10-09）。
+ *
+ * 被测行为：含按钮的行改走 CSS grid（`.term-grid` + `grid-template-columns: repeat(N, 1ch)`），
+ * 每个条目用 `grid-column: <col+1> / span <width>` 按引擎给的字符列绝对值落位。
+ *
+ * 为什么单独一个文件：`TerminalDisplay.test.ts` 聚焦图片/掩膜/背景图层，本文件只钉
+ * 「列位几何」——两者夹具形状完全不同，混在一起会让列位断言淹没在图片夹具里。
+ *
+ * ★ 夹具刻意贴真实形状：
+ *   - 用例 1/2：任务描述的「同一行 3 个按钮，col 0/28/56，width 16/20/12」。
+ *   - 用例 4/5：eraTW 的 OPTION 设定页真实行（`ERB/DLC/OPTIONPRINT.ERB:116/135/136`）——
+ *     同一逻辑行里先是非按钮文本（`%ARGS, 20%：` = 21 列宽 + `%LOCALS, 25, LEFT%` = 25 列宽），
+ *     再是按钮 `[ 1] xxx设置`（引擎 col=46）。这是「行内混有非按钮条目」的真实形状。
+ *
+ * 虚拟滚动 / 捏合缩放 / 资源解析都 mock 掉——列的摆放与被切片、手势、图片 URL 无关。
+ */
+
+vi.mock('../../lib/mauiBridge', () => ({
+  isMauiEnvironment: () => true,
+}));
+
+vi.mock('../../lib/resourceResolver', () => ({
+  resolveResource: (path: string) => `/assets/${path}`,
+}));
+
+vi.mock('../../composables/useVirtualScroll', () => ({
+  useVirtualScroll: () => ({
+    startIndex: { value: 0 },
+    endIndex: { value: 200 },
+    totalHeight: { value: 1900 },
+    offsetY: { value: 0 },
+    isStickyToBottom: { value: true },
+    adjustScrollTop: vi.fn(),
+    scrollToBottom: vi.fn(),
+  }),
+}));
+
+vi.mock('../../composables/usePinchZoom', () => ({
+  usePinchZoom: () => {},
+}));
+
+// ---------- 夹具 ----------
+
+function seg(text: string): PrintSegment {
+  return { text };
+}
+
+function textEntry(text: string): DisplayEntry {
+  return { segments: [seg(text)] };
+}
+
+function btnEntry(text: string, value: number, col?: number | null, width?: number | null): DisplayEntry {
+  const button: ButtonRef = { value, isInteger: true, generation: 0 };
+  if (col !== undefined) button.col = col;
+  if (width !== undefined) button.width = width;
+  return { segments: [seg(text)], button };
+}
+
+function line(entries: DisplayEntry[], align: DisplayLine['align'] = 'left'): DisplayLine {
+  return { entries, align, isLineEnd: true };
+}
+
+/** 用半角空格把一段文本补齐到指定显示列数（夹具专用——ERB 侧的 `%STR, N%` 就是这个语义：
+ *  按**显示宽度**补齐，见 EraCore.Core/Shared/Runtime/Script/Data/StrForm.cs:272-281）。 */
+function padTo(text: string, cols: number): string {
+  let w = 0;
+  for (const ch of text) w += ch.charCodeAt(0) >= 0x2e80 ? 2 : 1;
+  return text + ' '.repeat(Math.max(0, cols - w));
+}
+
+function mountLines(lines: DisplayLine[]) {
+  const pinia = createPinia();
+  setActivePinia(pinia);
+  const game = useGameStore();
+  const conn = useConnectionStore();
+  conn.status = 'connected';
+  conn.sendInput = vi.fn();
+  game.displayState = {
+    ...game.displayState,
+    lines,
+    bgImages: [],
+    state: 'WaitInput',
+    inputType: 'IntValue',
+  };
+  game.currentTurnGeneration = 0;
+  const wrapper = mount(TerminalDisplay, { global: { plugins: [pinia] } });
+  return { wrapper, game, conn };
+}
+
+/** 取一个元素的内联 style 字符串（happy-dom 不做样式计算，只能读内联）。 */
+function styleOf(el: { attributes: (n: string) => string | undefined }): string {
+  return el.attributes('style') ?? '';
+}
+
+// ---------- 任务指定形状：同一行 3 个按钮 ----------
+
+describe('TerminalDisplay 列位：同一行 3 个按钮（col 0/28/56，width 16/20/12）', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it('每个按钮的 grid-column 等于引擎 col+1 / span width', () => {
+    const { wrapper } = mountLines([
+      line([
+        btnEntry('[100] 睁开眼睛   ', 100, 0, 16),
+        btnEntry('[102] 居住环境设定', 102, 28, 20),
+        btnEntry('[120] 搬家        ', 120, 56, 12),
+      ]),
+    ]);
+
+    const btns = wrapper.findAll('.term-btn');
+    expect(btns).toHaveLength(3);
+    // 引擎列 0 基 → CSS grid 1 基
+    expect(styleOf(btns[0])).toContain('grid-column: 1 / span 16');
+    expect(styleOf(btns[1])).toContain('grid-column: 29 / span 20');
+    expect(styleOf(btns[2])).toContain('grid-column: 57 / span 12');
+  });
+
+  it('行容器是 grid，列数=最右端（56+12=68），列宽 1ch', () => {
+    const { wrapper } = mountLines([
+      line([
+        btnEntry('[100] 睁开眼睛   ', 100, 0, 16),
+        btnEntry('[102] 居住环境设定', 102, 28, 20),
+        btnEntry('[120] 搬家        ', 120, 56, 12),
+      ]),
+    ]);
+
+    const row = wrapper.find('.term-line');
+    expect(row.classes()).toContain('term-grid');
+    const style = styleOf(row);
+    expect(style).toContain('display: grid');
+    expect(style).toContain('grid-template-columns: repeat(68, 1ch)');
+  });
+});
+
+// ---------- ★ 纵向对齐判据 ----------
+
+describe('TerminalDisplay 列位：纵向对齐（同一逻辑列跨行重合）', () => {
+  it('两行按钮宽度不同，但同一列得到同一 grid-column', () => {
+    const { wrapper } = mountLines([
+      // 第一行：按钮实际宽度 16/20/12
+      line([
+        btnEntry('a', 1, 0, 16),
+        btnEntry('b', 2, 28, 20),
+        btnEntry('c', 3, 56, 12),
+      ]),
+      // 第二行：按钮宽度 18/18/16，引擎列位不变
+      line([
+        btnEntry('d', 4, 0, 18),
+        btnEntry('e', 5, 28, 18),
+        btnEntry('f', 6, 56, 16),
+      ]),
+    ]);
+
+    const rows = wrapper.findAll('.term-line');
+    const rowA = rows[0].findAll('.term-btn').map((b) => styleOf(b));
+    const rowB = rows[1].findAll('.term-btn').map((b) => styleOf(b));
+
+    expect(rowA[0]).toContain('grid-column: 1 / span 16');
+    expect(rowA[1]).toContain('grid-column: 29 / span 20');
+    expect(rowA[2]).toContain('grid-column: 57 / span 12');
+    // ★ 纵向对齐的判据：起始列（`<start>`）跨行相等，与自身 width 无关
+    expect(rowB[0]).toContain('grid-column: 1 / ');
+    expect(rowB[1]).toContain('grid-column: 29 / ');
+    expect(rowB[2]).toContain('grid-column: 57 / ');
+  });
+});
+
+// ---------- eraTW OPTION 设定页的真实行形状 ----------
+
+describe('TerminalDisplay 列位：eraTW OPTION 行的真实形状（文本在前 + 按钮在后）', () => {
+  it('前导文本条目也按列落位，按钮落在引擎 col=47', () => {
+    // 真实来源 ERB/DLC/OPTIONPRINT.ERB:116/135/136：
+    //   PRINTFORM %ARGS, 20%：             → 名称补齐到 20 列 + 全角冒号 = 22 列
+    //   CALL COLORMESSAGE(@"%LOCALS, 25, LEFT%") → 状态补齐到 25 列
+    //   CALL COLORMESSAGE(@"[{ARG,2,RIGHT}] %ARGS%设置", color, 1) → 按钮，引擎 col = 22+25 = 47
+    const namePart = `${padTo('丰富的神签', 20)}：`; // 20 + 2(全角冒号) = 22 列
+    const statusPart = padTo('已启动', 25); // 25 列
+    const btnText = '[ 1] 丰富的神签设置'; // 19 列
+    const { wrapper } = mountLines([
+      line([textEntry(namePart), textEntry(statusPart), btnEntry(btnText, 1, 47, 19)]),
+    ]);
+
+    const spans = wrapper.findAll('.term-entry');
+    expect(spans).toHaveLength(2);
+    expect(styleOf(spans[0])).toContain('grid-column: 1 / span 22');
+    expect(styleOf(spans[1])).toContain('grid-column: 23 / span 25');
+
+    const btn = wrapper.find('.term-btn');
+    expect(styleOf(btn)).toContain('grid-column: 48 / span 19');
+
+    // 行网格列数 = 47 + 19 = 66
+    expect(styleOf(wrapper.find('.term-line'))).toContain('grid-template-columns: repeat(66, 1ch)');
+  });
+
+  it('两行 OPTION 行的按钮落在同一列（纵向对齐判据）', () => {
+    const btn1 = '[ 1] 丰富的神签设置';
+    const btn2 = '[ 2] 防寒靴设置　　';
+    const { wrapper } = mountLines([
+      line([textEntry(`${padTo('丰富的神签', 20)}：`), textEntry(padTo('已启动', 25)), btnEntry(btn1, 1, 47, 19)]),
+      line([textEntry(`${padTo('防袭击', 20)}：`), textEntry(padTo('未启动', 25)), btnEntry(btn2, 2, 47, 19)]),
+    ]);
+
+    const rows = wrapper.findAll('.term-line');
+    expect(styleOf(rows[0].findAll('.term-btn')[0])).toContain('grid-column: 48 / span 19');
+    expect(styleOf(rows[1].findAll('.term-btn')[0])).toContain('grid-column: 48 / span 19');
+  });
+
+  it('★ 特征化：引擎 col 漏算前导占位时，按钮与前导条目在同一网格列重叠', () => {
+    // 这是「记录现状」而非「期望行为」——见报告根因②：
+    // C# ConsolePrintManager.BuildPrintOpsForLine 的 column 累加用 btn.ToString()，
+    // 而 ConsoleSpacePart（HTML_PRINT <shape type='space'>）的 Text 恒为 ""（ConsoleShapePart.cs:176），
+    // 于是引擎给出的 col 不含该段占位宽度；前端 PrintSegment.text 却是 N 个空格（ConsolePrintManager.cs:706），
+    // 前端把非按钮条目摆在 col 0/width 25，按钮也被摆在 col 0 → 两者网格列重叠（后者盖前者）。
+    const { wrapper } = mountLines([
+      line([textEntry('                         '), btnEntry('[1] 立绘', 1, 0, 6)]),
+    ]);
+
+    const spanStyle = styleOf(wrapper.find('.term-entry'));
+    const btnStyle = styleOf(wrapper.find('.term-btn'));
+    expect(spanStyle).toContain('grid-column: 1 / span 25');
+    expect(btnStyle).toContain('grid-column: 1 / span 6'); // ← 与文本段同一起始列 = 重叠
+  });
+});
+
+// ---------- 回落路径与边界 ----------
+
+describe('TerminalDisplay 列位：回落与边界', () => {
+  it('纯文本行不走 grid（保持原流式排列，避免影响字符画）', () => {
+    const { wrapper } = mountLines([line([textEntry('  ────────  '), textEntry('标题')])]);
+
+    const row = wrapper.find('.term-line');
+    expect(row.classes()).not.toContain('term-grid');
+    expect(styleOf(row)).not.toContain('display: grid');
+    expect(styleOf(row)).toContain('text-align: left');
+    // 纯文本行的条目不带 grid-column
+    expect(styleOf(wrapper.findAll('.term-entry')[0])).not.toContain('grid-column');
+  });
+
+  it('按钮缺 col/width（老帧）时回落到「前一条目末尾」的游标累加', () => {
+    // col/width 是 nullable（protocol.ts:144-145，C# WhenWritingNull 时字段缺失）——
+    // 回落路径下按钮列位由前端自己算，与引擎的字符列口径未必一致。
+    const { wrapper } = mountLines([line([textEntry('abcd'), btnEntry('[x]', 9)] as DisplayEntry[])]);
+
+    const btn = wrapper.find('.term-btn');
+    expect(styleOf(btn)).toContain('grid-column: 5 / span 3'); // cursor=4 → 1 基第 5 列；width 取段落宽 3
+  });
+
+  it('width=0 的按钮至少占 1 格（span 不会为 0）', () => {
+    const { wrapper } = mountLines([line([btnEntry('', 7, 12, 0)])]);
+    expect(styleOf(wrapper.find('.term-btn'))).toContain('grid-column: 13 / span 1');
+  });
+
+  it('★ center 对齐的行：网格整体居中（justify-content: center）', () => {
+    // 此处原为特征化测试，记录修复前的缺陷：lineGridStyle 只把 align 写进 text-align，
+    // 而 text-align 只作用于 grid item 内部的 inline 内容，网格轨道仍从左侧排
+    // ⇒ 居中的按钮行整体靠左（实测 left=98.91px，对照流式居中 324.2px）。
+    // 修复后网格整体落位交给 justify-content，故断言反转为「必须有居中手段」。
+    const { wrapper } = mountLines([line([btnEntry('[0] 开始', 0, 20, 12)], 'center')]);
+    const style = styleOf(wrapper.find('.term-line'));
+    expect(style).toContain('display: grid');
+    expect(style).toContain('justify-content: center');
+  });
+
+  it('★ 左对齐行从左侧起排、右对齐行靠右', () => {
+    const left = mountLines([line([btnEntry('[0]', 0, 10, 5)], 'left')]);
+    expect(styleOf(left.wrapper.find('.term-line'))).toContain('justify-content: start');
+
+    const right = mountLines([line([btnEntry('[0]', 0, 10, 5)], 'right')]);
+    expect(styleOf(right.wrapper.find('.term-line'))).toContain('justify-content: end');
+  });
+
+  it('★ 纯文本行不注入 justify-content（仍走流式排列）', () => {
+    const { wrapper } = mountLines([line([textEntry('普通文本')], 'center')]);
+    expect(styleOf(wrapper.find('.term-line'))).not.toContain('justify-content');
+  });
+});
