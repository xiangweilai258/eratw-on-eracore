+/** 区间增量帧（对齐 独立审阅 探针形状）。 */
+const turn = (base: number, end: number, session = 'S1', text = 'XY', state = 'WaitInput') => JSON.stringify({
+  state, inputType: 'IntValue', needValue: true, generation: 21, sessionId: session,
+  baseDisplaySeq: base, displaySeq: end, stateSeq: end,
+  diff: { lineOps: [{ type: 'append', newLines: lines(text) }], baseDisplaySeq: base, displaySeq: end },
+});
+const texts = (g: ReturnType<typeof useGameStore>) =>
+  g.displayState.lines.flatMap((l) => l.entries).flatMap((e) => e.segments ?? []).map((s) => s.text ?? '').join('');
+
+let conn: ReturnType<typeof useConnectionStore> | null = null;
