+import { createPinia, setActivePinia } from 'pinia';
+import InputBar from '../InputBar.vue';
+import { useGameStore } from '../../stores/game';
+
+/**
+ * InputBar 组件测试——聚焦 2026-10-07 的兜底分支改动。
+ *
+ * C# `InputType` 共九种，而 InputBar 原先只显式分支了五种
+ * （`IntValue`/`StrValue`/`AnyValue` → 输入框；`AnyKey`/`EnterKey` → 提示行），
+ * 余下四种全部落进 `else`，并把 **C# 枚举名直接渲染给用户**
+ * （如「未知输入类型：PrimitiveMouseKey」）。
+ *
+ * 现改为「等待中…」，且**任何分支都不得把枚举名暴露到界面上**——那对玩家没有意义。
+ *
+ * 落进兜底的四种及其真实语义：
+ * - `Void`            → 「不能输入，只能等」（宏执行中 / skip 中）
+ * - `IntButton`       → 值由**屏幕上的按钮**给出，不需要打字
+ * - `StrButton`       → 同上
+ * - `PrimitiveMouseKey` → 鼠标键输入（eraTW 未使用）
+ */
+
+/** 构造一个 append diff 帧（与 game.test.ts 同形的最小版）。 */
+function frame(inputType: string | null, state = 'WaitInput'): string {
+  return JSON.stringify({
+    state,
+    inputType,
+    needValue: false,
+    generation: 0,
+    diff: {
+      lineOps: [
+        {
+          type: 'append',
+          newLines: [{ entries: [{ segments: [{ text: 'x' }] }], isLineEnd: true }],
+        },
+      ],
+    },
+  });
+}
+
+function mountWithInputType(inputType: string | null) {
+  setActivePinia(createPinia());
+  const game = useGameStore();
+  game.applyTurn(frame(inputType));
+  return mount(InputBar);
+}
+
+describe('InputBar - inputType 分支渲染', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia());
+  });
+
+  it('★ 兜底四种类型 → 显示「等待中…」，且不把 C# 枚举名泄露到界面', () => {
+    for (const t of ['Void', 'IntButton', 'StrButton', 'PrimitiveMouseKey']) {
+      const w = mountWithInputType(t);
+      const text = w.text();
+
+      expect(text).toContain('等待中…');
+      // ★ 关键断言：枚举名不得出现在界面上（改动前这里会渲染「未知输入类型：Void」等）
+      expect(text).not.toContain(t);
+      expect(text).not.toContain('未知输入类型');
+    }
+  });
+
+  it('StrValue → 渲染文本框 + 「发送」按钮，inputmode=text', () => {
+    const w = mountWithInputType('StrValue');
+
+    expect(w.find('input.text-input').exists()).toBe(true);
+    expect(w.find('input.text-input').attributes('inputmode')).toBe('text');
+    expect(w.find('button.submit-btn').text()).toBe('发送');
+  });
+
+  it('IntValue → inputmode=numeric（提示移动端弹数字键盘）', () => {
+    const w = mountWithInputType('IntValue');
+
+    expect(w.find('input.text-input').attributes('inputmode')).toBe('numeric');
+  });
+
+  it('AnyValue → 同样渲染文本框', () => {
+    const w = mountWithInputType('AnyValue');
+
+    expect(w.find('input.text-input').exists()).toBe(true);
+  });
+
+  it('AnyKey → 「按任意键继续」+ 「继续」按钮，不渲染空输入框', () => {
+    const w = mountWithInputType('AnyKey');
+
+    expect(w.text()).toContain('按任意键继续');
+    expect(w.find('button.submit-btn').text()).toBe('继续');
+    expect(w.find('input.text-input').exists()).toBe(false);
+  });
+
+  it('EnterKey → 「按回车继续」+ 「继续」按钮，不渲染空输入框', () => {
+    const w = mountWithInputType('EnterKey');
+
+    expect(w.text()).toContain('按回车继续');
+    expect(w.find('button.submit-btn').text()).toBe('继续');
+    expect(w.find('input.text-input').exists()).toBe(false);
+  });
+
+  it('inputType 为 null（WaitInput 但协议未给类型）→ 走兜底，显示「等待中…」', () => {
+    const w = mountWithInputType(null);
+
+    expect(w.text()).toContain('等待中…');
+  });
+});
