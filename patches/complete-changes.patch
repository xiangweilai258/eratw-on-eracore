+// @vitest-environment happy-dom
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+import { mount, type VueWrapper } from '@vue/test-utils';
+import { setActivePinia, createPinia } from 'pinia';
+import OnboardingDialog from '../OnboardingDialog.vue';
+import GameLibraryView from '../GameLibraryView.vue';
+import { useGameStore } from '../../stores/game';
+import type { GameLibrarySource } from '../../lib/gameLibrary';
+
+/**
+ * 2026-10-14 引导对齐（用户批准的最小修正）：
+ * 应用内引导必须表达真实扫描规则——玩家选的是「装着各个游戏文件夹的父目录」，
+ * 扫描器识别其中下一层包含 CSV/ERB 的游戏文件夹。
+ *
+ * 用真实组件渲染检查文案与结构，不做源码字符串搜索；
+ * 同时验证原有交互（关闭引导、空态按钮、扫描/列表切换）未改变。
+ */
+
+/** 挂载引导弹层并取出目录示意 <pre> 的逐行文本。 */
+function mountOnboarding(): VueWrapper<any> {
+  return mount(OnboardingDialog);
+}
+
+describe('OnboardingDialog · 目录示意与扫描规则对齐', () => {
+  it('「选择这一层」标记在父目录行（emuera），不在游戏文件夹行', () => {
+    const wrapper = mountOnboarding();
+    const lines = wrapper.find('pre.ob-code').text().split('\n');
+
+    const emueraLine = lines.find((l) => l.includes('emuera/'));
+    expect(emueraLine, 'emuera 行应存在').toBeTruthy();
+    expect(emueraLine!).toContain('选目录时选到【这一层】');
+
+    const gameLine = lines.find((l) => l.includes('你的游戏/'));
+    expect(gameLine, '游戏文件夹行应存在').toBeTruthy();
+    expect(gameLine!).not.toContain('【这一层】');
+  });
+
+  it('示意图展示「下一层含 ERB/、CSV/ 子目录」，散文行说明游戏文件夹要求', () => {
+    const wrapper = mountOnboarding();
+    const lines = wrapper.find('pre.ob-code').text().split('\n');
+    const erdIdx = lines.findIndex((l) => l.includes('ERB/'));
+    const csvIdx = lines.findIndex((l) => l.includes('CSV/'));
+    const gameIdx = lines.findIndex((l) => l.includes('你的游戏/'));
+    expect(erdIdx).toBeGreaterThan(gameIdx);
+    expect(csvIdx).toBeGreaterThan(erdIdx);
+    // ERB、CSV 是缩进的子目录行
+    expect(lines[erdIdx]!.startsWith('    ')).toBe(true);
+    expect(lines[csvIdx]!.startsWith('    ')).toBe(true);
+
+    // 「每个游戏文件夹（内含 ERB、CSV）」由图下散文行交代
+    const sec2 = wrapper.findAll('.ob-sec')[1]!;
+    expect(sec2.text()).toContain('每个游戏文件夹');
+    expect(sec2.text()).toContain('内含 ERB、CSV');
+    expect(sec2.text()).toContain('不是游戏文件夹本身');
+  });
+
+  it('emuera 表达为示例名而非强制目录名', () => {
+    const wrapper = mountOnboarding();
+    const sec2 = wrapper.findAll('.ob-sec')[1]!;
+    expect(sec2.text()).toContain('名字随意');
+  });
+
+  it('原有三段结构与关闭交互不变', async () => {
+    const wrapper = mountOnboarding();
+    const sections = wrapper.findAll('.ob-sec');
+    expect(sections.length).toBe(3);
+    expect(sections[0]!.text()).toContain('先找到一款游戏');
+    expect(sections[1]!.text()).toContain('把游戏放进设备');
+    expect(sections[2]!.text()).toContain('怎么玩');
+
+    const okBtn = wrapper.find('.ob-ok');
+    expect(okBtn.text()).toBe('知道了，开始吧');
+    await okBtn.trigger('click');
+    expect(wrapper.emitted('close')).toHaveLength(1);
