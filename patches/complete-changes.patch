@@ -0,0 +1,232 @@
+// @vitest-environment happy-dom
+import { describe, it, expect, beforeEach, vi } from 'vitest';
+import { mount } from '@vue/test-utils';
+import { createPinia, setActivePinia } from 'pinia';
+import TerminalView from '../TerminalView.vue';
+import { useGameStore } from '../../stores/game';
+import { useUiStore } from '../../stores/ui';
+
+/**
+ * TerminalView 组件测试——聚焦 2026-10-07 的两项行为变更：
+ *
+ * ① ★ **输入栏取消自动弹出**：原逻辑 `!hasActiveButtons` 会在"本回合无可用按钮"时
+ *    自动弹出输入栏，把悬浮层盖在终端末尾；而 **Emuera 的当前有效选项恰恰打印在输出末尾**
+ *    —— 实测「是/否」被输入框压住 → 用户点不到唯一能推进的输入 → 判定"卡死"。
+ *    改后：输入栏**只在用户手动唤出（⌨）时出现**。
+ *
+ * ② ★ **AnyKey/EnterKey 改由 `.overlay-hint` 细提示承载**：输入栏不再自动弹后，
+ *    原本挂在 InputBar 里的「按任意键继续」会一并消失；全局 click 监听仍在，
+ *    功能没坏但用户不知道该点，故补一条常驻细提示。
+ *
+ * 子组件一律 stub：本测试只驱动 TerminalView 自身的显隐判定，与子组件内部实现解耦。
+ */
+
+vi.mock('../../lib/mauiBridge', () => ({
+  isMauiEnvironment: () => true,
+}));
+
+// ---------- 夹具 ----------
+
+/** 构造一个 append diff 帧（与 game.test.ts 的 appendFrameJson 同形，此处按需重建最小版）。 */
+function frame(inputType: string | null, state = 'WaitInput'): string {
+  return JSON.stringify({
+    state,
+    inputType,
+    needValue: false,
+    generation: 0,
+    diff: {
+      lineOps: [
+        {
+          type: 'append',
+          newLines: [{ entries: [{ segments: [{ text: 'x' }] }], isLineEnd: true }],
+        },
+      ],
+    },
+  });
+}
+
+/** 构造一个「本回合含可用按钮」的帧——按钮 generation 与 generation 一致才计为可用。 */
+function frameWithActiveButton(
+  inputType: string | null,
+  state = 'WaitInput',
+  needValue = false,
+): string {
+  return JSON.stringify({
+    state,
+    inputType,
+    needValue,
+    generation: 0,
+    diff: {
+      lineOps: [
+        {
+          type: 'append',
+          newLines: [
+            {
+              entries: [
+                {
+                  segments: [{ text: '[0] 是' }],
+                  button: { value: 0, isInteger: true, col: 0, width: 4, generation: 0 },
+                },
+              ],
+              isLineEnd: true,
+            },
+          ],
+        },
+      ],
+    },
+  });
+}
+
+const STUBS = {
+  TerminalDisplay: true,
+  InputBar: { template: '<div class="stub-input-bar" />' },
+  TinputCountdown: true,
+  StatusBanner: true,
+  SpectatorBanner: true,
+};
+
+function mountView() {
+  return mount(TerminalView, { global: { stubs: STUBS } });
+}
+
+// ---------- 输入栏可见性 ----------
+
+describe('TerminalView - 输入栏可见性（★ 2026-10-07 取消自动弹出）', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia());
+  });
+
+  it('★ 无按钮的 WaitInput（旧逻辑会自动弹的场景）→ 输入栏不出现', () => {
+    const game = useGameStore();
+    game.applyTurn(frame('StrValue'));
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(false);
+  });
+
+  it('★ 有本回合按钮的 WaitInput → 输入栏不出现', () => {
+    const game = useGameStore();
+    game.applyTurn(frameWithActiveButton('IntButton'));
+    expect(game.hasActiveButtons).toBe(true);
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(false);
+  });
+
+  it('★ 有本回合按钮 + 协议说在等打字 → 输入栏同样不出现（按钮就是输入手段）', () => {
+    const game = useGameStore();
+    game.applyTurn(frameWithActiveButton('StrValue', 'WaitInput', true));
+    expect(game.hasActiveButtons).toBe(true);
+    // ★ 有本回合按钮可点 ⇒ needsTextInput 为 false（键盘灯不亮），但输入栏也**不该**出现。
+    expect(game.needsTextInput).toBe(false);
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(false);
+  });
+
+  it('★ eraTW 标题画面形态（IntValue + needValue + 有按钮）→ 输入栏不出现', () => {
+    const game = useGameStore();
+    game.applyTurn(frameWithActiveButton('IntValue', 'WaitInput', true));
+    expect(game.hasActiveButtons).toBe(true);
+    expect(game.needsTextInput).toBe(false);
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(false);
+  });
+
+  it('用户手动唤出（⌨）→ 输入栏出现', () => {
+    const game = useGameStore();
+    const ui = useUiStore();
+    game.applyTurn(frame('StrValue'));
+    ui.toggleManualInput();
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(true);
+  });
+
+  it('手动唤出后再点一次（⌨ 是 toggle）→ 输入栏消失', () => {
+    const game = useGameStore();
+    const ui = useUiStore();
+    game.applyTurn(frame('StrValue'));
+    ui.toggleManualInput();
+    ui.toggleManualInput();
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(false);
+  });
+
+  it('Quit 状态 → 输入栏出现（承载底部「游戏结束」状态行，spec §6.4）', () => {
+    const game = useGameStore();
+    game.applyTurn(frame(null, 'Quit'));
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(true);
+  });
+
+  it('Error 状态 → 输入栏出现（承载底部错误状态行，spec §6.4）', () => {
+    const game = useGameStore();
+    game.applyTurn(frame(null, 'Error'));
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(true);
+  });
+
+  it('Running 状态 → 输入栏不出现', () => {
+    const game = useGameStore();
+    game.applyTurn(frame(null, 'Running'));
+
+    expect(mountView().find('.stub-input-bar').exists()).toBe(false);
+  });
+});
+
+// ---------- AnyKey / EnterKey 推进提示 ----------
+
+describe('TerminalView - 推进提示 .overlay-hint（AnyKey / EnterKey）', () => {
+  beforeEach(() => {
+    setActivePinia(createPinia());
+  });
+
+  it('AnyKey → 推进提示出现，文案为「点任意处继续」', () => {
+    const game = useGameStore();
+    game.applyTurn(frame('AnyKey'));
+
+    const hint = mountView().find('.overlay-hint');
+    expect(hint.exists()).toBe(true);
+    expect(hint.text()).toBe('点任意处继续');
+  });
+
+  it('EnterKey → 推进提示出现，文案含「按回车」', () => {
+    const game = useGameStore();
+    game.applyTurn(frame('EnterKey'));
+
+    const hint = mountView().find('.overlay-hint');
+    expect(hint.exists()).toBe(true);
+    expect(hint.text()).toContain('按回车');
+  });
+
+  it('StrValue / IntValue / AnyValue（需要打字）→ 不出推进提示', () => {
+    for (const t of ['StrValue', 'IntValue', 'AnyValue']) {
+      setActivePinia(createPinia());
+      const game = useGameStore();
+      game.applyTurn(frame(t));
+      expect(mountView().find('.overlay-hint').exists()).toBe(false);
+    }
+  });
+
+  it('Void / IntButton / StrButton / PrimitiveMouseKey → 不出推进提示', () => {
+    for (const t of ['Void', 'IntButton', 'StrButton', 'PrimitiveMouseKey']) {
+      setActivePinia(createPinia());
+      const game = useGameStore();
+      game.applyTurn(frame(t));
+      expect(mountView().find('.overlay-hint').exists()).toBe(false);
+    }
+  });
+
+  it('AnyKey + 已手动唤出输入栏 → 不出推进提示（那时由 InputBar 自己提示）', () => {
+    const game = useGameStore();
+    const ui = useUiStore();
+    game.applyTurn(frame('AnyKey'));
+    ui.toggleManualInput();
+
+    expect(mountView().find('.overlay-hint').exists()).toBe(false);
+  });
+
+  it('非 WaitInput 状态（Quit）→ 不出推进提示', () => {
+    const game = useGameStore();
+    game.applyTurn(frame('AnyKey', 'Quit'));
+
+    expect(mountView().find('.overlay-hint').exists()).toBe(false);
+  });
+});
