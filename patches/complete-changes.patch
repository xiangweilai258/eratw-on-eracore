+    expect(wrapper.text()).toContain('主目录不存在');
+    expect(wrapper.text()).toContain('请将游戏文件夹放在主目录下');
+    expect(wrapper.text()).toContain('每个游戏文件夹中需包含 CSV 和 ERB 子目录');
