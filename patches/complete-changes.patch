+            if (_current == null || _consumed || _current.CancellationToken.IsCancellationRequested ||
+                _current.RequestId != requestId || _current.Path != path)
+                return false;
+            _consumed = true;
+            ticket = _current;
+            return true;
+        }
+    }
+
+    public bool IsCurrent(MauiLoadTicket ticket)
+    {
+        lock (_gate)
+            return ReferenceEquals(_current, ticket) && !ticket.CancellationToken.IsCancellationRequested;
+    }
+
+    /// <summary>与新请求受理共用锁，防止旧 UI 提交在最后一次代际核验后被新请求超越。</summary>
+    public bool TryCommit(MauiLoadTicket ticket, Action commit)
+    {
+        lock (_gate)
+        {
+            if (!ReferenceEquals(_current, ticket) || ticket.CancellationToken.IsCancellationRequested || _committed)
+                return false;
+            commit();
+            _committed = true;
+            return true;
+        }
+    }
