+	/// </summary>
+	private static string PadForPrintC(string html)
+	{
+		if (string.IsNullOrEmpty(html))
+			return html;
+		int target = Config.PrintCLength;
+		if (target <= 0)
+			return html;
+		int width;
+		try
+		{
+			width = TerminalDisplayWidth.GetDisplayWidth(HtmlManager.Html2PlainText(html));
+		}
+		catch (Exception)
+		{
+			return html;
+		}
+		return width >= target ? html : new string(' ', target - width) + html;
