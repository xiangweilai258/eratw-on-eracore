+});
+
+describe('GameLibraryView · 主目录空态文案与扫描规则对齐', () => {
+  const source: GameLibrarySource = {
+    kind: 'http',
+    supportsNativePicker: false,
+    scan: vi.fn(async () => true),
+    listDirs: vi.fn(async () => null),
+    pickMainDir: vi.fn(async () => null),
+    pickGame: vi.fn(async () => {}),
