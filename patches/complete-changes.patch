diff --git a/EraCore.Tests/HtmlPrintLineBreakTests.cs b/EraCore.Tests/HtmlPrintLineBreakTests.cs
new file mode 100644
index 00000000..0c21d863
--- /dev/null
+++ b/EraCore.Tests/HtmlPrintLineBreakTests.cs
@@ -0,0 +1,149 @@
+using System;
+using System.Linq;
+using MinorShift.Emuera;
+using MinorShift.Emuera.GameView;
+using MinorShift.Emuera.Runtime.Config;
+using MinorShift.Emuera.Terminal.Platform;
+using MinorShift.Emuera.UI.Game;
+using Xunit;
+
+namespace Emuera.Headless.Tests;
+
+/// <summary>
+/// HTML_PRINT 第二参数（抑制强制换行）的落地行为。
+///
+/// 为什么需要这组测试：eraTW 画蛇添足版的 @HTML_PRINTBUTTONC 靠 HTML_PRINTLC 把多个按钮
+/// 接续在同一行（SHOP.ERB 连写三次 …, "LC" 而中间无换行指令）。若「抑制换行」这条路失效
+/// ——无论是参数没传到还是被下游忽略——按钮就退化成一行一个（竖排）。
+/// 这类退化不报错、不影响存档，只能靠断言行边界数量抓出来。
+///
+/// ★ 按钮文本刻意用最短形式：本组测的是「换行开关」，不是「超宽折行」。
+///   用长文本会让断言退化为测量 emuera.config 的窗口宽度默认值（踩过一次）。
+///
+/// 断言口径：PrintOp 逐内容块产出，行边界只由 NewLineOp 标记。
+/// 并且优先用「两组相对比较」，不把绝对行数写死。
+/// </summary>
+public class HtmlPrintLineBreakTests : IDisposable
+{
+    private readonly IDisposable _scope;
+    private readonly EmueraConsole _console;
+
+    public HtmlPrintLineBreakTests()
+    {
+        _scope = GlobalStatic.OpenScope(new ConfigData());
+        _console = new EmueraConsole(new HeadlessConsole(), new NullTerminalSetup());
+    }
+
+    public void Dispose()
+    {
+        _scope.Dispose();
+        _console.Dispose();
+    }
+
+    private const string Btn1 = "<button value='1'>[1]</button>";
+    private const string Btn2 = "<button value='2'>[2]</button>";
+    private const string Btn3 = "<button value='3'>[3]</button>";
+
+    private static TurnOp[] Drain(EmueraConsole console) => console.DrainPendingOps().ToArray();
+
+    private static int NewLineCount(TurnOp[] ops) => ops.OfType<NewLineOp>().Count();
+
+    private static int PrintCount(TurnOp[] ops) => ops.OfType<PrintOp>().Count();
+
+    /// <summary>
+    /// 第一个行边界之前的内容块数 —— 即"第一条显示行里装了东西几块"。
+    /// 这是本组测试的核心判据：抑制换行时应 ≥3（并排），不抑制时应 ≤1（各占一行）。
+    /// 不用「总换行数」是因为收尾的普通打印本身必然独占一行，会把计数抬高。
+    /// </summary>
+    private static int BlocksOnFirstLine(TurnOp[] ops)
+    {
+        int n = 0;
+        foreach (var op in ops)
+        {
+            if (op is NewLineOp) break;
+            if (op is PrintOp) n++;
+        }
+        return n;
+    }
+
+    /// <summary>失败诊断——把 ops 全貌带进断言消息，避免"只看到一个数字"。</summary>
+    private static string Describe(TurnOp[] ops)
+        => $"ops={ops.Length} print={PrintCount(ops)} newline={NewLineCount(ops)} "
+         + $"firstLine={BlocksOnFirstLine(ops)} "
+         + $"buttons={ops.OfType<PrintOp>().Count(op => op.button != null)} "
+         + $"types=[{string.Join("|", ops.Select(o => o.GetType().Name))}]";
+
+    /// <summary>
+    /// 三次「抑制换行」的打印 —— 三个内容块应落在同一条显示行里。
+    /// </summary>
+    [Fact]
+    public void Suppressed_prints_keep_content_on_the_same_display_line()
+    {
+        _console.PrintHtml(Btn1, toPrintBuffer: true);
+        _console.PrintHtml(Btn2, toPrintBuffer: true);
+        _console.PrintHtml(Btn3, toPrintBuffer: true);
+        // 收尾：一次普通打印触发 Flush，把攒下的内容排成行
+        _console.PrintHtml("<p align='left'>end</p>", toPrintBuffer: false);
+
+        var ops = Drain(_console);
+
+        Assert.True(
+            BlocksOnFirstLine(ops) >= 3,
+            $"抑制换行时三个内容块应在同一显示行，实际首行只有 {BlocksOnFirstLine(ops)} 块。诊断：{Describe(ops)}");
+    }
+
+    /// <summary>
+    /// 对照组：三次「不抑制换行」的打印 —— 每次各自成行，首行只应有一块。
+    /// </summary>
+    [Fact]
+    public void Unsuppressed_prints_start_a_new_line_each_time()
+    {
+        _console.PrintHtml(Btn1, toPrintBuffer: false);
+        _console.PrintHtml(Btn2, toPrintBuffer: false);
+        _console.PrintHtml(Btn3, toPrintBuffer: false);
+
+        var ops = Drain(_console);
+
+        Assert.True(
+            BlocksOnFirstLine(ops) <= 1,
+            $"不抑制换行时首行只应有一块，实际 {BlocksOnFirstLine(ops)} 块。诊断：{Describe(ops)}");
+    }
+
+    /// <summary>
+    /// ★ 关键对照：同一批内容，「抑制换行」首行装下的块数严格多于「不抑制换行」。
+    /// 这正是本次修复的行为差异本身 —— 两条路必须不同，否则 eraTW 的并排按钮无从实现。
+    /// 用相对比较而非绝对值，使其不受窗口宽度与配置默认值影响。
+    /// </summary>
+    [Fact]
+    public void Suppressed_and_unsuppressed_differ_in_first_line_blocks()
+    {
+        _console.PrintHtml(Btn1, toPrintBuffer: true);
+        _console.PrintHtml(Btn2, toPrintBuffer: true);
+        _console.PrintHtml(Btn3, toPrintBuffer: true);
+        _console.PrintHtml("<p align='left'>end</p>", toPrintBuffer: false);
+        var suppressedOps = Drain(_console);
+        var suppressed = BlocksOnFirstLine(suppressedOps);
+
+        using var fresh = new EmueraConsole(new HeadlessConsole(), new NullTerminalSetup());
+        fresh.PrintHtml(Btn1, toPrintBuffer: false);
+        fresh.PrintHtml(Btn2, toPrintBuffer: false);
+        fresh.PrintHtml(Btn3, toPrintBuffer: false);
+        var unsuppressedOps = Drain(fresh);
+        var unsuppressed = BlocksOnFirstLine(unsuppressedOps);
+
+        Assert.True(
+            suppressed > unsuppressed,
+            $"抑制换行应让首行装下更多内容块。抑制={suppressed}（{Describe(suppressedOps)}）"
+            + $" 不抑制={unsuppressed}（{Describe(unsuppressedOps)}）");
+    }
+
+    /// <summary>无终端环境的最小 ITerminalSetup —— 与同工程其他测试类各自持有的副本一致。</summary>
+    private sealed class NullTerminalSetup : ITerminalSetup
+    {
+        public bool IsAnsiEnabled => false;
+        public bool TryEnableAnsi() => false;
+        public bool TrySetConsoleSize(int cols, int rows) => false;
+        public string? DetectFont() => null;
+        public bool TryPrepareVtInput() => false;
+    }
+}
