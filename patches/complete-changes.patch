+<script setup lang="ts">
+import { useUiStore } from '../stores/ui';
+
+/**
+ * ★ 疑难解答（2026-10-08）。
+ *
+ * <para>
+ * <b>为什么要有这一页</b>：项目头号问题是「**别人用不了**」—— 玩家卡住时没有任何解释，
+ * 而我们的答案散在开发者文档里（研究笔记 / 代码注释）。这一页把它们翻译成**人话**，
+ * 按"实际最常撞到的顺序"排。
+ * </para>
+ *
+ * <para>
+ * <b>写作规矩</b>（★ 后续增删请遵守）：
+ * ① 面向**完全不懂技术**的用户，不出现 WebView / emulator / config 这类词，必须出现时就地解释；
+ * ② 每条**先给动作**（点哪里、怎么点），再解释为什么；
+ * ③ 不写"这说明你的设备有 XX 缺陷"这类让用户无措的话，只写"怎么办"。
+ * </para>
+ *
+ * <para>
+ * ★ 条目来源：都是我们**真的踩过**的坑，不是凭空拟的。
+ * 当前 10 条；后续随着开发增删。★ 2026-10-08 定：控制在十条上下。
+ * </para>
+ */
+const ui = useUiStore();
+
+/** 返回——从哪来回哪去（游戏内打开的回到游戏，主菜单打开的回到列表）。 */
+function goBack(): void {
+  ui.switchView('terminal');
+}
+
+/**
+ * ★ 把文案里的 `**xx**` 渲染成加粗。
+ *
+ * <para>
+ * <b>为什么需要它</b>：Vue 模板不解析 Markdown —— 直接写 `**xx**` 会把星号原样显示出来
+ * （2026-10-08 第一版就是这么翻的，截图才发现）。
+ * </para>
+ *
+ * <para>
+ * <b>为何这里用 v-html 是安全的</b>：本页全部文案都是**本文件里硬编码**的常量，
+ * 没有任何用户输入、游戏内容或外部数据流进来 ⇒ 不存在注入面。
+ * ★ 但如果将来这些文案改成从外部加载，必须换成结构化渲染（拆 span），不能再走 v-html。
+ * </para>
+ */
+function md(s: string): string {
+  return s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+}
+
+interface QA {
+  /** 问题（用户视角的说法）。 */
+  q: string;
+  /** 回答的普通段落。 */
+  lines: string[];
+  /** 可选的"照着看"代码块（如文件结构图）。 */
+  code?: string;
+  /** 可选的补充小字（灰字提示）。 */
+  note?: string;
+}
+
+/**
+ * ★ 十条 QA。★ 顺序 = 实际撞到的概率从高到低。
+ * ★ 修改时请注意上面"写作规矩"。
+ */
+const items: QA[] = [
+  {
+    q: '打开是一片白（或全黑），什么都没有',
+    lines: ['这**不是本应用坏了**，而是设备自带的「网页组件」出了问题 —— 这类设备上，别的用网页做界面的应用也可能打不开。'],
+    note: '★ 这种情况下应用会自己弹出一个说明页，照着上面的步骤做即可。最简单的一步是：把本应用从后台**彻底关掉**（最近任务里划走），再重新打开。',
+  },
+  {
+    q: '游戏应该放在哪儿？',
+    lines: ['放在设备的 **emuera** 文件夹里。应用默认就是从这个文件夹找游戏。', '如果你用数据线连电脑，它通常在这里：'],
+    code: '/storage/emulated/0/emuera/你的游戏/',
+  },
+  {
+    q: '放好了，但扫不到游戏',
+    lines: ['游戏文件夹的**里面**应该有 `.erb` 文件。结构要长这样：'],
+    code: 'emuera/                  ← 应用默认从这里找\n└── 你的游戏/             ← ★ 选目录时选到【这一层】\n    ├── 一堆 .erb 文件     ← ★ 有它们才是游戏本体\n    ├── csv/\n    └── sav/',
+    note: '★ 如果解压时**多套了一层**（变成 `emuera/游戏/游戏/`），就会扫不到 —— 把里面那层挪出来即可。',
