+import { describe, it, expect, beforeEach } from 'vitest';
+import { createPinia, setActivePinia } from 'pinia';
+import { useGameStore } from '../game';
+
+/**
+ * ★★ R4 · 顶层状态**独立**排序（第二批复审）。
+ *
+ * 独立审阅 R4 第 4 问：两个序号分别新旧时，显示与顶层**分别接纳**——
+ *   · 新显示 + 旧顶层 ⇒ 显示推进，但 generation / 输入锁 / 顶层状态**不倒退**；
+ *   · 旧显示 + 新顶层 ⇒ 显示不应用（防重复），但**有效的输入状态仍须到达**。
+ *
+ * ★ 第 4 点特别强调：「不参与状态变化指纹」**不等于**「旧帧可以覆盖 generation」——
+ *   故 generation 与输入锁的副作用必须**经顶层有效性判定**后才执行。
+ *
+ * ★ 全部走真实 game store，不复制逻辑自测。
+ */
+
+const lines = (text: string) => [{ entries: [{ segments: [{ text }] }], isLineEnd: true }];
+
+/** 带 identity / 显示区间 / 顶层序号的快照。 */
+const snap = (
+  dSeq: number, sSeq: number, session = 'S1', text = 'X', generation = 20,
+) => ({
+  lines: lines(text), state: 'WaitInput', inputType: 'IntValue', needValue: true,
+  protocolVersion: 14, generation,
+  displaySeq: dSeq, stateSeq: sSeq, sessionId: session,
+});
+
+/** 带显示区间与顶层序号的帧。 */
+const turn = (
+  dBase: number | null, dEnd: number | null, sSeq: number | null, session = 'S1',
+  text = 'Y', state = 'WaitInput', generation = 21,
+) => JSON.stringify({
+  state, inputType: 'IntValue', needValue: true, generation, sessionId: session,
+  baseDisplaySeq: dBase, displaySeq: dEnd, stateSeq: sSeq,
+  diff: {
+    lineOps: [{ type: 'append', newLines: lines(text) }],
+    baseDisplaySeq: dBase, displaySeq: dEnd,
+  },
+});
+
+const texts = (g: ReturnType<typeof useGameStore>) =>
+  g.displayState.lines.flatMap((l) => l.entries).flatMap((e) => e.segments ?? []).map((s) => s.text ?? '').join('');
+
+describe('R4 · 顶层状态独立排序', () => {
+  beforeEach(() => setActivePinia(createPinia()));
+
+  // ① 顶层序号推进：顶层变化才推进，无变化不动
+  it('顶层变化 ⇒ stateSeq 被采纳；顶层未变 ⇒ 不推进', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 1) as never);
+    expect(g.appliedStateSeq).toBe(1);
+
+    g.applyTurn(turn(1, 2, 2));       // 顶层新（stateSeq 2）
+    expect(g.appliedStateSeq).toBe(2);
+
+    g.applyTurn(turn(2, 3, 2));       // 顶层旧（仍是 2）
+    expect(g.appliedStateSeq).toBe(2);
+  });
+
+  // ② ★ 独立审阅 第 4 点之一：新显示 + 旧顶层 ⇒ 显示推进，generation 与输入锁不倒退
+  it('★ 新显示 + 旧顶层 ⇒ 显示推进，但 generation / 输入锁 / 顶层状态不倒退', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 10) as never);          // 顶层序号 10
+    // ★ 基线：显式设定顶层状态与输入锁（setSnapshot 只写 displayState.state，不改 serverState）
+    g.serverState = 'WaitInput';
+    g.setInputInFlight();
+
+    // 显示是新的（2 > 1 相接），但顶层序号是旧的（5 ≤ 10）
+    g.applyTurn(turn(1, 2, 5, 'S1', 'NEW', 'Quit', 1));
+
+    expect(g.lastTopLevelVerdict).toBe('ignored-stale');
+    // ★ 显示**照样推进**（两套排序独立）
+    expect(texts(g)).toContain('NEW');
+    // ★ 但 generation 不得倒退、输入锁不得被清
+    expect(g.currentTurnGeneration).toBe(20);
+    expect(g.inputInFlight).toBe(true);
+    // ★ 顶层状态也不得被旧顶层覆盖
+    expect(g.serverState).toBe('WaitInput');
+    expect(g.displayState.state).toBe('WaitInput');
+  });
+
+  // ③ ★ 独立审阅 第 4 点之二：旧显示 + 新顶层 ⇒ 显示不应用，但有效输入状态仍到达
+  it('★ 旧显示 + 新顶层 ⇒ 显示不重复，但顶层状态与输入解锁正常到达', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(5, 10) as never);
+    g.setInputInFlight();
+
+    // 显示区间 [3,4] 已被快照包含（stale），但顶层序号是新的（11）
+    g.applyTurn(turn(3, 4, 11, 'S1', 'OLD', 'WaitInput', 30));
+
+    expect(g.lastWatermarkVerdict).toBe('ignored-stale');
+    // ★ 显示不重复
+    expect(texts(g)).not.toContain('OLD');
+    // ★ 但顶层**必须更新**——否则输入会卡死
+    expect(g.lastTopLevelVerdict).toBe('applied');
+    expect(g.appliedStateSeq).toBe(11);
+    expect(g.currentTurnGeneration).toBe(30);
+    expect(g.inputInFlight).toBe(false);   // 新回合解锁
+  });
+
+  // ④ 顶层序号倒退一律不采纳
+  it('顶层序号倒退 ⇒ 顶层状态与副作用一概不改', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 20) as never);
+    g.serverState = 'WaitInput';               // 基线（setSnapshot 不改 serverState）
+    g.applyTurn(turn(1, 2, 19, 'S1', 'X', 'Quit', 1));
+
+    expect(g.lastTopLevelVerdict).toBe('ignored-stale');
+    expect(g.serverState).toBe('WaitInput');
+    expect(g.currentTurnGeneration).toBe(20);
+  });
+
+  // ⑤ 旧后端无 stateSeq ⇒ 不做顶层判定（退化为现状行为）
+  it('★ 旧后端（无 stateSeq）⇒ 不做顶层排序，行为不变', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 1) as never);
+    g.applyTurn(turn(1, 2, null, 'S1', 'Z', 'WaitInput', 40));
+
+    expect(g.lastTopLevelVerdict).toBe('no-seq');
+    expect(texts(g)).toContain('Z');
+    expect(g.currentTurnGeneration).toBe(40);
+  });
+
+  // ⑥ 换局重置顶层序号
+  it('★ reset 后顶层序号作废，新局重新建立', () => {
+    const g = useGameStore();
+    g.applyTurn(turn(0, 1, 9, 'S1', 'A'));
+    expect(g.appliedStateSeq).toBe(9);
+    g.reset();
+    expect(g.appliedStateSeq).toBeNull();
+
+    g.applyTurn(turn(0, 1, 1, 'S2', 'B'));
+    expect(g.appliedStateSeq).toBe(1);
+  });
+
+  // ⑦ 快照携带 stateSeq ⇒ 快照是顶层基线
+  it('★ 快照携带的顶层序号被采纳为当前基线', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 42) as never);
+    g.serverState = 'WaitInput';               // 基线（setSnapshot 不改 serverState）
+    expect(g.appliedStateSeq).toBe(42);
+    // 此后更旧的顶层帧不得覆盖它
+    g.applyTurn(turn(1, 2, 41, 'S1', 'OLD', 'Quit', 1));
+    expect(g.appliedStateSeq).toBe(42);
+    expect(g.serverState).toBe('WaitInput');
+  });
+
+  // ⑧ ★★ 独立审阅 R4 第 2 点（补正）：连续两回合 **state/inputType/needValue 完全相同**，
+  //    只有 generation 前进 ⇒ 新按钮代次必须正常更新、输入锁必须正常释放。
+  //    （此前"generation 不参与指纹"会让这类回合不推 stateSeq ⇒ 代次被误判为旧帧）
+  it('★★ 顶层字段全同、仅 generation 前进 ⇒ 代次更新且输入锁释放', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 1, 'S1', 'X', 5) as never);
+    g.serverState = 'WaitInput';
+
+    // 第 1 回合：generation 5 → 6，state/inputType/needValue 不变
+    g.setInputInFlight();
+    g.applyTurn(turn(1, 2, 2, 'S1', 'Y', 'WaitInput', 6));
+    expect(g.currentTurnGeneration).toBe(6);
+    expect(g.inputInFlight).toBe(false);     // ★ 输入锁正常释放
+
+    // 第 2 回合：顶层仍完全相同，generation 6 → 7
+    g.setInputInFlight();
+    g.applyTurn(turn(2, 3, 3, 'S1', 'Z', 'WaitInput', 7));
+    expect(g.currentTurnGeneration).toBe(7);
+    expect(g.inputInFlight).toBe(false);     // ★ 仍正常释放
+    expect(texts(g)).toContain('Z');         // 显示也推进
+  });
+
+  // ⑨ ★ 反向保护：generation **倒退**的旧帧不得解锁输入锁、不得倒退代次
+  it('★ generation 倒退的旧帧不得解锁输入锁、不得倒退代次', () => {
+    const g = useGameStore();
+    g.setSnapshot(snap(1, 10, 'S1', 'X', 20) as never);
+    g.serverState = 'WaitInput';
+    g.setInputInFlight();
+
+    // 顶层序号旧 + generation 旧 ⇒ 整帧无效
+    g.applyTurn(turn(1, 2, 5, 'S1', 'OLD', 'Quit', 1));
+
+    expect(g.lastTopLevelVerdict).toBe('ignored-stale');
+    expect(g.currentTurnGeneration).toBe(20);   // 不倒退
+    expect(g.inputInFlight).toBe(true);          // 不解锁
+    expect(g.serverState).toBe('WaitInput');
+  });
+});
