@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vitest';
+import {
+  DARK_LUMINANCE_THRESHOLD,
+  hasInvisibleButtonText,
+  isDarkColor,
+  parseHexColor,
+  perceivedLuminance,
+} from '../colorContrast';
+
+/**
+ * 判据测试 —— 重点是「**不能误伤**」：浅色背景上的深色文字是最清楚的，
+ * 绝不能被标记。这条是整套逻辑的安全底线。
+ */
+
+describe('parseHexColor', () => {
+  it('解析 6 位十六进制', () => {
+    expect(parseHexColor('#1A2B3C')).toEqual([0x1a, 0x2b, 0x3c]);
+  });
+
+  it('解析 3 位简写', () => {
+    expect(parseHexColor('#f00')).toEqual([255, 0, 0]);
+  });
+
+  it('允许省略 #', () => {
+    expect(parseHexColor('000000')).toEqual([0, 0, 0]);
+  });
+
+  it('非法输入返回 null', () => {
+    expect(parseHexColor('#12345')).toBeNull();
+    expect(parseHexColor('rgb(0,0,0)')).toBeNull();
+    expect(parseHexColor('')).toBeNull();
+    expect(parseHexColor(null)).toBeNull();
+    expect(parseHexColor(undefined)).toBeNull();
+  });
+});
+
+describe('perceivedLuminance', () => {
+  it('纯黑 0、纯白 255', () => {
+    expect(perceivedLuminance('#000000')).toBe(0);
+    expect(perceivedLuminance('#ffffff')).toBeCloseTo(255, 5);
+  });
+
+  it('绿色权重最高（BT.601）', () => {
+    expect(perceivedLuminance('#00ff00')!).toBeGreaterThan(perceivedLuminance('#0000ff')!);
+  });
+});
+
+describe('isDarkColor', () => {
+  it('纯黑与深灰算暗', () => {
+    expect(isDarkColor('#000000')).toBe(true);
+    expect(isDarkColor('#303030')).toBe(true);
+  });
+
+  it('阈值边界：刚好等于阈值算暗，超过不算', () => {
+    expect(DARK_LUMINANCE_THRESHOLD).toBe(64);
+    expect(isDarkColor('#404040')).toBe(true); // 64
+    expect(isDarkColor('#414141')).toBe(false); // 65
+  });
+
+  it('中灰与浅色不算暗', () => {
+    expect(isDarkColor('#808080')).toBe(false);
+    expect(isDarkColor('#ffffff')).toBe(false);
+  });
+
+  it('无法解析 → false（宁可不标记）', () => {
+    expect(isDarkColor('')).toBe(false);
+    expect(isDarkColor(null)).toBe(false);
+  });
+});
+
+describe('hasInvisibleButtonText —— 命中场景', () => {
+  it('黑字 + 黑背景 → 看不见（eraTW 那个界面的情况）', () => {
+    expect(hasInvisibleButtonText([{ color: '#000000' }], '#000000')).toBe(true);
+  });
+
+  it('深灰字 + 黑背景 → 看不见', () => {
+    expect(hasInvisibleButtonText([{ color: '#303030' }], '#000000')).toBe(true);
+  });
+
+  it('多段里只要有一段看不见就算（整按钮加底衬）', () => {
+    const segs = [{ color: '#ffffff' }, { color: '#101010' }];
+    expect(hasInvisibleButtonText(segs, '#000000')).toBe(true);
+  });
+});
+
+describe('hasInvisibleButtonText —— ★ 不能误伤的场景', () => {
+  it('★ 黑字 + 白背景 → 不标记（这是最清楚的组合，标了就改坏）', () => {
+    expect(hasInvisibleButtonText([{ color: '#000000' }], '#ffffff')).toBe(false);
+  });
+
+  it('白字 + 黑背景 → 不标记（本来就看得见）', () => {
+    expect(hasInvisibleButtonText([{ color: '#ffffff' }], '#000000')).toBe(false);
+  });
+
+  it('没设色的 segment → 不标记（走前端默认浅色文字）', () => {
+    expect(hasInvisibleButtonText([{}, { color: null }], '#000000')).toBe(false);
+  });
+
+  it('浅灰字 + 黑背景 → 不标记（还看得清，别过度干预）', () => {
+    expect(hasInvisibleButtonText([{ color: '#c0c0c0' }], '#000000')).toBe(false);
+  });
+
+  it('背景未知 → 不标记（拿不准就不动）', () => {
+    expect(hasInvisibleButtonText([{ color: '#000000' }], null)).toBe(false);
+    expect(hasInvisibleButtonText([{ color: '#000000' }], undefined)).toBe(false);
+  });
+
+  it('空 segment 列表 → false', () => {
+    expect(hasInvisibleButtonText([], '#000000')).toBe(false);
+  });
+});
diff --git a/EraCore.Web/src/lib/__tests__/lineLayout.test.ts b/EraCore.Web/src/lib/__tests__/lineLayout.test.ts
new file mode 100644
index 00000000..56506d2b
--- /dev/null
+++ b/EraCore.Web/src/lib/__tests__/lineLayout.test.ts
@@ -0,0 +1,166 @@
+import { describe, it, expect } from 'vitest';
+import { isWideChar, displayWidth, layoutLine, lineColumns } from '../lineLayout';
+import type { DisplayEntry, DisplayLine, ButtonRef, PrintSegment } from '../../types/protocol';
+
+/**
+ * lineLayout 单测 —— 终端行的列位定位。
+ *
+ * ★ 核心诉求是「纵向对齐」：同一个逻辑列在不同行必须落到同一个列位。
+ *   回归锚点：修复前前端忽略 col/width，靠流式排列，同一列在不同行落到 28 与 57
+ *   两个位置，[ 对不齐。本文件最后两组用例专门钉这一点。
+ * ★ isWideChar 必须与 C# TerminalDisplayWidth.IsWideChar 同口径；
+ *   Block Elements 按半角是最易错的一条，单独钉住。
+ */
+
+// ---------- 夹具 ----------
+
+function seg(text: string): PrintSegment {
+  return { text };
+}
+
+function textEntry(text: string): DisplayEntry {
+  return { segments: [seg(text)] };
+}
+
+function btnEntry(text: string, col: number, width: number, value = 1): DisplayEntry {
+  const button: ButtonRef = { value, isInteger: true, generation: 1, col, width };
+  return { segments: [seg(text)], button };
+}
+
+function line(entries: DisplayEntry[]): DisplayLine {
+  return { entries, isLineEnd: true };
+}
+
+// ---------- 宽度口径 ----------
+
+describe('isWideChar —— 与引擎同口径', () => {
+  it('ASCII / 半角片假名区外字符 → 半角', () => {
+    expect(isWideChar('A'.charCodeAt(0))).toBe(false);
+    expect(isWideChar('['.charCodeAt(0))).toBe(false);
+    expect(isWideChar(' '.charCodeAt(0))).toBe(false);
+  });
+
+  it('CJK 汉字 → 全角', () => {
+    expect(isWideChar('睁'.charCodeAt(0))).toBe(true);
+    expect(isWideChar('あ'.charCodeAt(0))).toBe(true);
+  });
+
+  it('★ Block Elements（░▒▓█）→ 半角 —— 游戏按半角使用，最易搞错的一条', () => {
+    expect(isWideChar(0x2591)).toBe(false); // ░
+    expect(isWideChar(0x2592)).toBe(false); // ▒
+    expect(isWideChar(0x2593)).toBe(false); // ▓
+    expect(isWideChar(0x2588)).toBe(false); // █
+  });
+
+  it('制表符 / 几何图形 / 杂项符号 → 全角（游戏设计如此）', () => {
