--- /dev/null
+++ b/EraCore.Tests/ConfigNotWrittenOnLoadTests.cs
@@ -0,0 +1,176 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text;
+using MinorShift.Emuera.Runtime.Config;
+using MinorShift.Emuera.Runtime.Utils;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+/// <summary>
+/// ★★★ 2026-10-07「配置不被毁」回归网（对齐上游行为规范）。
+/// <para>
+/// 背景：原实现在**加载期**有两条自动 <c>SaveConfig</c> 触发——
+/// ① 文件缺失 → 新建默认 config；② <c>CheckUpdate()</c>（最終更新コード 失配）→ 整份回写。
+/// 而 <c>emuera.config</c> 位于**玩家的游戏目录**，本引擎以「日文键名」整份回写会破坏其它本地化
+/// 分支（如简体中文版）的键名与专有项。上游记录过完整事故链：
+/// 日文键名回写 → 其它分支专有键丢失 → 原版简中 Emuera 读该文件全部回落默认 → 满屏「无法解释标识符」。
+/// </para>
+/// <para>
+/// 本文件断言的行为规范（四条）：
+/// ① 加载**绝不写盘**——逐字节 + **连 mtime 都不动**；
+/// ② 文件缺失**不代玩家创建**（玩家自己的 Emuera 会创建它自己的）；
+/// ③ 未识别键**登记**进 <see cref="ConfigData.UnknownConfigKeys"/>（带来源文件 + 行号），不再静默跳过；
+/// ④ **显式** <c>SaveConfig()</c> 时，未识别的**原始行原样回写**。
+/// </para>
+/// <para>
+/// ★ 为什么必须构造触发条件：eraTW **侥幸不触发**——它同时满足「英文键名 + EnglishConfigOutput=YES +
+/// REDUCE ARGUMENT ON LOAD:YES（非 ONCE）」三条。**换一款 ONCE + 中文键名的游戏，三条里坏两条。**
+/// 所以**别拿 eraTW 通过当验证**。
+/// </para>
+/// </summary>
+[Collection("LoaderTests")]
+public sealed class ConfigNotWrittenOnLoadTests
+{
+	private const string KnownLine = "フォントサイズ:20";
+	private const string UnknownLine1 = "我的專有鍵:1";
+	private const string UnknownLine2 = "另一个分支的键:42";
+
+	private static readonly Encoding Utf8NoBom = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false);
+
+	/// <summary>
+	/// ① 加载期绝不写盘 + ③ 未识别键被登记。
+	/// mtime 显式设成 2020 年，避免依赖「写入是否落在同一个时钟刻度」——只比内容会漏掉
+	/// 「内容相同但文件被重写」的情形，而上游规范明确要求**连 mtime 都不动**。
+	/// </summary>
+	[Fact]
+	public void Loading_neither_rewrites_the_config_nor_skips_unknown_keys_silently()
+	{
+		var root = NewTempGameDir();
+		try
+		{
+			var configPath = Path.Combine(root, "emuera.config");
+			File.WriteAllText(configPath, $"{KnownLine}\n{UnknownLine1}\n{UnknownLine2}\n", Utf8NoBom);
+			var fixedTime = new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+			File.SetLastWriteTimeUtc(configPath, fixedTime);
+
+			GamePaths.Resolve(root, new FileSystemGameDirAccessor());
+			var config = new ConfigData();
+			using var globals = GlobalStatic.OpenScope(config);
+
+			var bytesBefore = File.ReadAllBytes(configPath);
+
+			Assert.True(config.LoadConfig(root));
+
+			// ① 逐字节一致 + mtime 不动
+			Assert.Equal(bytesBefore, File.ReadAllBytes(configPath));
+			Assert.Equal(fixedTime, File.GetLastWriteTimeUtc(configPath));
+
+			// ③ 两个别的分支的专有键被登记；本引擎认识的键不算未识别
+			var unknownKeys = config.UnknownConfigKeys.Select(k => k.Key).ToList();
+			Assert.Contains("我的專有鍵", unknownKeys);
+			Assert.Contains("另一个分支的键", unknownKeys);
+			Assert.DoesNotContain("フォントサイズ", unknownKeys);
+			// 登记必须带来源文件与行号（否则报障时定位不到）
+			Assert.All(config.UnknownConfigKeys, k => Assert.False(string.IsNullOrEmpty(k.File)));
+			Assert.Contains(config.UnknownConfigKeys, k => k.Line > 0);
+		}
+		finally { TryDelete(root); }
+	}
+
+	/// <summary>② 文件缺失时**不代玩家创建** config（旧行为会新建一份默认 config 覆盖玩家目录）。</summary>
+	[Fact]
+	public void Loading_a_game_without_a_config_does_not_create_one()
+	{
+		var root = NewTempGameDir();
+		try
+		{
+			var configPath = Path.Combine(root, "emuera.config");
+			Assert.False(File.Exists(configPath));
+
+			GamePaths.Resolve(root, new FileSystemGameDirAccessor());
+			var config = new ConfigData();
+			using var globals = GlobalStatic.OpenScope(config);
+
+			Assert.True(config.LoadConfig(root));
+
+			Assert.False(File.Exists(configPath));
+			// 也不该在别处冒出 config
+			Assert.Empty(Directory.GetFiles(root, "*.config"));
+		}
+		finally { TryDelete(root); }
+	}
+
+	/// <summary>
+	/// ④ 显式 <c>SaveConfig()</c>（唯一允许的写盘动作）必须把未识别的**原始行原样回写**，
+	/// 否则会把其它本地化分支的专有项抹掉——这正是上游事故链的第二环。
+	/// </summary>
+	[Fact]
+	public void Explicit_save_writes_unknown_lines_back_verbatim()
+	{
+		var root = NewTempGameDir();
+		try
+		{
+			var configPath = Path.Combine(root, "emuera.config");
+			File.WriteAllText(configPath, $"{KnownLine}\n{UnknownLine1}\n{UnknownLine2}\n", Utf8NoBom);
+
+			GamePaths.Resolve(root, new FileSystemGameDirAccessor());
+			var config = new ConfigData();
+			using var globals = GlobalStatic.OpenScope(config);
+			Assert.True(config.LoadConfig(root));
+
+			Assert.True(config.SaveConfig());
+
+			var saved = File.ReadAllLines(configPath, Encoding.UTF8);
+			Assert.Contains(UnknownLine1, saved);
+			Assert.Contains(UnknownLine2, saved);
+		}
+		finally { TryDelete(root); }
+	}
+
+	/// <summary>
+	/// 未识别键的登记是**每次加载重建**的（重载语义）——否则 /load-game 换目录后
+	/// <see cref="ConfigData.UnknownConfigKeys"/> 会混着上一个游戏的键。
+	/// </summary>
+	[Fact]
+	public void Unknown_keys_are_rebuilt_per_load()
+	{
+		var rootA = NewTempGameDir();
+		var rootB = NewTempGameDir();
+		try
+		{
+			File.WriteAllText(Path.Combine(rootA, "emuera.config"), $"{UnknownLine1}\n", Utf8NoBom);
+			File.WriteAllText(Path.Combine(rootB, "emuera.config"), $"{UnknownLine2}\n", Utf8NoBom);
+
+			GamePaths.Resolve(rootA, new FileSystemGameDirAccessor());
+			var config = new ConfigData();
+			using var globals = GlobalStatic.OpenScope(config);
+
+			Assert.True(config.LoadConfig(rootA));
+			Assert.Contains(config.UnknownConfigKeys, k => k.Key == "我的專有鍵");
+
+			Assert.True(config.LoadConfig(rootB));
+			Assert.Contains(config.UnknownConfigKeys, k => k.Key == "另一个分支的键");
+			Assert.DoesNotContain(config.UnknownConfigKeys, k => k.Key == "我的專有鍵");
+		}
+		finally { TryDelete(rootA); TryDelete(rootB); }
+	}
+
+	private static string NewTempGameDir()
+	{
+		var root = Path.Combine(Path.GetTempPath(), "emuera-cfgwrite-" + Guid.NewGuid().ToString("N"));
+		Directory.CreateDirectory(root);
+		return root;
+	}
+
+	private static void TryDelete(string root)
+	{
+		try
+		{
+			if (Directory.Exists(root))
+				Directory.Delete(root, recursive: true);
+		}
+		catch { /* best-effort */ }
+	}
+}
