+    expect(wrapper.find('.cd-dialog').exists()).toBe(true);
+    expect(wrapper.text()).toContain('更改目录');
+  });
+
+  it('扫描中与有游戏时不再显示空态（既有行为未变）', async () => {
+    const { wrapper, game } = await mountLibrary();
+
+    game.scanStatus = 'scanning';
+    await wrapper.vm.$nextTick();
+    expect(wrapper.find('.empty-state').exists()).toBe(false);
+    expect(wrapper.find('.scanning').exists()).toBe(true);
+    expect(wrapper.text()).toContain('正在扫描游戏列表…');
+
+    game.scanStatus = 'idle';
+    game.setScannedGames(
+      [{ name: 'g1', fullPath: '/x/g1', irCached: false, irCacheBytes: 0, irCacheBuiltUtc: null }],
