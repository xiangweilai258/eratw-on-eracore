index 00000000..3b35124e
--- /dev/null
+++ b/EraCore.Web/src/lib/colorContrast.ts
@@ -0,0 +1,63 @@
+/**
+ * 颜色对比判据 —— 判断「按钮文字在背景上是不是根本看不见」。
+ *
+ * ★ 背景（2026-10-08，发现的真实现象）：eraTW 部分界面（如 DLC 补丁设置里的
+ *   「启动 / 返回」）把按钮文字设成近黑色，而游戏背景也是纯黑 —— 文字和背景一个色，
+ *   玩家看不出哪里有选项。
+ * ★ 已实测确认这**也是原版行为**：原版靠「鼠标划过 → 该按钮变黄」才看得见
+ *   （`selectingButton` 完全由鼠标位置决定）。★ 但触屏没有"划过"这个动作，
+ *   ⇒ **手机用户永远看不到** —— 这才是要解决的问题，不是偏离原版。
+ *
+ * ★ 判据按用户的要求「针对黑色特化」——只处理"文字和背景都很暗"这一种情况：
+ *   - 浅色背景上的深色文字 = **最清楚**，绝不能标记（所以必须**同时**看背景）
+ *   - 没设 color 的 segment = 用前端默认浅色文字，看得见，不参与判断
+ *
+ * ★ 性能红线：**纯算术，绝不读 DOM**。读元素的实际颜色会强制浏览器重排，
+ *   一屏几十个按钮就是几十次重排 —— 那才是真会卡的做法。
+ */
+
+/** 「暗」的阈值（感知亮度 0-255）：低于它算"贴在黑底上看不见"。
+ *  ★ 只覆盖近黑与深灰（约 25% 亮度），避免误伤正常的中灰文字。 */
+export const DARK_LUMINANCE_THRESHOLD = 64;
+
+/** 解析 `#RGB` / `#RRGGBB`（可省 `#`）→ `[r, g, b]`；无法解析返回 null。 */
+export function parseHexColor(hex: string | null | undefined): [number, number, number] | null {
+  if (!hex || typeof hex !== 'string') return null;
+  const m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(hex.trim());
+  if (!m) return null;
+  let h = m[1];
+  if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
+  return [
+    parseInt(h.slice(0, 2), 16),
+    parseInt(h.slice(2, 4), 16),
+    parseInt(h.slice(4, 6), 16),
+  ];
+}
+
+/** 感知亮度（ITU-R BT.601 加权，0-255）；无法解析返回 null。 */
+export function perceivedLuminance(hex: string | null | undefined): number | null {
+  const rgb = parseHexColor(hex);
+  if (rgb === null) return null;
+  return 0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2];
+}
+
+/** 这个颜色是不是"暗到贴在暗背景上看不见"。无法解析 → false（宁可不标记）。 */
+export function isDarkColor(hex: string | null | undefined): boolean {
+  const l = perceivedLuminance(hex);
+  return l !== null && l <= DARK_LUMINANCE_THRESHOLD;
+}
+
+/**
+ * 按钮是不是「文字看不见」：**文字暗 且 背景也暗**。
+ *
+ * 任一 segment 命中即算（整个按钮会被加一层极淡底衬）。
+ * ★ 背景不暗时**直接返回 false** —— 深色文字在浅色背景上是最清楚的，
+ *   给它加标记反而会把好界面改坏（这是本判据最重要的一条守卫）。
+ */
+export function hasInvisibleButtonText(
+  segments: ReadonlyArray<{ color?: string | null }>,
+  bgColor: string | null | undefined,
+): boolean {
+  if (!isDarkColor(bgColor)) return false;
+  return segments.some((s) => isDarkColor(s.color));
+}
