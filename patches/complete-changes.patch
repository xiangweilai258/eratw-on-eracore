+/**
+ * ★★ updateAutoFit：宽高取**更紧的一边**（F-2 前端侧补测）。
+ *
+ * 背景（审查报告 F-2）：真正做设备适配的那一行 `avail / logical` 此前 0 覆盖 ——
+ * store 层的 `setAutoFitScale` 反倒有 6 组测试。**测了「存」，没测「算」。**
+ *
+ * ★ 为什么在**组件层**测而不是把算法抽成纯函数：这一行读的是 `terminalRef` 的
+ *   `clientWidth` / `clientHeight`，而本仓既有测试**从不 mock 组件内部元素尺寸**；
+ *   真正要锁住的行为是「组件读到容器尺寸后，写进 store 的 autoFitScale 是多少」——
+ *   抽函数会让测试与真实调用点脱钩（改了组件不调它，测试照样绿）。
+ *
+ * ★★ 两个环境事实（实测，不是猜的）：
+ *   ① happy-dom 不做布局 ⇒ 元素 `clientWidth` / `clientHeight` **默认都是 0**
+ *      （挂载时组件算出的系数因此不进入任何分支，store 保持 1.0）。
+ *      本仓既有的 mock 只读属性写法是
+ *      `Object.defineProperty(el, prop, { value: N, configurable: true })`
+ *      （见上面 srcm 用例 mock `naturalWidth` / `naturalHeight`）——这里对
+ *      **具体元素实例**沿用同一写法，afterEach 再删除这两个自有属性恢复原型 getter。
+ *   ② **`game.windowWidth` 默认是 `null`，组件会 fallback 到 760**
+ *      （`effectiveWindowWidth`，见组件里 "默认值来源 ConfigCode.WindowX" 那段）。
+ *      而生产环境里宿主已把它固定成设计画布宽 1152 ⇒ 本组用例必须**显式设成 1152**，
+ *      否则测的是「逻辑宽 760」这条已废弃的口径（★ 这个坑我踩过一次：
+ *      2400/760 被 store 的防爆夹取到 4.0，用例会以假值"通过"）。
+ *
+ * ★ 触发方式：挂载时元素尺寸还是 0，故先给尺寸再派发 `window.resize` ——
+ *   组件 `onMounted` 里注册的 `window.addEventListener('resize', updateAutoFit)` 兜底路径
+ *   （旋转屏幕/窗口拉伸的真实通道）会因此重算一次。这样同时验证了
+ *   「高度确实被接进了 resize 回调」。
+ */
+describe('TerminalDisplay: 自动适配缩放（updateAutoFit，宽高取更紧一边）', () => {
+  /** 逻辑画布宽——与引擎侧 `DesignCanvas.Width` 同值（生产环境宿主的写入值）。 */
+  const LOGICAL_WIDTH = 1152;
+  /** 逻辑画布高——组件侧 `LOGICAL_CANVAS_HEIGHT` 的同值副本（测试独立写死，防实现被改动后静默跟随）。 */
+  const LOGICAL_HEIGHT = 648;
+
+  /** 本组件渲染出来的终端容器（Ref 指向 `.terminal`）。 */
+  function terminalEl(wrapper: ReturnType<typeof mount>): HTMLElement {
+    return wrapper.find('.terminal').element as HTMLElement;
+  }
+
+  /**
+   * 给容器实例注入可视尺寸（覆盖原型上的只读 getter）。
+   * `height` 传 `undefined` 表示**不定义**自有属性 ⇒ 回落到环境默认值 0（模拟容器隐藏）。
+   */
+  function setContainerSize(el: HTMLElement, width: number | undefined, height: number | undefined): void {
+    if (width !== undefined) Object.defineProperty(el, 'clientWidth', { value: width, configurable: true });
+    if (height !== undefined) Object.defineProperty(el, 'clientHeight', { value: height, configurable: true });
+  }
+
+  /** 删除自有属性 → 恢复原型 getter（默认 0），避免污染后续用例。 */
+  function clearContainerSize(el: HTMLElement | null): void {
+    if (!el) return;
+    delete (el as unknown as Record<string, unknown>).clientWidth;
+    delete (el as unknown as Record<string, unknown>).clientHeight;
+  }
+
+  /** 走真实通道触发重算：组件监听的那个 window resize 回调。 */
+  async function resizeTo(el: HTMLElement, width: number | undefined, height: number | undefined): Promise<void> {
+    setContainerSize(el, width, height);
+    window.dispatchEvent(new Event('resize'));
+    await nextTick();
+  }
+
+  let wrapper: ReturnType<typeof mount> | null = null;
+
+  /** 挂载一个终端，并把逻辑宽明确钉成生产值 1152（见上 ★★ ②）。 */
+  async function mountFitted() {
+    const mounted = await mountWith([line([imgSeg()])]);
+    wrapper = mounted.wrapper;
+    mounted.game.windowWidth = LOGICAL_WIDTH;
+    await nextTick(); // 让 watch(effectiveWindowWidth) 的重算先跑完，再注入尺寸
+    return mounted;
+  }
+
+  afterEach(() => {
+    clearContainerSize(wrapper ? terminalEl(wrapper) : null);
+    wrapper?.unmount();
+    wrapper = null;
+  });
+
+  it('容器 1152×648（= 逻辑画布原尺寸）⇒ autoFitScale = 1', async () => {
+    const mounted = await mountFitted();
+    await resizeTo(terminalEl(wrapper!), LOGICAL_WIDTH, LOGICAL_HEIGHT);
+    expect(mounted.game.autoFitScale).toBe(1);
+  });
+
+  it('★ 宽度充裕但高度不足（2400×1080，21:9）⇒ 由高度决定 = 1080/648', async () => {
+    const mounted = await mountFitted();
+    await resizeTo(terminalEl(wrapper!), 2400, 1080);
+    // 纯宽度算法会给出 2400/1152 ≈ 2.083（缩放后画面高 1350 > 容器 1080，必须滚动）；
+    // 取更紧一边后由高度兜住：1080/648 ≈ 1.667 ⇒ 整幅画面完整落在容器内。
+    expect(mounted.game.autoFitScale).toBeCloseTo(1080 / LOGICAL_HEIGHT, 10);
+    // ★ 这条才是"高度真的参与"的判据：结果严格小于纯宽度会给出的值，
+    //   且不等于 store 防爆夹取的上限 4.0（否则就是把"夹取"误当"高度生效"）。
+    expect(mounted.game.autoFitScale).toBeLessThan(2400 / LOGICAL_WIDTH);
+    expect(mounted.game.autoFitScale).toBeLessThan(4.0);
+  });
+
+  it('★ 容器高为 0（隐藏 / 未布局）⇒ 退回纯宽度算法，不产生 0 / NaN', async () => {
+    const mounted = await mountFitted();
+    // 只定义宽、不定义高 ⇒ clientHeight 走原型 getter = 0
+    await resizeTo(terminalEl(wrapper!), LOGICAL_WIDTH, undefined);
+    expect(Number.isFinite(mounted.game.autoFitScale)).toBe(true);
+    expect(mounted.game.autoFitScale).toBeGreaterThan(0);
+    expect(mounted.game.autoFitScale).toBe(1); // 纯宽度 = 1152/1152
+  });
+
+  it('★ 解析出 NaN 的高度也走回退（不把 NaN 写进 store）', async () => {
+    const mounted = await mountFitted();
+    await resizeTo(terminalEl(wrapper!), LOGICAL_WIDTH, Number.NaN);
+    expect(mounted.game.autoFitScale).toBe(1);
+  });
+
+  it('★ 宽度为 0（容器不可见）⇒ 不写 store，保持 1.0（不产生 0 / NaN）', async () => {
+    const mounted = await mountFitted();
+    await resizeTo(terminalEl(wrapper!), 0, LOGICAL_HEIGHT);
+    expect(mounted.game.autoFitScale).toBe(1);
+  });
+
+  it('★ 宽高比 ≤ 16:9（16:10 / 4:3 / 手机竖屏 / 恰 16:9）⇒ 与旧的纯宽度算法逐值相同', async () => {
+    const mounted = await mountFitted();
+    const el = terminalEl(wrapper!);
+    // [容器宽, 容器高, 期望 fit = 宽/1152]——这些宽高比全部 ≤ 16:9
+    const cases: Array<[number, number, number]> = [
+      [2000, 1200, 2000 / LOGICAL_WIDTH], // 16:10 横（主力平板）
+      [1024, 768, 1024 / LOGICAL_WIDTH], // 4:3
+      [1080, 2400, 1080 / LOGICAL_WIDTH], // 手机竖屏 9:16
+      [2304, 1296, 2], // 恰 16:9 的 2 倍
+    ];
+    for (const [w, h, expected] of cases) {
+      // 先坐实用例本身站得住：这一档里"按高算"本来就不比"按宽算"更紧，
+      // 所以期望值 = 纯宽度值，且不是靠两条支路碰巧同值。
+      expect(h / LOGICAL_HEIGHT).toBeGreaterThanOrEqual(w / LOGICAL_WIDTH);
+      await resizeTo(el, w, h);
+      expect(mounted.game.autoFitScale).toBeCloseTo(expected, 10);
+    }
+  });
+
+  it('★ 逻辑宽变化后按新宽度重算（watch effectiveWindowWidth 路径）', async () => {
+    const mounted = await mountFitted();
+    await resizeTo(terminalEl(wrapper!), LOGICAL_WIDTH, LOGICAL_HEIGHT);
+    expect(mounted.game.autoFitScale).toBe(1);
+    mounted.game.windowWidth = 576;
+    // ★ 要冲刷**两次**微任务：组件的 watcher 体是 `nextTick(() => updateAutoFit())`——
+    //   第一次 nextTick 只把 watcher 跑掉、把回调排进队列，回调本身在下一轮才执行。
+    //   （这里不靠 window.resize 触发，就是为了锁住"逻辑宽变化"这条路径本身。）
+    await nextTick();
+    await nextTick();
+    // 容器 1152×648 对逻辑 576×648：宽高比 16:9 不宽于画布 ⇒ 纯宽度算法 = 1152/576 = 2
+    expect(mounted.game.autoFitScale).toBe(2);
+  });
 });
