@@ -0,0 +1,46 @@
+using System;
+using System.Threading.Tasks;
+
+namespace MinorShift.Emuera.Server;
+
+/// <summary>异步启动期间的局部所有权：交接失败或异常时只回收原资源，成功交接后由接收方负责。</summary>
+internal sealed class SessionStartupOwnership<T> : IAsyncDisposable where T : class
+{
+    private readonly object _gate = new();
+    private readonly Func<T, Task> _reclaim;
+    private T? _resource;
+    private Task? _cleanup;
+
+    public SessionStartupOwnership(T resource, Func<T, Task> reclaim)
+    {
+        _resource = resource ?? throw new ArgumentNullException(nameof(resource));
+        _reclaim = reclaim ?? throw new ArgumentNullException(nameof(reclaim));
+    }
+
+    /// <summary>接收方须在自身生命周期锁内认领；返回 false 则局部所有权仍保留。</summary>
+    public bool TryTransfer(Func<T, bool> receiver)
+    {
+        lock (_gate)
+        {
+            if (_resource == null || !receiver(_resource))
+                return false;
+            _resource = null;
+            return true;
+        }
+    }
+
+    public ValueTask DisposeAsync()
+    {
+        lock (_gate)
+        {
+            if (_cleanup != null)
+                return new ValueTask(_cleanup);
+            var resource = _resource;
+            _resource = null;
+            _cleanup = resource == null ? Task.CompletedTask : ReclaimAsync(resource);
+            return new ValueTask(_cleanup);
+        }
+    }
+
+    private async Task ReclaimAsync(T resource) => await _reclaim(resource);
+}
