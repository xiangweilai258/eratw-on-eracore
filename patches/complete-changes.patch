@@ -0,0 +1,106 @@
+using MinorShift.Emuera.UI.Game.Image;
+using Xunit;
+
+namespace MinorShift.Emuera.Tests;
+
+/// <summary>
+/// ★ CBG 二期·甲（协议 v13）：颜色矩阵 → 协议三个标量（透明度 / 亮度 / 灰度）的提取规则。
+///
+/// ★★ 这条测试为什么必须存在：
+/// eraTW 在「时间停止」时用的矩阵是**三行相同**的 `[85,85,85]` ——
+/// 按颜色矩阵语义 `out_i = Σ_j m[i][j] × in_j`，那是把 RGB 混成同一个值，
+/// 即**去色（灰度化）**，且权重和 ≈ 1 ⇒ **总亮度基本不变**。
+/// 它**不是**「把画面压暗到 1/3」（那是常见误读）。
+/// 若有人把这里改回"亮度近似"，时间停止就会从「**变灰**」错成「**变暗**」—— 这条会拦住。
+/// </summary>
+public class CbgColorMatrixTests
+{
+    /// <summary>eraTW `QOL_IMAGE.ERB:1751-1753`「平常」：单位矩阵 ⇒ 什么也不做。</summary>
+    private static float[][] Identity() =>
+    [
+        [1f, 0f, 0f, 0f, 0f],
+        [0f, 1f, 0f, 0f, 0f],
+        [0f, 0f, 1f, 0f, 0f],
+        [0f, 0f, 0f, 1f, 0f],
+        [0f, 0f, 0f, 0f, 1f],
+    ];
+
+    /// <summary>eraTW `QOL_IMAGE.ERB:1755-1757`「时间停止」：三行皆 `[85,85,85]`（除以 256）。</summary>
+    private static float[][] TimeStop()
+    {
+        float k = 85f / 256f;
+        return
+        [
+            [k, k, k, 0f, 0f],
+            [k, k, k, 0f, 0f],
+            [k, k, k, 0f, 0f],
+            [0f, 0f, 0f, 1f, 0f],
+            [0f, 0f, 0f, 0f, 1f],
+        ];
+    }
+
+    [Fact]
+    public void NoMatrix_is_identity()
+    {
+        var p = GraphicsImage.ParseColorMatrix(null);
+        Assert.Equal(1f, p.Opacity);
+        Assert.Equal(1f, p.Brightness);
+        Assert.Equal(0f, p.Grayscale);
+    }
+
+    [Fact]
+    public void IdentityMatrix_equals_no_matrix()
+    {
+        var p = GraphicsImage.ParseColorMatrix(Identity());
+        Assert.Equal(1f, p.Opacity);
+        Assert.Equal(1f, p.Brightness);
+        Assert.Equal(0f, p.Grayscale);
+    }
+
+    /// <summary>★ 核心判据：eraTW 的时间停止是**去色**，且**亮度不变**。</summary>
+    [Fact]
+    public void EraTwTimeStop_is_grayscale_not_darkening()
+    {
+        var p = GraphicsImage.ParseColorMatrix(TimeStop());
+
+        Assert.Equal(1f, p.Opacity);
+        // ★ 等权 1/3 × 3 = 1 ⇒ 判为全灰
+        Assert.True(p.Grayscale > 0.99f, $"应判为去色，实际 grayscale={p.Grayscale}");
+        // ★★ 绝不能变成"压暗到 1/3" —— 亮度必须保持 1
+        Assert.Equal(1f, p.Brightness);
+    }
+
+    [Fact]
+    public void DiagonalScale_is_brightness()
+    {
+        float[][] cm =
+        [
+            [0.5f, 0f, 0f, 0f, 0f],
+            [0f, 0.5f, 0f, 0f, 0f],
+            [0f, 0f, 0.5f, 0f, 0f],
+            [0f, 0f, 0f, 1f, 0f],
+            [0f, 0f, 0f, 0f, 1f],
+        ];
+        var p = GraphicsImage.ParseColorMatrix(cm);
+        Assert.Equal(0.5f, p.Brightness);
+        Assert.Equal(0f, p.Grayscale);
+    }
+
+    /// <summary>eraTW 的「衬底透明度」走 A 行第 4 列（`CN_CM:3:0` 的第 4 个值）。</summary>
+    [Fact]
+    public void AlphaRow_maps_to_opacity()
+    {
+        var cm = Identity();
+        cm[3][3] = 0.4f;
+        var p = GraphicsImage.ParseColorMatrix(cm);
+        Assert.Equal(0.4f, p.Opacity, 3);
+    }
+
+    /// <summary>形状不对（空 / 太短）时按"原样"兜底，不抛错。</summary>
+    [Fact]
+    public void MalformedMatrix_falls_back_without_throwing()
+    {
+        Assert.Equal(1f, GraphicsImage.ParseColorMatrix([]).Opacity);
+        Assert.Equal(1f, GraphicsImage.ParseColorMatrix([[1f, 0f, 0f]]).Opacity);
+    }
+}
