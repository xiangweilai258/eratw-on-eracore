+	/// <summary>SQL 参数求值：从 start 起的变参 → object[]（字符串/整数按操作数类型）</summary>
+	private static object[]? SqlParams(ExpressionMediator exm, List<AExpression> arguments, int start)
+	{
+		if (arguments.Count <= start)
+			return null;
+		var ps = new object[arguments.Count - start];
+		for (int i = start; i < arguments.Count; i++)
+		{
+			var a = arguments[i];
+			ps[i - start] = a.GetOperandType() == typeof(string)
+				? (object)a.GetStrValue(exm)
+				: a.GetIntValue(exm);
+		}
+		return ps;
+	}
